(module coilbugs.model)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.str" :use [starts-with])
(import "coil.serde" :use *)
(import "coil.serde.derive" :use *)
(import "coil.serde.json" :use *)
(import "coilbugs.text" :use *)

;;; Every record the coil-bugs factory keeps or exchanges, as JSON through
;;; serde. Field names are snake_case on disk and on the wire.
;;;
;;; The Gatekeeper `coil-bugs` function (gatekeeper-functions/funcs/coil-bugs)
;;; is the only meeting point of the two machines: the Mac posts snapshots of
;;; the pad there, the server leaves notes there for the Mac to write into it.

;; ---------------------------------------------------------------------------
;; The wire

;;; One live pad cell. `source` is a markdown cell's Markdown, else the
;;; cell's JSON.
(defstruct Cell
  [(id (slice u8)) (ts i64) (kind (slice u8)) (source (slice u8))])

(derive (Serialize (field kind (rename "type")))
        (Deserialize (field kind (rename "type")))
        Cell)

;;; What the Mac posts.
(defstruct SnapshotUpload
  [(notebook (slice u8)) (taken i64) (cells (ArrayList Cell))])

(derive Serialize Deserialize SnapshotUpload)

;;; A snapshot as the function stores it, and the controller reads it.
(defstruct Snapshot
  [(id (slice u8))
   (received i64)
   (principal (slice u8))
   (notebook (slice u8))
   (taken i64)
   (cells (ArrayList Cell))])

(derive Serialize Deserialize Snapshot)

(defstruct SnapshotReceipt [(id (slice u8)) (received i64) (cells i64)])

(derive Serialize Deserialize SnapshotReceipt)

;;; A note as the controller writes it. Writing it into the pad under
;;; `cell-id` replaces whatever that cell held, so a note written twice is
;;; still one cell.
(defstruct Note
  [(id (slice u8))
   (created i64)
   (notebook (slice u8))
   (cell-id (slice u8))
   (markdown (slice u8))])

(derive (Serialize (rename-all (SnakeCase)))
        (Deserialize (rename-all (SnakeCase)))
        Note)

(defstruct Delivery
  [(id (slice u8)) (cell-id (slice u8)) (delivered i64) (principal (slice u8))])

(derive (Serialize (rename-all (SnakeCase)))
        (Deserialize (rename-all (SnakeCase)))
        Delivery)

;;; A note as the function lists it: with its delivery, or none yet.
(defstruct NoteListing
  [(id (slice u8))
   (created i64)
   (notebook (slice u8))
   (cell-id (slice u8))
   (markdown (slice u8))
   (delivered (Option Delivery))])

(derive (Serialize (rename-all (SnakeCase)))
        (Deserialize (rename-all (SnakeCase)))
        NoteListing)

(defstruct DeliveryUpload [(cell-id (slice u8))])

(derive (Serialize (rename-all (SnakeCase)))
        (Deserialize (rename-all (SnakeCase)))
        DeliveryUpload)

;;; Every cell id the factory writes starts with this, so it never replaces a
;;; cell a person or another agent wrote. The function refuses any other.
(const NOTE-CELL-PREFIX "coil-bugs-factory-")

;;; Bugs an agent found while working on another, which the factory files as
;;; `coil-bugs-factory-found-<bug>`. Unlike its notes about outcomes, these are
;;; reports: triage reads them, and the factory reproduces them like any other.
(const FOUND-CELL-PREFIX "coil-bugs-factory-found-")

;;; One of the factory's notes about an outcome: triage leaves these out.
(defn outcome-note? [(id (slice u8))] (-> bool)
  (and (starts-with id NOTE-CELL-PREFIX)
       (not (starts-with id FOUND-CELL-PREFIX))))

;; ---------------------------------------------------------------------------
;; The Mac

(defstruct MacConfig
  [(gate-url (slice u8))
   (token-file (slice u8))
   (pad (slice u8))
   (notebook-dir (slice u8))
   (notebook (slice u8))
   ;;; The pads a note may go to.
   (notebooks (ArrayList (slice u8)))
   (state-dir (slice u8))])

(derive (Serialize (rename-all (SnakeCase)))
        (Deserialize (rename-all (SnakeCase)))
        MacConfig)

(defstruct SnapshotRecord [(day (slice u8)) (id (slice u8)) (cells i64)])

(derive Serialize Deserialize SnapshotRecord)

(defstruct MacState
  [(last-snapshot-day (slice u8))
   (last-heartbeat (slice u8))
   ;;; The latest thirty.
   (snapshots (ArrayList SnapshotRecord))])

(derive (Serialize (rename-all (SnakeCase)))
        (Deserialize (rename-all (SnakeCase)))
        MacState)

;; ---------------------------------------------------------------------------
;; The server

(defstruct ServerConfig
  ;;; false holds new triage and bug runs; runs already going finish.
  [(enabled bool)
   (state-dir (slice u8))
   ;;; Shared native factory site; the controller owns only its workflow state.
   (site-home (slice u8))
   (port i64)
   ;;; This program, which the station gates run as `PROGRAM gate ...`.
   (program (slice u8))
   ;;; The directory holding triage.md, fix.md and reviewers/.
   (recipes (slice u8))
   ;;; The controller's clone of the Coil repository.
   (checkout (slice u8))
   (repository (slice u8))
   (github-repo (slice u8))
   (branch (slice u8))
   (snapshot-dir (slice u8))
   (notes-dir (slice u8))
   (notebook (slice u8))
   (status-notebook (slice u8))
   ;;; Codex models, chosen at install. There is no default.
   (model (slice u8))
   (review-model (slice u8))
   (gh (slice u8))
   (llvm-bin (slice u8))
   (idle-seconds i64)
   (gate-idle-seconds i64)
   (max-seconds i64)
   (triage-idle-seconds i64)
   (triage-max-seconds i64)
   (base-build-max-seconds i64)
   (base-build-memory (slice u8))
   ;;; Jimmy's rules for what Coil will not do (factories/coil-bugs/SCOPE.md).
   (scope-file (slice u8))
   ;;; The approvals service that asks Jimmy to confirm a bug is out of scope,
   ;;; and the file holding this machine's Gatekeeper device token.
   (approvals-url (slice u8))
   (approvals-token-file (slice u8))])

(derive (Serialize (rename-all (SnakeCase)))
        (Deserialize (rename-all (SnakeCase)))
        ServerConfig)

;;; A native factory run the controller is watching.
;;; `Idle` when no run is being watched.
(defsum WatchPhase (Idle) (Submitting) (Watching) (Stopping))

(derive Serialize Deserialize WatchPhase)

(defstruct RunWatch
  [(phase WatchPhase)
   ;;; The first line of the run's brief: how a run whose creation reply was
   ;;; lost is found again.
   (tag (slice u8))
   ;;; The creation request, kept until the site answers it.
   (request (slice u8))
   (run-id (slice u8))
   (started i64)
   (last-progress i64)
   (journal-offset i64)
   (station (slice u8))
   (stop-started i64)
   ;;; Why the controller stopped it, or why it ended badly; "" while fine.
   (failure (slice u8))])

(derive (Serialize (rename-all (SnakeCase)))
        (Deserialize (rename-all (SnakeCase)))
        RunWatch)

(defn new-watch [(tag (slice u8)) (request (slice u8)) (now i64)] (-> RunWatch)
  (RunWatch
    :phase (Submitting)
    :tag tag
    :request request
    :run-id ""
    :started now
    :last-progress now
    :journal-offset 0
    :station ""
    :stop-started 0
    :failure ""))

(defn idle-watch [] (-> RunWatch)
  (RunWatch
    :phase (Idle)
    :tag ""
    :request ""
    :run-id ""
    :started 0
    :last-progress 0
    :journal-offset 0
    :station ""
    :stop-started 0
    :failure ""))

(defstruct Event [(time (slice u8)) (message (slice u8))])

(derive Serialize Deserialize Event)

(defsum TriagePhase (TriageNone) (TriageRunning) (TriageDone) (TriageFailed))

(derive Serialize Deserialize TriagePhase)

(defstruct Triage
  [(snapshot (slice u8))
   ;;; The digest of that snapshot's cells (SnapshotSeen).
   (digest (slice u8))
   (phase TriagePhase)
   (watch RunWatch)
   (failure (slice u8))
   (open i64)
   (fixed i64)
   (not-a-bug i64)
   (events (ArrayList Event))])

(derive (Serialize (rename-all (SnakeCase)))
        (Deserialize (rename-all (SnakeCase)))
        Triage)

;;; `ScopeReview`: triage judged it out of Coil's scope (SCOPE.md), and Jimmy
;;; is asked to confirm on his approvals page before anything else happens.
(defsum BugStatus
  (Queued)
  (Preparing)
  (Running)
  (Publishing)
  (Done)
  (Skipped)
  (ScopeReview))

(derive Serialize Deserialize BugStatus)

;;; How an attempt ended. `Noted` is a bug the pad already shows the factory
;;; attempted, found when this controller's own state did not know it.
(defsum Outcome
  (Pending)
  (PullRequest)
  (DoesNotReproduce)
  (CannotVerify)
  (Failed)
  (Noted)
  (OutOfScope))

(derive Serialize Deserialize Outcome)

(defstruct BaseBuild [(commit (slice u8)) (started i64)])

(derive Serialize Deserialize BaseBuild)

(defstruct Attempt [(what (slice u8)) (command (slice u8)) (result (slice u8))])

(derive Serialize Deserialize Attempt)

;;; The reproduce station's record, `.coil-bug/REPRO.json`. Agents write it,
;;; so it is read with every field checked (coilbugs.checks), not by serde.
(defstruct Repro
  [(bug (slice u8))
   (verdict (slice u8))
   (summary (slice u8))
   (check (slice u8))
   (tests (ArrayList (slice u8)))
   (attempts (ArrayList Attempt))
   (needs (slice u8))])

(derive Serialize Deserialize Repro)

(defstruct Bug
  ;;; The id of the pad cell that reports it.
  [(id (slice u8))
   (title (slice u8))
   (cells (ArrayList (slice u8)))
   (reason (slice u8))
   (snapshot (slice u8))
   (status BugStatus)
   (outcome Outcome)
   (failure (slice u8))
   ;;; Runs that broke for reasons outside the bug (a provider, the worker).
   (infrastructure-failures i64)
   (watch RunWatch)
   ;;; A base compiler being built for this bug; commit "" when none.
   (base-build BaseBuild)
   (base (slice u8))
   (compiler (slice u8))
   ;;; The reproduce station's record; verdict "" until the run succeeds.
   (repro Repro)
   (head (slice u8))
   (fix (slice u8))
   (pr-branch (slice u8))
   (pr-commit (slice u8))
   (pr-url (slice u8))
   ;;; What the agent wrote in .coil-bug/OTHER-BUGS.md: bugs it found on the way.
   (other-bugs (slice u8))
   ;;; Triage's judgement that the bug is out of scope: the SCOPE.md rule, why,
   ;;; and the report's own words.
   (scope-rule (slice u8))
   (scope-reason (slice u8))
   (scope-quote (slice u8))
   ;;; The approvals request asking Jimmy, its page, and when it was last read.
   (scope-request (slice u8))
   (scope-url (slice u8))
   (scope-polled i64)
   ;;; Jimmy's words when he ruled the bug in scope after all; the agent sees them.
   (scope-comment (slice u8))
   (events (ArrayList Event))])

(derive (Serialize (rename-all (SnakeCase)))
        (Deserialize (rename-all (SnakeCase))
                     (field other-bugs (default ""))
                     (field scope-rule (default ""))
                     (field scope-reason (default ""))
                     (field scope-quote (default ""))
                     (field scope-request (default ""))
                     (field scope-url (default ""))
                     (field scope-polled (default 0))
                     (field scope-comment (default "")))
        Bug)

;;; The newest snapshot read, and a hash of the cells triage reads from it
;;; (every cell but the factory's own notes), to tell when triage is due.
(defstruct SnapshotSeen
  [(id (slice u8))
   (received i64)
   (cells i64)
   (seen (slice u8))
   (digest (slice u8))])

(derive Serialize Deserialize SnapshotSeen)

(defstruct Base [(commit (slice u8)) (compiler (slice u8)) (built (slice u8))])

(derive Serialize Deserialize Base)

(defstruct Halt [(reason (slice u8)) (time (slice u8))])

(derive Serialize Deserialize Halt)

(defstruct ServerState
  ;;; id "" before the first snapshot.
  [(snapshot SnapshotSeen)
   (triage Triage)
   ;;; Bugs in pad order, the order they are attempted in.
   (bugs (ArrayList Bug))
   ;;; commit "" until a base compiler has built.
   (base Base)
   ;;; A main commit that did not build, so it is not built again.
   (broken-main (slice u8))
   ;;; The digest of the last snapshot triaged.
   (triaged-digest (slice u8))
   (notes i64)
   ;;; reason "" unless halted.
   (halted Halt)
   ;;; What the last status note said, so a note is written only on a change.
   (status-summary (slice u8))])

(derive (Serialize (rename-all (SnakeCase)))
        (Deserialize (rename-all (SnakeCase)))
        ServerState)

(defn empty-repro [(a (dyn Allocator))] (-> Repro)
  (Repro
    :bug ""
    :verdict ""
    :summary ""
    :check ""
    :tests (ArrayList::new [(slice u8)] a)
    :attempts (ArrayList::new [Attempt] a)
    :needs ""))

(defn empty-server-state [(a (dyn Allocator))] (-> ServerState)
  (ServerState
    :snapshot
      (SnapshotSeen
        :id ""
        :received 0
        :cells 0
        :seen ""
        :digest "")
    :triage
      (Triage
        :snapshot ""
        :digest ""
        :phase (TriageNone)
        :watch (idle-watch)
        :failure ""
        :open 0
        :fixed 0
        :not-a-bug 0
        :events (ArrayList::new [Event] a))
    :bugs (ArrayList::new [Bug] a)
    :base
      (Base
        :commit ""
        :compiler ""
        :built "")
    :broken-main ""
    :triaged-digest ""
    :notes 0
    :halted (Halt :reason "" :time "")
    :status-summary ""))

;; ---------------------------------------------------------------------------
;; Reading and writing

(defn decode-error [(a (dyn Allocator)) (what (slice u8)) (e DeError)]
  (-> (slice u8))
  (join a
        [what
         " is not in the expected format ("
         (.ctx e)
         " at byte "
         (int-text a (.offset e))
         ")"]))

;;; A JSON file decoded as `T`; a missing file is an error.
(defn read-json-file [(T Deserialize)] [(a (dyn Allocator)) (path (slice u8))]
  (-> (Result T (slice u8)))
  (match (read-required a path)
    (Err [why] (Err why))
    (Ok [text]
        (match (from-json [T] a text)
          (Ok [value] (Ok value))
          (Err [e] (Err (decode-error a path e)))))))

(defn encode [(T Serialize)] [(a (dyn Allocator)) (value T)] (-> (slice u8))
  (try (let [text
               (try-or! (to-json-str a value)
                        (do
                          (println "coil-bugs: a record could not be encoded as JSON")
                          (abort)
                          ""))]
         text)))

(defn write-json-file [(T Serialize)] [(a (dyn Allocator))
                                       (path (slice u8))
                                       (value T)
                                       (mode i64)] (-> (Result i64 (slice u8)))
  (write-text a path (join a [(encode a value) "\n"]) mode))
