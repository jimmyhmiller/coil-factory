(module coilbugs.main)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.os" :as os)
(import "factory.proc" :use [remember-argv0!])
(import "coilbugs.checks" :use *)
(import "coilbugs.services" :use *)
(import "coilbugs.server" :use [controller-main build-base-main])
(import "coilbugs.mac" :use [mac-main])
(import "coilbugs.text" :use *)
(import "coilbugs.install" :use [install-mac install-linux])

;;; coil-bugs — the coil-bugs factory. The Mac posts the coil-bugs pad to the
;;; server once a day; the server reproduces and fixes its open bugs one at a
;;; time, opens pull requests, and leaves notes the Mac writes into the pad.

(defn arg [(argv (ptr (ptr i8))) (i i64)] (-> (slice u8))
  (cstr->str (load (primitive/index argv i))))

(defn args-of [(a (dyn Allocator)) (argc i32) (argv (ptr (ptr i8)))] (-> (ArrayList (slice u8)))
  (let [(mut out) (al-new [(slice u8)] a)
        (mut i) 1]
    (loop (if (>= (load i) (cast i64 argc))
              (break)
              (do (push! (mut out) (arg argv (load i)))
                  (set! i (+ (load i) 1)))))
    (load out)))

;;; The value after `--name`, or "".
(defn flag [(args (ArrayList (slice u8))) (name (slice u8))] (-> (slice u8))
  (let [(mut found) ""
        (mut i) 0]
    (loop (cond (>= (+ (load i) 1) (len args)) (break)
                (= (get args (load i)) name) (do (set! found (get args (+ (load i) 1))) (break))
                :else (set! i (+ (load i) 1))))
    (load found)))

(defn has? [(args (ArrayList (slice u8))) (name (slice u8))] (-> bool)
  (let [(mut found) false]
    (for x (iter args) (when (= x name) (set! found true) 0))
    (load found)))

(defn word [(args (ArrayList (slice u8))) (i i64)] (-> (slice u8))
  (if (< i (len args)) (get args i) ""))

(defn cwd [(a (dyn Allocator))] (-> (slice u8))
  (match (os/current-dir a)
    (Ok [dir] (os/owned-string-slice dir))
    (Err [_] (do (println "coil-bugs: cannot read the current directory") (abort) ""))))

(const USAGE "usage:
  coil-bugs mac --config FILE                      the Mac's heartbeat
  coil-bugs controller --config FILE [--resume]    the server's heartbeat; --resume clears a halt
  coil-bugs build-base --config FILE --commit SHA  build a base compiler (run by systemd-run)
  coil-bugs install-mac [--gate-url URL] [--token-file FILE]
  coil-bugs install-linux --factory BIN --recipes DIR --model M --review-model M [--enable]
  coil-bugs gate triage --scope SCOPE.md           the triage station's gate (in its workspace)
  coil-bugs gate repro --bug ID --base SHA --base-compiler PATH
  coil-bugs gate fix --bug ID --base SHA --base-compiler PATH")

(defn needs [(args (ArrayList (slice u8))) (names (slice (slice u8)))] (-> bool)
  (let [(mut ok) true]
    (for name (iter names) (when (= (len (flag args name)) 0) (set! ok false) 0))
    (load ok)))

(defn or-default [(value (slice u8)) (fallback (slice u8))] (-> (slice u8))
  (if (> (len value) 0) value fallback))

(defn report [(result (Result (slice u8) (slice u8)))] (-> i64)
  (match result
    (Ok [message] (do (println "coil-bugs: {s}" message) 0))
    (Err [why] (do (println "coil-bugs: {s}" why) 1))))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [a (malloc-allocator)
        args (args-of a argc argv)
        command (word args 0)
        sub (word args 1)]
    (remember-argv0! (arg argv 0))
    (cond (and (= command "mac") (needs args ["--config"])) (mac-main a (flag args "--config"))
          (and (= command "controller") (needs args ["--config"])) (controller-main a (flag args "--config") (has? args "--resume"))
          (and (= command "build-base") (needs args ["--config" "--commit"])) (build-base-main a (flag args "--config") (flag args "--commit"))
          (= command "install-mac")
            (report (install-mac a (or-default (flag args "--gate-url") "https://computer.jimmyhmiller.com/coil-bugs")
                                   (or-default (flag args "--token-file") "~/.config/gatekeeper/token")))
          (and (= command "install-linux") (needs args ["--factory" "--recipes" "--model" "--review-model"]))
            (report (install-linux a (flag args "--factory") (flag args "--recipes") (flag args "--model") (flag args "--review-model")
                                   (has? args "--enable")))
          (and (= command "gate") (= sub "triage") (needs args ["--scope"])) (gate-report (gate-triage a (cwd a) (flag args "--scope")))
          (and (= command "gate") (= sub "repro") (needs args ["--bug" "--base" "--base-compiler"]))
            (gate-report (gate-repro a (cwd a) (flag args "--bug") (flag args "--base") (flag args "--base-compiler")))
          (and (= command "gate") (= sub "fix") (needs args ["--bug" "--base" "--base-compiler"]))
            (gate-report (gate-fix a (cwd a) (flag args "--bug") (flag args "--base") (flag args "--base-compiler")))
          :else (do (println "{s}" USAGE) 64))))
