(module coilbugs.mac-test)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coilbugs.gatekeeper" :use *)
(import "coilbugs.mac" :use *)
(import "coilbugs.model" :use *)
(import "coilbugs.pad" :use *)
(import "coilbugs.text" :use *)
(import "coilbugs.test-support" :use *)

(defstruct FakeGate
  [(notes (ArrayList NoteListing))
   (delivered (ArrayList (slice u8)))
   (snapshots (ArrayList SnapshotUpload))
   (fail-delivery bool)])

(impl MacGate FakeGate
  (gate-notes [(self (ptr FakeGate)) (a (dyn Allocator))] (-> (Result (ArrayList NoteListing) (slice u8)))
              (let [(mut out) (al-new [NoteListing] a)]
                (for note (iter (.notes self))
                  (let [(mut copy) note
                        (mut done) false]
                    (for id (iter (.delivered self)) (when (= id (.id note)) (set! done true) 0))
                    (when (load done)
                      (set! (.delivered copy) (Some (Delivery :id (.id note) :cell-id (.cell-id note) :delivered 1 :principal "device")))
                      0)
                    (push! (mut out) (load copy))))
                (Ok (load out))))
  (gate-deliver [(self (ptr FakeGate)) (a (dyn Allocator)) (id (slice u8)) (cell-id (slice u8))] (-> (Result i64 (slice u8)))
                (if (.fail-delivery self)
                    (Err "the Gatekeeper is down")
                    (do (push! (mut (.delivered self)) id) (Ok 0))))
  (gate-snapshot [(self (ptr FakeGate)) (a (dyn Allocator)) (upload SnapshotUpload)] (-> (Result SnapshotReceipt (slice u8)))
                 (do (push! (mut (.snapshots self)) upload)
                     (Ok (SnapshotReceipt :id (join a ["s" (int-text a (len (.snapshots self)))]) :received 1 :cells (len (.cells upload)))))))

(defstruct Written [(notebook (slice u8)) (cell-id (slice u8)) (markdown (slice u8))])
(defstruct FakePad [(written (ArrayList Written))])

(impl PadWriter FakePad
  (write-cell [(self (ptr FakePad)) (a (dyn Allocator)) (notebook (slice u8)) (cell-id (slice u8)) (markdown (slice u8))] (-> (Result i64 (slice u8)))
              (do (push! (mut (.written self)) (Written :notebook notebook :cell-id cell-id :markdown markdown))
                  (Ok 0))))

(defn note [(id (slice u8)) (notebook (slice u8)) (cell-id (slice u8))] (-> NoteListing)
  (NoteListing :id id :created 1 :notebook notebook :cell-id cell-id :markdown id :delivered (None)))

(const JOURNAL "{\"op\":\"update\",\"id\":\"a\",\"ts\":1,\"cell\":{\"type\":\"markdown\",\"source\":\"# title\"}}
{\"op\":\"update\",\"id\":\"b\",\"ts\":2,\"cell\":{\"type\":\"markdown\",\"source\":\"### bug b\"}}
{\"op\":\"update\",\"id\":\"c\",\"ts\":3,\"cell\":{\"type\":\"table\",\"title\":\"t\",\"columns\":[\"x\"],\"rows\":[[1]]}}
{\"op\":\"remove\",\"id\":\"a\"}
{\"op\":\"update\",\"id\":\"b\",\"ts\":4,\"cell\":{\"type\":\"markdown\",\"source\":\"### bug b, edited\"}}
")

(defn setup [(a (dyn Allocator)) (label (slice u8))] (-> MacConfig)
  (let [dir (temp-dir a label)
        (mut notebooks) (al-new [(slice u8)] a)]
    (write! a (path-join a dir "notebooks/coil-bugs.jsonl") JOURNAL)
    (push! (mut notebooks) "coil-bugs")
    (push! (mut notebooks) "coil-factory-coil-bugs")
    (MacConfig :gate-url "https://example" :token-file "/dev/null" :pad "pad"
               :notebook-dir (path-join a dir "notebooks") :notebook "coil-bugs"
               :notebooks (load notebooks) :state-dir (path-join a dir "state"))))

(defn fake-gate [(a (dyn Allocator))] (-> FakeGate)
  (FakeGate :notes (al-new [NoteListing] a) :delivered (al-new [(slice u8)] a)
            :snapshots (al-new [SnapshotUpload] a) :fail-delivery false))

;; Sunday 2026-10-11, 07:00 local is somewhere around here; the tests only
;; need days to differ, so they step in whole days from noon UTC.
(const NOON 1791720000000)
(const HOUR 3600000)

(defn beat [(a (dyn Allocator)) (config MacConfig) (gate (ptr FakeGate)) (pad (ptr FakePad)) (now i64)] (-> HeartbeatResult)
  (match (heartbeat a config gate pad now)
    (Ok [result] result)
    (Err [why] (do (println "{s}" why) (assert false) (HeartbeatResult :delivered (al-new [(slice u8)] a) :snapshot "")))))

(deftest live-cells-fold-the-journal-in-first-written-order
  (let [a (malloc-allocator)]
    (match (fold-cells a JOURNAL "test")
      (Ok [cells] (do (assert-eq (len cells) 2)
                      (assert (= (.id (get cells 0)) "b"))
                      (assert (= (.source (get cells 0)) "### bug b, edited"))
                      (assert-eq (.ts (get cells 0)) 4)
                      (assert (contains? (.source (get cells 1)) "\"rows\":[[1]]"))
                      0))
      (Err [why] (do (println "{s}" why) (assert false) 0)))))

(deftest an-unknown-pad-record-is-an-error
  (let [a (malloc-allocator)]
    (match (fold-cells a (join a [JOURNAL "{\"op\":\"move\",\"id\":\"b\"}\n"]) "test")
      (Ok [_] (assert false))
      (Err [why] (assert (contains? why "unknown pad record \"move\""))))))

(deftest one-snapshot-a-day-whenever-the-mac-is-awake
  (let [a (malloc-allocator)
        config (setup a "daily")
        (mut gate) (fake-gate a)
        (mut pad) (FakePad :written (al-new [Written] a))]
    (assert (= (.snapshot (beat a config (mut gate) (mut pad) NOON)) "s1"))
    (let [posted (get (.snapshots gate) 0)]
      (assert (= (.notebook posted) "coil-bugs"))
      (assert-eq (len (.cells posted)) 2)
      (assert (= (.id (get (.cells posted) 0)) "b")))
    (assert (= (.snapshot (beat a config (mut gate) (mut pad) (+ NOON HOUR))) ""))
    ;; Asleep for three days: the first heartbeat after waking posts one.
    (assert (= (.snapshot (beat a config (mut gate) (mut pad) (+ NOON (* 72 HOUR)))) "s2"))
    (assert-eq (len (.snapshots gate)) 2)))

(deftest notes-are-written-under-their-own-cell-and-then-marked-delivered
  (let [a (malloc-allocator)
        config (setup a "notes")
        (mut gate) (fake-gate a)
        (mut pad) (FakePad :written (al-new [Written] a))]
    (push! (mut (.notes gate)) (note "n1" "coil-bugs" "coil-bugs-factory-b"))
    (push! (mut (.notes gate)) (note "n2" "coil-factory-coil-bugs" "coil-bugs-factory-status"))
    (let [first (beat a config (mut gate) (mut pad) NOON)]
      (assert-eq (len (.delivered first)) 2))
    (assert-eq (len (.written pad)) 2)
    (assert (= (.cell-id (get (.written pad) 0)) "coil-bugs-factory-b"))
    (assert (= (.notebook (get (.written pad) 1)) "coil-factory-coil-bugs"))
    (assert-eq (len (.delivered (beat a config (mut gate) (mut pad) (+ NOON HOUR)))) 0)
    (assert-eq (len (.written pad)) 2)))

(deftest a-note-is-written-again-if-its-delivery-was-not-recorded
  (let [a (malloc-allocator)
        config (setup a "redeliver")
        (mut gate) (fake-gate a)
        (mut pad) (FakePad :written (al-new [Written] a))]
    (push! (mut (.notes gate)) (note "n1" "coil-bugs" "coil-bugs-factory-b"))
    (set! (.fail-delivery gate) true)
    (match (heartbeat a config (mut gate) (mut pad) NOON)
      (Ok [_] (assert false))
      (Err [why] (assert (contains? why "down"))))
    (set! (.fail-delivery gate) false)
    (beat a config (mut gate) (mut pad) (+ NOON HOUR))
    ;; The same cell twice: pad replaces it, so the pad has it once.
    (assert-eq (len (.written pad)) 2)
    (assert (= (.cell-id (get (.written pad) 1)) "coil-bugs-factory-b"))))

(deftest a-note-for-someone-elses-cell-or-pad-is-refused
  (let [a (malloc-allocator)
        config (setup a "refused")
        (mut pad) (FakePad :written (al-new [Written] a))]
    (let [(mut gate) (fake-gate a)]
      (push! (mut (.notes gate)) (note "n1" "coil-bugs" "b"))
      (match (heartbeat a config (mut gate) (mut pad) NOON)
        (Ok [_] (assert false))
        (Err [why] (assert (contains? why "not one of the factory's own")))))
    (let [(mut gate) (fake-gate a)]
      (push! (mut (.notes gate)) (note "n1" "secrets" "coil-bugs-factory-b"))
      (match (heartbeat a config (mut gate) (mut pad) NOON)
        (Ok [_] (assert false))
        (Err [why] (assert (contains? why "does not write")))))
    (assert-eq (len (.written pad)) 0)))
