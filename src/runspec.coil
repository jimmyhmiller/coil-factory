(module factory.runspec)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.primitive" :as primitive)
(import "coil.serde.value" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "durable.atomic" :as atomic)
(import "agent.json" :use *)
(import "factory.config" :use *)

;;; `run.json`: everything a run needs to start or restart, fixed when it is
;;; created. The factory's full text is copied in, so editing a factory never
;;; changes a run already made from it.

(defstruct RunSpec
  [(id (slice u8))
   (factory-name (slice u8))
   (factory-text (slice u8))
   (brief (slice u8))
   ;;; A repository path on this site, or "" for an empty workspace.
   (project (slice u8))
   ;;; The commit to start from; "" means the project's HEAD at start.
   (base (slice u8))
   (branch (slice u8))
   (model (slice u8))
   ;;; The harness every station uses; "" leaves it to the factory and site.
   (harness (slice u8))
   ;;; The reviewers chosen when the run was made, their Markdown copied in.
   (reviewers (ArrayList ReviewerCopy))
   ;;; The reviewers stations name in `review`, copied in the same way. They
   ;;; judge a station's finished work, and a station passes only with every
   ;;; one of its reviewers' approval.
   (station-reviewers (ArrayList ReviewerCopy))
   ;;; Which of `station-reviewers` each station needs, by name.
   (station-reviews (ArrayList StationReview))
   ;;; The summarizer for stations a person approves, copied in; name "" when
   ;;; no station needs approval.
   (summarizer ReviewerCopy)
   (site (slice u8))
   (created i64)])

(defstruct ReviewerCopy [(name (slice u8)) (text (slice u8))])

;;; A station and the names of the reviewers that must approve its work.
(defstruct StationReview [(station (slice u8)) (names (ArrayList (slice u8)))])

;;; The reviewers `station` needs, by name; empty when it needs none.
(defn station-review-names [(a (dyn Allocator)) (spec (ptr RunSpec)) (station (slice u8))] (-> (ArrayList (slice u8)))
  (let [(mut out) (al-new [(slice u8)] a)]
    (for entry (iter (.station-reviews spec))
      (when (= (.station entry) station)
        (for name (iter (.names entry)) (push! (mut out) name))
        0))
    (load out)))

(defsum RunSpecResult
  (RunSpecOk [(spec RunSpec)])
  (RunSpecBad [(message (slice u8))]))

(defn copies-json [(a (dyn Allocator)) (copies (ArrayList ReviewerCopy))] (-> JVal)
  (let [out (jv-array a)]
    (for copy (iter copies)
      (let [entry (jv-object a)]
        (jv-put! entry "name" (JStr (.name copy)))
        (jv-put! entry "text" (JStr (.text copy)))
        (jv-push! out entry)))
    out))

(defn copies-from [(a (dyn Allocator)) (copies JVal)] (-> (ArrayList ReviewerCopy))
  (let [(mut out) (al-new [ReviewerCopy] a)
        (mut i) 0]
    (loop (if (>= (load i) (jv-count copies))
              (break)
              (let [entry (jv-nth copies (load i))]
                (push! (mut out) (ReviewerCopy :name (jv-string-or (jv-get entry "name") "")
                                               :text (jv-string-or (jv-get entry "text") "")))
                (set! i (+ (load i) 1)))))
    (load out)))

(defn reviews-from [(a (dyn Allocator)) (reviews JVal)] (-> (ArrayList StationReview))
  (let [(mut out) (al-new [StationReview] a)
        (mut i) 0]
    (loop (if (>= (load i) (jv-count reviews))
              (break)
              (let [item (jv-nth reviews (load i))
                    list (jv-get item "names")
                    (mut names) (al-new [(slice u8)] a)
                    (mut k) 0]
                (loop (if (>= (load k) (jv-count list))
                          (break)
                          (do (push! (mut names) (jv-string-or (jv-nth list (load k)) ""))
                              (set! k (+ (load k) 1)))))
                (push! (mut out) (StationReview :station (jv-string-or (jv-get item "station") "") :names (load names)))
                (set! i (+ (load i) 1)))))
    (load out)))

(defn run-spec-json [(a (dyn Allocator)) (spec (ptr RunSpec))] (-> JVal)
  (let [out (jv-object a)]
    (jv-put! out "version" (JInt 1))
    (jv-put! out "id" (JStr (.id spec)))
    (jv-put! out "factory" (JStr (.factory-name spec)))
    (jv-put! out "factory_text" (JStr (.factory-text spec)))
    (jv-put! out "brief" (JStr (.brief spec)))
    (jv-put! out "project" (JStr (.project spec)))
    (jv-put! out "base" (JStr (.base spec)))
    (jv-put! out "branch" (JStr (.branch spec)))
    (jv-put! out "model" (JStr (.model spec)))
    (jv-put! out "harness" (JStr (.harness spec)))
    (jv-put! out "reviewers" (copies-json a (.reviewers spec)))
    (jv-put! out "station_reviewers" (copies-json a (.station-reviewers spec)))
    (let [s (jv-object a)]
      (jv-put! s "name" (JStr (.name (field spec summarizer))))
      (jv-put! s "text" (JStr (.text (field spec summarizer))))
      (jv-put! out "summarizer" s))
    (let [reviews (jv-array a)]
      (for entry (iter (.station-reviews spec))
        (let [item (jv-object a)
              names (jv-array a)]
          (for name (iter (.names entry)) (jv-push! names (JStr name)))
          (jv-put! item "station" (JStr (.station entry)))
          (jv-put! item "names" names)
          (jv-push! reviews item)))
      (jv-put! out "station_reviews" reviews))
    (jv-put! out "site" (JStr (.site spec)))
    (jv-put! out "created" (JInt (.created spec)))
    out))

(defn save-run-spec! [(a (dyn Allocator)) (home (slice u8)) (spec (ptr RunSpec))] (-> bool)
  (match (atomic/write-file-atomic! a (run-file a home (.id spec) "run.json")
                                    (jv-encode a (run-spec-json a spec)) 384)
    (Ok [written] true)
    (Err [failure] false)))

(defn load-run-spec [(a (dyn Allocator)) (home (slice u8)) (run-id (slice u8))] (-> RunSpecResult)
  (match (atomic/read-file-if-exists a (run-file a home run-id "run.json"))
    (Err [failure] (RunSpecBad "run.json could not be read"))
    (Ok [found]
        (match found
          (None [] (RunSpecBad "run.json is missing"))
          (Some [text]
                (match (jv-parse a text)
                  (None [] (RunSpecBad "run.json is not valid JSON"))
                  (Some [root]
                        (let [(mut spec) (primitive/zeroed RunSpec)]
                          (set! (.id spec) (jv-string-or (jv-get root "id") ""))
                          (set! (.factory-name spec) (jv-string-or (jv-get root "factory") ""))
                          (set! (.factory-text spec) (jv-string-or (jv-get root "factory_text") ""))
                          (set! (.brief spec) (jv-string-or (jv-get root "brief") ""))
                          (set! (.project spec) (jv-string-or (jv-get root "project") ""))
                          (set! (.base spec) (jv-string-or (jv-get root "base") ""))
                          (set! (.branch spec) (jv-string-or (jv-get root "branch") ""))
                          (set! (.model spec) (jv-string-or (jv-get root "model") ""))
                          (set! (.harness spec) (jv-string-or (jv-get root "harness") ""))
                          (set! (.reviewers spec) (copies-from a (jv-get root "reviewers")))
                          (set! (.station-reviewers spec) (copies-from a (jv-get root "station_reviewers")))
                          (set! (.station-reviews spec) (reviews-from a (jv-get root "station_reviews")))
                          (set! (.summarizer spec) (ReviewerCopy :name (jv-string-or (jv-get (jv-get root "summarizer") "name") "")
                                                                 :text (jv-string-or (jv-get (jv-get root "summarizer") "text") "")))
                          (set! (.site spec) (jv-string-or (jv-get root "site") ""))
                          (set! (.created spec) (jv-int (jv-get root "created")))
                          (if (or (not (= (.id spec) run-id)) (= (len (.factory-text spec)) 0))
                              (RunSpecBad "run.json does not describe this run")
                              (RunSpecOk (load spec)))))))))))
