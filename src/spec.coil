(module factory.spec)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "agent.json" :use *)

;;; A factory definition: Markdown with front matter, shared context, and one
;;; `## Station: name` section per station. See DESIGN.md "Factories".

(defstruct StationSpec
  [(name (slice u8))
   (instructions (slice u8))
   (gate (slice u8))
   (attempts i64)
   (model (slice u8))
   ;;; Which program runs this station's agent; "" inherits (see `station-harness`).
   (harness (slice u8))
   (tools (slice u8))
   ;;; Reviewers whose approval this station's work needs before it passes,
   ;;; comma-separated names or paths; "" inherits the factory's `review`,
   ;;; "none" turns review off for this station.
   (review (slice u8))
   ;;; "yes" when a person must approve this station's work (and answer it
   ;;; when it stops to ask) before it goes on; "no"; "" inherits the factory's.
   (approve (slice u8))
   (line i64)])

(defstruct FactorySpec
  [(name (slice u8))
   (description (slice u8))
   (input (slice u8))
   (model (slice u8))
   (harness (slice u8))
   ;;; The reviewers that watch runs of this factory, comma-separated; "" leaves
   ;;; it to the run and the site, "none" turns reviewing off.
   (reviewers (slice u8))
   ;;; The reviewers every station's work must satisfy unless the station says
   ;;; otherwise (see `station-review`); "" for none.
   (review (slice u8))
   ;;; "yes" or "no" (the default): whether stations need a person's approval.
   (approve (slice u8))
   ;;; Who summarizes a station's work into proposals for that approval: a
   ;;; summarizer name or path; "" is the bundled `summarizer`.
   (summarizer (slice u8))
   (tools (slice u8))
   (attempts i64)
   (context (slice u8))
   (stations (ArrayList StationSpec))])

(defstruct SpecProblem [(line i64) (message (slice u8))])

(defn station-count [(spec (ptr FactorySpec))] (-> i64)
  (len (.stations spec)))

(defn station-spec [(spec (ptr FactorySpec)) (index i64)] (-> (ptr StationSpec))
  (elem (field spec stations) index))

(defn find-station [(spec (ptr FactorySpec)) (name (slice u8))] (-> i64)
  (let [(mut i) 0
        n (len (.stations spec))
        (mut found) -1]
    (loop (if (>= (load i) n)
              (break)
              (if (= (.name (station-spec spec (load i))) name)
                  (do (set! found (load i)) (break))
                  (set! i (+ (load i) 1)))))
    (load found)))

;;; The station's tools, falling back to the factory's, then to both groups.
(defn station-tools [(spec (ptr FactorySpec)) (station (ptr StationSpec))]
  (-> (slice u8))
  (cond (> (len (.tools station)) 0) (.tools station)
        (> (len (.tools spec)) 0) (.tools spec)
        :else "files, shell"))

;;; The reviewers a station's finished work must satisfy, as comma-separated
;;; names or paths: the station's own `review`, else the factory's. "" (or
;;; "none") means the station passes on its gate alone.
(defn station-review [(spec (ptr FactorySpec)) (station (ptr StationSpec))]
  (-> (slice u8))
  (review-choice (.review spec) (.review station)))

;;; The station's own review choice, else the factory's; "none" is "".
(defn review-choice [(factory-review (slice u8)) (station-review (slice u8))]
  (-> (slice u8))
  (let [chosen
          (if (> (len (trim station-review)) 0) station-review factory-review)]
    (if (= (trim chosen) "none") "" chosen)))

;;; Whether a person must approve this station's work: its own `approve`, else
;;; the factory's, else no.
(defn station-approves? [(spec (ptr FactorySpec)) (station (ptr StationSpec))]
  (-> bool)
  (approve-choice (.approve spec) (.approve station)))

(defn approve-choice [(factory-approve (slice u8)) (station-approve (slice u8))]
  (-> bool)
  (= (if (> (len station-approve) 0) station-approve factory-approve) "yes"))

(defn station-attempts [(spec (ptr FactorySpec)) (station (ptr StationSpec))]
  (-> i64)
  (cond (> (.attempts station) 0) (.attempts station)
        (> (.attempts spec) 0) (.attempts spec)
        :else 3))

;;; The harnesses a station's agent can run in: `builtin`, the factory's own
;;; agent loop calling the model directly; `opencode`, the OpenCode CLI
;;; driven headlessly (which reaches models, such as OpenCode Zen's free ones,
;;; that only answer requests from OpenCode itself); and `codex`, the Codex
;;; CLI driven headlessly (which reaches the models of the operator's Codex
;;; login).
(const HARNESSES ["builtin" "opencode" "codex" "claude"])

(defn harness-known? [(name (slice u8))] (-> bool)
  (let [(mut found) false]
    (for known (iter HARNESSES)
      (when (= known name) (set! found true) 0))
    (load found)))

(defn harness-problem [(a (dyn Allocator)) (name (slice u8))] (-> (slice u8))
  (if (harness-known? name)
      ""
      (let [(mut out) (StrBuf::new a)]
        (push-str! (mut out) "unknown harness \"")
        (push-str! (mut out) name)
        (push-str! (mut out)
                   "\"; the harnesses are builtin, opencode, codex, and claude")
        (finish! (mut out)))))

;;; The harness a station uses: its own, the factory's, then `fallback`.
(defn station-harness [(spec (ptr FactorySpec))
                       (station (ptr StationSpec))
                       (fallback (slice u8))] (-> (slice u8))
  (cond (> (len (.harness station)) 0) (.harness station)
        (> (len (.harness spec)) 0) (.harness spec)
        :else fallback))

;;; The model a station uses: its own, the factory's, then `fallback`.
(defn station-model [(spec (ptr FactorySpec))
                     (station (ptr StationSpec))
                     (fallback (slice u8))] (-> (slice u8))
  (cond (> (len (.model station)) 0) (.model station)
        (> (len (.model spec)) 0) (.model spec)
        :else fallback))

(defn kebab-name? [(name (slice u8))] (-> bool)
  (let [n (len name)
        (mut ok) (and (> n 0) (<= n 48))
        (mut i) 0]
    (loop (if (or (>= (load i) n) (not (load ok)))
              (break)
              (let [c (cast i64 (get name (load i)))]
                (when (not (or (and (>= c 97) (<= c 122))
                               (and (>= c 48) (<= c 57))
                               (and (= c 45)
                                    (> (load i) 0)
                                    (< (load i) (- n 1)))))
                  (set! ok false)
                  0)
                (set! i (+ (load i) 1)))))
    (load ok)))

;;; Every name in a comma-separated tool list is `files` or `shell`.
(defn tool-list-problem [(a (dyn Allocator)) (tools (slice u8))] (-> (slice u8))
  (let [(mut problem) ""]
    (for raw (iter (split a tools ","))
      (let [name (trim raw)]
        (when (and (= (len (load problem)) 0)
                   (not (or (= name "files") (= name "shell"))))
          (let [(mut out) (StrBuf::new a)]
            (push-str! (mut out) "unknown tool group \"")
            (push-str! (mut out) name)
            (push-str! (mut out) "\"; the groups are files and shell")
            (set! problem (finish! (mut out)))
            0)
          0)))
    (load problem)))
