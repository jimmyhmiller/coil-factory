(module factory.runstate)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.serde.value" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "agent.json" :use *)
(import "factory.events" :use *)

;;; The meaning of a run's journal. Folding every record of `events.jsonl` in
;;; order yields where the run is, what each agent is doing right now, what it
;;; has cost, which operator messages are still undelivered, and what the
;;; overseer has noticed. The daemon folds incrementally as records arrive;
;;; the same fold serves the API, the dashboard, and the tests.

(defstruct StationState
  [(name (slice u8))
   ;;; pending | running | gate | review | approval | passed | blocked | failed
   (status (slice u8))
   (attempts i64)
   (gate-failures i64)
   ;;; Review rounds whose reviewers sent the work back.
   (review-rejections i64)
   ;;; The approval request this station is waiting on ("" when none): its
   ;;; id, its page, its kind (station or question), and, for finished work,
   ;;; the agent's finish summary, which a restarted worker commits with.
   (approval-id (slice u8))
   (approval-url (slice u8))
   (approval-kind (slice u8))
   (approval-summary (slice u8))
   ;;; Approval requests made so far, and what Jimmy decided in each, as the
   ;;; agent was told it.
   (approval-rounds i64)
   (approval-history (slice u8))
   (summary (slice u8))
   (started-t i64)
   (finished-t i64)])

(defstruct AgentState
  [(name (slice u8))
   ;;; idle | thinking | tool | gate | waiting | done
   (phase (slice u8))
   ;;; One human line: the tool it is running, the last thing it said.
   (activity (slice u8))
   (activity-t i64)
   (turns i64)
   (input-tokens i64)
   (output-tokens i64)
   (tool-calls i64)
   (tool-errors i64)])

(defstruct Finding
  [(t i64)
   (severity (slice u8))
   (code (slice u8))
   (agent (slice u8))
   (reviewer (slice u8))
   (message (slice u8))])

;;; What one reviewer last said about the run. `level` is ok | warn | alert;
;;; `failure` is set when its last attempt gave no verdict.
(defstruct ReviewerState
  [(name (slice u8))
   (verdict (slice u8))
   (level (slice u8))
   (reason (slice u8))
   (t i64)
   (failure (slice u8))
   (failure-t i64)])

(defstruct PendingMessage
  [(ref i64) (agent (slice u8)) (from (slice u8)) (text (slice u8)) (t i64)])

(defstruct RunState
  [(allocator (dyn Allocator))
   (id (slice u8))
   (factory (slice u8))
   (site (slice u8))
   (project (slice u8))
   (branch (slice u8))
   (base (slice u8))
   (model (slice u8))
   (harness (slice u8))
   (brief (slice u8))
   ;;; queued | running | paused | blocked | succeeded | failed | cancelled | lost
   (status (slice u8))
   (reason (slice u8))
   (created-t i64)
   (started-t i64)
   (finished-t i64)
   (updated-t i64)
   (current (slice u8))
   (stations (ArrayList StationState))
   (agents (ArrayList AgentState))
   (findings (ArrayList Finding))
   (pending (ArrayList PendingMessage))
   (input-tokens i64)
   (output-tokens i64)
   ;;; The reviewers watching the run, in the order it named them.
   (reviewers (ArrayList ReviewerState))
   (records i64)
   (cursor i64)])

(defn runstate-new [(a (dyn Allocator)) (id (slice u8))] (-> RunState)
  (let [(mut st) (zeroed RunState)]
    (set! (.allocator st) a)
    (set! (.id st) (copy-bytes a id))
    (set! (.factory st) "")
    (set! (.site st) "")
    (set! (.project st) "")
    (set! (.branch st) "")
    (set! (.base st) "")
    (set! (.model st) "")
    (set! (.harness st) "")
    (set! (.brief st) "")
    (set! (.status st) "queued")
    (set! (.reason st) "")
    (set! (.current st) "")
    (set! (.reviewers st) (ArrayList::new [ReviewerState] a))
    (set! (.stations st) (ArrayList::new [StationState] a))
    (set! (.agents st) (ArrayList::new [AgentState] a))
    (set! (.findings st) (ArrayList::new [Finding] a))
    (set! (.pending st) (ArrayList::new [PendingMessage] a))
    (load st)))

(defn int-to-text [(a (dyn Allocator)) (n i64)] (-> (slice u8))
  (let [(mut out) (StrBuf::new a)]
    (push-i64! (mut out) n)
    (finish! (mut out))))

(defn join-text [(a (dyn Allocator)) (parts (slice (slice u8)))] (-> (slice u8))
  (let [(mut out) (StrBuf::new a)]
    (for part (iter parts) (push-str! (mut out) part))
    (finish! (mut out))))

(defn terminal-status? [(status (slice u8))] (-> bool)
  (or (= status "succeeded")
      (= status "failed")
      (= status "cancelled")
      (= status "blocked")
      (= status "lost")))

(defn active-status? [(status (slice u8))] (-> bool)
  (or (= status "running") (= status "paused") (= status "approval")))

(defn field-str [(record JVal) (key (slice u8))] (-> (slice u8))
  (jv-string-or (jv-get record key) ""))

(defn field-int [(record JVal) (key (slice u8))] (-> i64)
  (jv-int (jv-get record key)))

(defn station-index [(st (ptr RunState)) (name (slice u8))] (-> i64)
  (let [(mut i) 0
        n (len (.stations st))
        (mut found) -1]
    (loop (if (>= (load i) n)
              (break)
              (if (= (.name (elem (field st stations) (load i))) name)
                  (do (set! found (load i)) (break))
                  (set! i (+ (load i) 1)))))
    (load found)))

;;; The station called `name`, created on first mention.
(defn station-at [(st (ptr RunState)) (name (slice u8))] (-> (ptr StationState))
  (let [index (station-index st name)]
    (if (>= index 0)
        (elem (field st stations) index)
        (let [(mut station) (zeroed StationState)]
          (set! (.name station) (copy-bytes (.allocator st) name))
          (set! (.status station) "pending")
          (set! (.summary station) "")
          (push! [StationState] (mut (.stations st)) (load station))
          (elem (field st stations) (- (len (.stations st)) 1))))))

;;; The agent called `name`, created on first mention.
(defn agent-at [(st (ptr RunState)) (name (slice u8))] (-> (ptr AgentState))
  (let [(mut i) 0
        n (len (.agents st))
        (mut found) -1]
    (loop (if (>= (load i) n)
              (break)
              (if (= (.name (elem (field st agents) (load i))) name)
                  (do (set! found (load i)) (break))
                  (set! i (+ (load i) 1)))))
    (if (>= (load found) 0)
        (elem (field st agents) (load found))
        (let [(mut agent) (zeroed AgentState)]
          (set! (.name agent) (copy-bytes (.allocator st) name))
          (set! (.phase agent) "idle")
          (set! (.activity agent) "")
          (push! [AgentState] (mut (.agents st)) (load agent))
          (elem (field st agents) (- (len (.agents st)) 1))))))

(defn set-activity! [(st (ptr RunState))
                     (agent (ptr AgentState))
                     (phase (slice u8))
                     (text (slice u8))
                     (t i64)] (-> i64)
  (do
    (set! (.phase agent) phase)
    (set! (.activity agent) (first-line (.allocator st) text 160))
    (set! (.activity-t agent) t)
    0))

(defn activity-with-mark [(a (dyn Allocator))
                          (mark (slice u8))
                          (text (slice u8))] (-> (slice u8))
  (let [(mut out) (StrBuf::new a)]
    (push-str! (mut out) mark)
    (push-str! (mut out) " ")
    (push-str! (mut out) text)
    (finish! (mut out))))

(defn remove-pending! [(st (ptr RunState)) (ref i64)] (-> i64)
  (let [(mut i) 0
        n (len (.pending st))
        (mut found) -1]
    (loop (if (>= (load i) n)
              (break)
              (if (= (.ref (elem (field st pending) (load i))) ref)
                  (do (set! found (load i)) (break))
                  (set! i (+ (load i) 1)))))
    (if (>= (load found) 0)
        (let [(mut rest) (ArrayList::new [PendingMessage] (.allocator st))
              (mut j) 0]
          (loop (if (>= (load j) n)
                    (break)
                    (do
                      (when (!= (load j) (load found))
                        (push! [PendingMessage]
                               (mut rest)
                               (get (.pending st) (load j)))
                        0)
                      (set! j (+ (load j) 1)))))
          (free! (mut (.pending st)))
          (set! (.pending st) (load rest))
          1)
        0)))

;;; Fold one record, found at byte `offset` of the journal, whose line ends at
;;; `next`. Strings kept in the state are copied into its allocator.
(defn fold-record! [(st (ptr RunState)) (offset i64) (next i64) (record JVal)]
  (-> i64)
  (let [a (.allocator st)
        kind (field-str record "kind")
        t (field-int record "t")
        agent-name (field-str record "agent")]
    (set! (.records st) (+ (.records st) 1))
    (set! (.cursor st) next)
    (when (> t (.updated-t st)) (set! (.updated-t st) t) 0)
    (cond (= kind "run.created")
            (do
              (set! (.factory st) (copy-bytes a (field-str record "factory")))
              (set! (.site st) (copy-bytes a (field-str record "site")))
              (set! (.project st) (copy-bytes a (field-str record "project")))
              (set! (.branch st) (copy-bytes a (field-str record "branch")))
              (set! (.model st) (copy-bytes a (field-str record "model")))
              (set! (.harness st) (copy-bytes a (field-str record "harness")))
              (set! (.brief st) (first-line a (field-str record "brief") 200))
              (set! (.created-t st) t)
              (set! (.status st) "queued")
              (let [names (jv-get record "stations")
                    n (jv-count names)
                    (mut i) 0]
                (loop (if (>= (load i) n)
                          (break)
                          (do
                            (station-at st
                                        (jv-string-or (jv-nth names (load i))
                                                      ""))
                            (set! i (+ (load i) 1)))))
                0)
              (let [names (jv-get record "reviewers")
                    (mut i) 0]
                (loop (if (>= (load i) (jv-count names))
                          (break)
                          (do
                            (reviewer-at st
                                         (jv-string-or (jv-nth names (load i))
                                                       ""))
                            (set! i (+ (load i) 1)))))
                0))
          (= kind "run.started")
            (do
              (set! (.status st) "running")
              (set! (.reason st) "")
              (when (= (.started-t st) 0) (set! (.started-t st) t) 0)
              (let [base (field-str record "base")]
                (when (> (len base) 0) (set! (.base st) (copy-bytes a base)) 0))
              0)
          (= kind "run.finished")
            (do
              (set! (.status st) (copy-bytes a (field-str record "status")))
              (set! (.reason st) (first-line a (field-str record "reason") 300))
              (set! (.finished-t st) t)
              (let [(mut i) 0
                    n (len (.agents st))]
                (loop (if (>= (load i) n)
                          (break)
                          (let [agent (elem (field st agents) (load i))]
                            (when (not (= (.phase agent) "done"))
                              (set! (.phase agent) "idle")
                              0)
                            (set! i (+ (load i) 1))))))
              0)
          (= kind "run.lost")
            (do
              (set! (.status st) "lost")
              (set! (.reason st) (first-line a (field-str record "reason") 300))
              0)
          (= kind "control")
            (let [action (field-str record "action")]
              (cond (and (= action "pause") (= (.status st) "running"))
                      (do (set! (.status st) "paused") 0)
                    (and (= action "resume") (= (.status st) "paused"))
                      (do (set! (.status st) "running") 0)
                    :else 0))
          (= kind "station.started")
            (let [station (station-at st agent-name)
                  agent (agent-at st agent-name)]
              (set! (.status station) "running")
              (set! (.attempts station) (+ (.attempts station) 1))
              (when (= (.started-t station) 0) (set! (.started-t station) t) 0)
              (set! (.current st) (.name station))
              (set-activity! st agent "thinking" "starting" t))
          (= kind "station.finished")
            (let [station (station-at st agent-name)
                  agent (agent-at st agent-name)
                  outcome (field-str record "outcome")]
              (set! (.status station) (copy-bytes a outcome))
              (set! (.summary station)
                    (preview a (trim (field-str record "summary")) 4000))
              (set! (.finished-t station) t)
              (set-activity! st
                             agent
                             (if (= outcome "passed") "done" "waiting")
                             (field-str record "summary")
                             t))
          (= kind "gate.started")
            (let [station (station-at st agent-name)
                  agent (agent-at st agent-name)]
              (set! (.status station) "gate")
              (set-activity! st
                             agent
                             "gate"
                             (activity-with-mark a
                                                 "gate"
                                                 (field-str record "command"))
                             t))
          (= kind "gate.finished")
            (let [station (station-at st agent-name)]
              (when (not (jv-bool-or (jv-get record "ok") false))
                (set! (.gate-failures station) (+ (.gate-failures station) 1))
                (set! (.status station) "running")
                0)
              0)
          (= kind "approval.requested")
            (let [station (station-at st agent-name)
                  agent (agent-at st agent-name)
                  url (field-str record "url")]
              (set! (.status station) "approval")
              (set! (.approval-id station)
                    (copy-bytes a (field-str record "id")))
              (set! (.approval-url station) (copy-bytes a url))
              (set! (.approval-kind station)
                    (copy-bytes a (field-str record "approval_kind")))
              (set! (.approval-summary station)
                    (copy-bytes a (field-str record "summary")))
              (set! (.approval-rounds station) (+ (.approval-rounds station) 1))
              (when (= (.status st) "running") (set! (.status st) "approval") 0)
              (set! (.reason st)
                    (copy-bytes a
                                (join-text a
                                           ["waiting for your approval: " url])))
              (set-activity! st
                             agent
                             "waiting"
                             (activity-with-mark a "approval" url)
                             t))
          (or (= kind "approval.decided") (= kind "approval.withdrawn"))
            (let [station (station-at st agent-name)
                  message (field-str record "message")]
              (when (and (= kind "approval.decided") (> (len message) 0))
                (set! (.approval-history station)
                      (copy-bytes a
                                  (join-text a
                                             [(.approval-history station)
                                              (if (> (len (.approval-history station))
                                                     0)
                                                  "\n\n"
                                                  "")
                                              "Round "
                                              (int-to-text a
                                                           (jv-int (jv-get record
                                                                           "round")))
                                              ":\n"
                                              message])))
                0)
              (set! (.approval-id station) "")
              (set! (.approval-url station) "")
              (set! (.approval-kind station) "")
              (set! (.approval-summary station) "")
              (when (= (.status station) "approval")
                (set! (.status station) "running")
                0)
              (when (= (.status st) "approval")
                (set! (.status st) "running")
                (set! (.reason st) "")
                0)
              0)
          (= kind "review.started")
            (let [station (station-at st agent-name)
                  agent (agent-at st agent-name)]
              (set! (.status station) "review")
              (set-activity! st
                             agent
                             "gate"
                             (activity-with-mark a
                                                 "review"
                                                 (field-str record "reviewers"))
                             t))
          (= kind "review.round")
            (let [station (station-at st agent-name)]
              (when (not (jv-bool-or (jv-get record "approved") false))
                (set! (.review-rejections station)
                      (+ (.review-rejections station) 1))
                (set! (.status station) "running")
                0)
              0)
          (= kind "agent.turn")
            (let [agent (agent-at st agent-name)]
              (set! (.turns agent) (+ (.turns agent) 1))
              (set! (.phase agent) "thinking")
              (set! (.activity-t agent) t)
              0)
          (= kind "agent.text")
            (set-activity! st
                           (agent-at st agent-name)
                           "thinking"
                           (field-str record "text")
                           t)
          (= kind "agent.usage")
            (let [agent (agent-at st agent-name)
                  input (field-int record "input")
                  output (field-int record "output")]
              (set! (.input-tokens agent) (+ (.input-tokens agent) input))
              (set! (.output-tokens agent) (+ (.output-tokens agent) output))
              (set! (.input-tokens st) (+ (.input-tokens st) input))
              (set! (.output-tokens st) (+ (.output-tokens st) output))
              0)
          (= kind "tool.started")
            (let [agent (agent-at st agent-name)]
              (set! (.tool-calls agent) (+ (.tool-calls agent) 1))
              (set-activity! st agent "tool" (field-str record "summary") t))
          (= kind "tool.finished")
            (let [agent (agent-at st agent-name)]
              (when (not (jv-bool-or (jv-get record "ok") true))
                (set! (.tool-errors agent) (+ (.tool-errors agent) 1))
                0)
              (set! (.phase agent) "thinking")
              0)
          (= kind "message.sent")
            (let [(mut message) (zeroed PendingMessage)]
              (set! (.ref message) offset)
              (set! (.agent message) (copy-bytes a agent-name))
              (set! (.from message) (copy-bytes a (field-str record "from")))
              (set! (.text message) (preview a (field-str record "text") 2000))
              (set! (.t message) t)
              (push! [PendingMessage] (mut (.pending st)) (load message))
              0)
          (= kind "message.received")
            (do
              (remove-pending! st (field-int record "ref"))
              (set-activity! st
                             (agent-at st agent-name)
                             "thinking"
                             (activity-with-mark a
                                                 "✉"
                                                 (field-str record "text"))
                             t))
          (= kind "finding")
            (let [(mut finding) (zeroed Finding)]
              (set! (.t finding) t)
              (set! (.severity finding)
                    (copy-bytes a (field-str record "severity")))
              (set! (.code finding) (copy-bytes a (field-str record "code")))
              (set! (.agent finding) (copy-bytes a agent-name))
              (set! (.reviewer finding)
                    (copy-bytes a (field-str record "reviewer")))
              (set! (.message finding)
                    (preview a (field-str record "message") 600))
              (push! [Finding] (mut (.findings st)) (load finding))
              0)
          (= kind "run.requeued")
            (do (set! (.status st) "queued") (set! (.reason st) "") 0)
          (= kind "oversight")
            (let [r (reviewer-at st (oversight-reviewer record))]
              (set! (.verdict r) (copy-bytes a (field-str record "verdict")))
              (set! (.level r) (copy-bytes a (oversight-level record)))
              (set! (.reason r) (first-line a (field-str record "reason") 300))
              (set! (.t r) t)
              (set! (.failure r) "")
              0)
          (= kind "oversight.failed")
            (let [r (reviewer-at st (field-str record "reviewer"))]
              (set! (.failure r)
                    (first-line a (field-str record "message") 300))
              (set! (.failure-t r) t)
              0)
          (= kind "conversation.started")
            (set-activity! st
                           (agent-at st agent-name)
                           "thinking"
                           "in conversation"
                           t)
          (= kind "conversation.finished")
            (set-activity! st
                           (agent-at st agent-name)
                           "idle"
                           (activity-with-mark a
                                               "replied:"
                                               (field-str record "reply"))
                           t)
          (= kind "agent.streaming")
            (set-activity! st
                           (agent-at st agent-name)
                           "thinking"
                           (activity-with-mark a
                                               "thinking:"
                                               (activity-with-mark a "streaming" (field-str record "part")))
                           t)
          (= kind "agent.thought")
            (set-activity! st
                           (agent-at st agent-name)
                           "thinking"
                           (activity-with-mark a
                                               "thinking:"
                                               (field-str record "text"))
                           t)
          (= kind "agent.retry")
            (set-activity! st
                           (agent-at st agent-name)
                           "thinking"
                           (activity-with-mark a
                                               "model retry:"
                                               (field-str record "message"))
                           t)
          :else 0)))

(defn jv-bool-or [(value JVal) (fallback bool)] (-> bool)
  (match value
    (JBool [b] b)
    (_ fallback)))

;;; The state of the reviewer named `name`, added when first seen.
(defn reviewer-at [(st (ptr RunState)) (name (slice u8))]
  (-> (ptr ReviewerState))
  (let [(mut found) -1
        (mut i) 0]
    (loop (if (>= (load i) (len (.reviewers st)))
              (break)
              (do
                (when (= (.name (elem (field st reviewers) (load i))) name)
                  (set! found (load i))
                  0)
                (set! i (+ (load i) 1)))))
    (when (< (load found) 0)
      (push! [ReviewerState]
             (mut (.reviewers st))
             (ReviewerState
               :name (copy-bytes (.allocator st) name)
               :verdict ""
               :level ""
               :reason ""
               :t 0
               :failure ""
               :failure-t 0))
      (set! found (- (len (.reviewers st)) 1))
      0)
    (elem (field st reviewers) (load found))))

;;; Journals written before reviewers existed have `oversight` records from
;;; the built-in judge, without a reviewer or level; read them as that judge.
(defn oversight-reviewer [(record JVal)] (-> (slice u8))
  (let [name (field-str record "reviewer")]
    (if (> (len name) 0) name "judge")))

(defn oversight-level [(record JVal)] (-> (slice u8))
  (let [level (field-str record "level")
        verdict (field-str record "verdict")]
    (cond (> (len level) 0) level
          (= verdict "on_track") "ok"
          (= verdict "cheating") "alert"
          :else "warn")))

;;; The state as a JSON object for the API. Allocated in `a`.
(defn runstate-json [(a (dyn Allocator)) (st (ptr RunState))] (-> JVal)
  (let [out (jv-object a)
        stations (jv-array a)
        agents (jv-array a)
        findings (jv-array a)
        pending (jv-array a)]
    (jv-put! out "id" (JStr (.id st)))
    (jv-put! out "factory" (JStr (.factory st)))
    (jv-put! out "site" (JStr (.site st)))
    (jv-put! out "project" (JStr (.project st)))
    (jv-put! out "branch" (JStr (.branch st)))
    (jv-put! out "base" (JStr (.base st)))
    (jv-put! out "model" (JStr (.model st)))
    (jv-put! out "harness" (JStr (.harness st)))
    (jv-put! out "brief" (JStr (.brief st)))
    (jv-put! out "status" (JStr (.status st)))
    (jv-put! out "reason" (JStr (.reason st)))
    (jv-put! out "current" (JStr (.current st)))
    (jv-put! out "created" (JInt (.created-t st)))
    (jv-put! out "started" (JInt (.started-t st)))
    (jv-put! out "finished" (JInt (.finished-t st)))
    (jv-put! out "updated" (JInt (.updated-t st)))
    (jv-put! out "input_tokens" (JInt (.input-tokens st)))
    (jv-put! out "output_tokens" (JInt (.output-tokens st)))
    (jv-put! out "cursor" (JInt (.cursor st)))
    (let [reviewers (jv-array a)]
      (for reviewer (iter (.reviewers st))
        (let [r reviewer
              entry (jv-object a)]
          (jv-put! entry "name" (JStr (.name r)))
          (jv-put! entry "verdict" (JStr (.verdict r)))
          (jv-put! entry "level" (JStr (.level r)))
          (jv-put! entry "reason" (JStr (.reason r)))
          (jv-put! entry "t" (JInt (.t r)))
          (jv-put! entry "failure" (JStr (.failure r)))
          (jv-put! entry "failure_t" (JInt (.failure-t r)))
          (jv-push! reviewers entry)))
      (jv-put! out "reviewers" reviewers))
    (for station (iter (.stations st))
      (let [s station
            entry (jv-object a)]
        (jv-put! entry "name" (JStr (.name s)))
        (jv-put! entry "status" (JStr (.status s)))
        (jv-put! entry "attempts" (JInt (.attempts s)))
        (jv-put! entry "gate_failures" (JInt (.gate-failures s)))
        (jv-put! entry "review_rejections" (JInt (.review-rejections s)))
        (jv-put! entry "approval_url" (JStr (.approval-url s)))
        (jv-put! entry "approval_rounds" (JInt (.approval-rounds s)))
        (jv-put! entry "summary" (JStr (.summary s)))
        (jv-put! entry "started" (JInt (.started-t s)))
        (jv-put! entry "finished" (JInt (.finished-t s)))
        (jv-push! stations entry)))
    (for agent (iter (.agents st))
      (let [g agent
            entry (jv-object a)]
        (jv-put! entry "name" (JStr (.name g)))
        (jv-put! entry "phase" (JStr (.phase g)))
        (jv-put! entry "activity" (JStr (.activity g)))
        (jv-put! entry "activity_t" (JInt (.activity-t g)))
        (jv-put! entry "turns" (JInt (.turns g)))
        (jv-put! entry "input_tokens" (JInt (.input-tokens g)))
        (jv-put! entry "output_tokens" (JInt (.output-tokens g)))
        (jv-put! entry "tool_calls" (JInt (.tool-calls g)))
        (jv-put! entry "tool_errors" (JInt (.tool-errors g)))
        (jv-push! agents entry)))
    (for finding (iter (.findings st))
      (let [f finding
            entry (jv-object a)]
        (jv-put! entry "t" (JInt (.t f)))
        (jv-put! entry "severity" (JStr (.severity f)))
        (jv-put! entry "code" (JStr (.code f)))
        (jv-put! entry "agent" (JStr (.agent f)))
        (jv-put! entry "reviewer" (JStr (.reviewer f)))
        (jv-put! entry "message" (JStr (.message f)))
        (jv-push! findings entry)))
    (for message (iter (.pending st))
      (let [m message
            entry (jv-object a)]
        (jv-put! entry "ref" (JInt (.ref m)))
        (jv-put! entry "agent" (JStr (.agent m)))
        (jv-put! entry "from" (JStr (.from m)))
        (jv-put! entry "text" (JStr (.text m)))
        (jv-put! entry "t" (JInt (.t m)))
        (jv-push! pending entry)))
    (jv-put! out "stations" stations)
    (jv-put! out "agents" agents)
    (jv-put! out "findings" findings)
    (jv-put! out "pending_messages" pending)
    out))
