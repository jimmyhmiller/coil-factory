(module factory.ui.network)
(import "coil.alloc" :use *)
(import "coil.slice" :use *)
(import "coil.serde.value" :use *)
(import "coil.str" :use *)
(import "coil.scratch" :as scratch)
(import "coil.atomic" :as atomic)
(import "coil.thread" :as thread)
(import "agent.json" :use *)
(import "factory.client" :use *)
(import "factory.proc" :use [spawn-detached self-executable])
(import "factory.session" :as session)
(import "agent.loop" :use [sleep-ms])
(import "ssh.target" :as target)
(import "ssh.exec" :as ssh)
(import "ssh.tunnel" :as tunnel)

;;; A bounded, asynchronous request. Only the worker touches its arena until
;;; done is published; the UI joins before reading or releasing it. A successful
;;; SSH connection retains the job as owner of its tunnel and authentication.
(defstruct Job
  [(arena scratch/ScratchArena)
   (thread thread/Thread)
   (done i64)
   (kind i64)
   (home (slice u8))
   (address (slice u8))
   (name (slice u8))
   (endpoint (slice u8))
   (hub Hub)
   (reply Reply)
   (owns-tunnel bool)
   (tunnel (ptr tunnel/Tunnel))])

(defn run [(arg (ptr i8))] (-> (ptr i8))
  (let [job (cast (ptr Job) arg)
        a (allocator (field job arena))]
    (block :run
      (when (and (or (= (.kind job) 2) (= (.kind job) 5))
                 (!= (cast i64 (.tunnel job)) 0))
        (match (tunnel/tunnel-ensure! (.tunnel job))
          (tunnel/TunnelReady [port]
                              (set! (.base-url (field job hub))
                                    (tunnel/tunnel-base-url a port)))
          (tunnel/TunnelFailed [why]
                               (do
                                 (set! (.reply job) (ReplyFailed why))
                                 (return-from :run 0)))))
      (when (or (= (.kind job) 3) (= (.kind job) 4))
        (if (= (.kind job) 3)
            (when (< (spawn-detached a
                                     (self-executable a)
                                     ["daemon" "--background"])
                     0)
              (set! (.reply job)
                    (ReplyFailed "Could not start the local factory."))
              (return-from :run 0))
            0))
      (when (starts-with (.address job) "ssh://")
        (let [destination (subslice (.address job) 6 (len (.address job)))
              t
                (match (target/parse-target destination)
                  (Ok [t] t)
                  (Err [why]
                       (do
                         (set! (.reply job) (ReplyFailed why))
                         (return-from :run 0))))]
          (when (= (.kind job) 4)
            (match (ssh/ssh-run a
                                t
                                (ssh/ssh-options)
                                "~/.factory/bin/factory up --quiet"
                                (None)
                                15000)
              (Ok [r]
                  (when (not (ssh/ssh-result-ok? r))
                    (set! (.reply job) (ReplyFailed (copy-bytes a (.stderr r))))
                    (return-from :run 0)))
              (Err [e]
                   (do
                     (set! (.reply job)
                           (ReplyFailed (ssh/ssh-error-message a e)))
                     (return-from :run 0)))))
          (let [remote-config
                  (match (ssh/ssh-run a
                                      t
                                      (ssh/ssh-options)
                                      "cat ~/.factory/site.json"
                                      (None)
                                      15000)
                    (Ok [r]
                        (match (jv-parse a (.stdout r))
                          (Some [v] v)
                          (_ (JNull))))
                    (_ (JNull)))
                configured-port (jv-int (jv-get remote-config "port"))
                port (if (> configured-port 0) configured-port 7788)
                forward
                  (box! (malloc-allocator)
                        tunnel/Tunnel
                        (tunnel/tunnel-new a (tunnel/tunnel-spec t port)))]
            (set! (.tunnel job) forward)
            (set! (.owns-tunnel job) true)
            (when (= (len (.token (.hub job))) 0)
              (match (ssh/ssh-run a
                                  t
                                  (ssh/ssh-options)
                                  "cat ~/.factory/token"
                                  (None)
                                  15000)
                (Ok [r]
                    (if (ssh/ssh-result-ok? r)
                        (set! (.token (field job hub))
                              (copy-bytes a (trim (.stdout r))))
                        (do
                          (set! (.reply job)
                                (ReplyFailed "Cannot read the factory token over SSH."))
                          (return-from :run 0))))
                (Err [e]
                     (do
                       (set! (.reply job)
                             (ReplyFailed (ssh/ssh-error-message a e)))
                       (return-from :run 0)))))
            (match (tunnel/tunnel-open! forward)
              (tunnel/TunnelReady [port]
                                  (set! (.base-url (field job hub))
                                        (tunnel/tunnel-base-url a port)))
              (tunnel/TunnelFailed [why]
                                   (do
                                     (set! (.reply job) (ReplyFailed why))
                                     (return-from :run 0)))))))
      (if (= (.kind job) 3)
          (let [(mut attempt) 0]
            (loop (set! (.token (field job hub)) (read-token a (.home job)))
              (set! (.reply job)
                    (hub-call a (.hub job) "GET" "/v1/site" "" 500))
              (when (or (reply-ok? (.reply job)) (>= (load attempt) 40))
                (break))
              (sleep-ms 100)
              (set! attempt (+ (load attempt) 1))))
          (set! (.reply job)
                (hub-call a
                          (.hub job)
                          "GET"
                          (.endpoint job)
                          ""
                          3000)))
      (when (and (!= (.kind job) 2)
                 (!= (.kind job) 5)
                 (reply-ok? (.reply job))
                 (not (= (jv-string-or (jv-get (reply-body (.reply job))
                                               "version")
                                       "")
                         "1")))
        (set! (.reply job)
              (ReplyFailed "This address did not return a supported factory site API.")))
      0)
    (atomic/store (field job done) 1)
    (cast (ptr i8) 0)))

(defn start-with-tunnel [(a (dyn Allocator))
                         (kind i64)
                         (home (slice u8))
                         (hub Hub)
                         (address (slice u8))
                         (name (slice u8))
                         (borrowed-tunnel (ptr tunnel/Tunnel))
                         (endpoint (slice u8))] (-> (ptr Job))
  (let [job (box! a Job (zeroed Job))]
    (scratch/ScratchArena::init (field job arena) (malloc-allocator))
    (set! (.tunnel job) borrowed-tunnel)
    (let [scratch (allocator (field job arena))]
      (set! (.kind job) kind)
      (set! (.home job) (copy-bytes scratch home))
      (set! (.address job) (copy-bytes scratch address))
      (set! (.name job) (copy-bytes scratch name))
      (set! (.endpoint job) (copy-bytes scratch endpoint))
      (set! (.hub job)
            (Hub
              :base-url (copy-bytes scratch (.base-url hub))
              :token (copy-bytes scratch (.token hub))))
      (set! (.reply job) (ReplyFailed "Connecting…")))
    (when (!= (thread/Thread::spawn (field job thread)
                                    (fnptr-of run)
                                    (cast (ptr i8) job))
              (cast i32 0))
      (set! (.reply job) (ReplyFailed "Could not start the connection worker."))
      (atomic/store (field job done) 1))
    job))

(defn start [(a (dyn Allocator))
             (kind i64)
             (home (slice u8))
             (hub Hub)
             (address (slice u8))
             (name (slice u8))] (-> (ptr Job))
  (start-with-tunnel a
                     kind
                     home
                     hub
                     address
                     name
                     (cast (ptr tunnel/Tunnel) 0)
                     (if (= kind 2) "/v1/overview" "/v1/site")))

(defn refresh [(a (dyn Allocator))
               (home (slice u8))
               (hub Hub)
               (name (slice u8))
               (owner (ptr Job))] (-> (ptr Job))
  (start-with-tunnel a
                     2
                     home
                     hub
                     (.base-url hub)
                     name
                     (if (= (cast i64 owner) 0)
                         (cast (ptr tunnel/Tunnel) 0)
                         (.tunnel owner))
                     "/v1/overview"))

(defn fetch [(a (dyn Allocator))
             (home (slice u8))
             (hub Hub)
             (name (slice u8))
             (endpoint (slice u8))
             (owner (ptr Job))] (-> (ptr Job))
  (start-with-tunnel a
                     5
                     home
                     hub
                     (.base-url hub)
                     name
                     (if (= (cast i64 owner) 0)
                         (cast (ptr tunnel/Tunnel) 0)
                         (.tunnel owner))
                     endpoint))

(defn ready? [(job (ptr Job))] (-> bool)
  (and (!= (cast i64 job) 0) (= (atomic/read (field job done)) 1)))

(defn close! [(a (dyn Allocator)) (job (ptr Job))] (-> i64)
  (when (!= (cast i64 job) 0)
    (join (field job thread))
    (when (and (.owns-tunnel job) (!= (cast i64 (.tunnel job)) 0))
      (tunnel/tunnel-free! (.tunnel job))
      (destroy (malloc-allocator) (.tunnel job))
      0)
    (close! (field job arena))
    (destroy a job)
    0)
  0)
