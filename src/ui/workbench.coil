(module factory.ui.workbench)
(import "coil.alloc" :use *)
(import "coil.slice" :use *)
(import "coil.os" :as os)
(import "coil.serde.value" :use *)
(import "tui.widgets" :use *)
(import "tui.palette" :use *)
(import "tui.canvas" :use [Rect])
(import "factory.config" :use *)
(import "factory.proc" :use [search-path])
(import "factory.ui.store" :use *)
(import "factory.session" :as session)
(import "agent.json" :use [jv-object jv-put!])
(import "factory.model-catalog" :as catalog)
(import "factory.ui.network" :as network)

;;; Local conversation and factory connection are separate pieces of state.
;;; Losing a factory connection cannot interrupt a personal conversation.
(defstruct Workbench
  [(home (slice u8))
   (session-id (slice u8))
   (status (slice u8))
   (sessions Snap)
   (current Snap)
   (profiles Snap)
   (sidebar Snap)
   (actions Snap)
   (action-hits Snap)
   (action-edit-doc Snap)
   (action-job (ptr network/Job))
   (action-mutating bool)
   (action-pending (slice u8))
   (action-pending-project (slice u8))
   (actions-project (slice u8))
   (actions-polled i64)
   (actions-unavailable bool)
   (action-selected i64)
   (action-output (slice u8))
   (action-error (slice u8))
   (action-editor bool)
   (action-fields (array TextInput 4))
   (action-field i64)
   (action-original (slice u8))
   (action-token (slice u8))
   (sidebar-visible bool)
   (workspace-visible bool)
   (sidebar-focus bool)
   (sidebar-sv ScrollView)
   (context-r Rect)
   (layout-r Rect)
   (workspace-width i64)
   (context-width i64)
   (dragging i64)
   (sidebar-polled i64)
   (workspace-r Rect)
   (history-r Rect)
   (history ListView)
   (history-focus bool)
   (models-open bool)
   (models Palette)
   (model-options Snap)
   (model-job (ptr catalog/Job))
   (model-error (slice u8))
   (settings-open bool)
   (settings (array TextInput 3))
   (service-tier (slice u8))
   (settings-focus i64)
   (connections-open bool)
   (connection (array TextInput 3))
   (connection-focus i64)
   (connection-name (slice u8))
   (profile-list ListView)
   (connected bool)
   (starting bool)
   (start-time i64)
   (auto-submit bool)
   (polled i64)
   (job (ptr network/Job))
   (active-connection (ptr network/Job))])

(defn init! [(w (ptr Workbench)) (a (dyn Allocator)) (home (slice u8))] (-> i64)
  (set! (.home w) home)
  (set! (.session-id w) "")
  (set! (.status w) "new")
  (snap-init! (field w sessions) a)
  (snap-init! (field w current) a)
  (snap-init! (field w model-options) a)
  (set! (.models w) (palette-new a))
  (snap-init! (field w profiles) a)
  (snap-init! (field w sidebar) a)
  (snap-init! (field w actions) a)
  (snap-init! (field w action-hits) a)
  (snap-init! (field w action-edit-doc) a)
  (set! (.actions-project w) "")
  (set! (.actions-unavailable w) true)
  (set! (.action-job w) (cast (ptr network/Job) 0))
  (set! (.action-mutating w) false)
  (set! (.action-editor w) false)
  (set! (.action-selected w) 0)
  (set! (.actions-polled w) 0)
  (set! (.action-field w) 0)
  (set! (.action-output w) "")
  (set! (.action-error w) "")
  (set! (.action-original w) "")
  (set! (.action-token w) "")
  (set! (.action-pending w) "")
  (set! (.action-pending-project w) "")
  (for i (range 0 4)
    (set! (index (field w action-fields) i) (text-input-new a false)))
  (set! (.sidebar-visible w) true)
  (set! (.workspace-visible w) true)
  (set! (.sidebar-sv w) (scroll-view-new))
  (set! (.history w) (list-view-new))
  (set! (.workspace-width w) 23)
  (set! (.context-width w) 30)
  (let [layout (session/read-doc a (session/cat a [home "/layout.json"]))
        left (jv-int (jv-get layout "workspace_width"))
        right (jv-int (jv-get layout "context_width"))]
    (set! (.workspace-visible w)
          (match (jv-get layout "workspace_visible")
            (JBool [visible] visible)
            (_ true)))
    (set! (.sidebar-visible w)
          (match (jv-get layout "context_visible")
            (JBool [visible] visible)
            (_ true)))
    (when (>= left 16) (set! (.workspace-width w) left))
    (when (>= right 18) (set! (.context-width w) right)))
  (set! (.connection-name w) (session/cat a ["Local factory"]))
  (set! (.profile-list w) (list-view-new))
  (for i (range 0 3)
    (set! (index (field w settings) i) (text-input-new a false))
    (set! (index (field w connection) i) (text-input-new a false)))
  (set! (.service-tier w) "")
  (let [config
          (match (load-site-config a home)
            (SiteConfigOk [c] c)
            (_ (zeroed SiteConfig)))
        configured (> (len (.default-model config)) 0)
        provider
          (if (or configured (not (= (.default-harness config) "builtin")))
              (.default-harness config)
              (match (search-path a "claude")
                (Some [_] "claude")
                (_ (match (search-path a "codex")
                     (Some [_] "codex")
                     (_ "builtin")))))
        model
          (cond (= provider "claude") (.claude-model config)
                (= provider "codex") (.codex-model config)
                (= provider "opencode") (.opencode-model config)
                :else (.default-model config))
        cwd (match (os/current-dir a) (Ok [s] (slice s)) (_ ""))]
    (input-set-text! (index (field w settings) 0) cwd)
    (input-set-text! (index (field w settings) 1) provider)
    (input-set-text! (index (field w settings) 2) model))
  (let [pa (snap-spare (field w profiles))
        doc (session/read-doc pa (session/cat pa [home "/connections.json"]))]
    (snap-commit! (field w profiles) doc 0))
  0)

(defn value [(w (ptr Workbench)) (i i64)] (-> (slice u8))
  (input-text (index (field w settings) i)))

(defn connection-value [(w (ptr Workbench)) (i i64)] (-> (slice u8))
  (input-text (index (field w connection) i)))

(defn save-layout! [(w (ptr Workbench)) (a (dyn Allocator))] (-> bool)
  (let [doc (jv-object a)]
    (jv-put! doc "workspace_visible" (JBool (.workspace-visible w)))
    (jv-put! doc "context_visible" (JBool (.sidebar-visible w)))
    (jv-put! doc "workspace_width" (JInt (.workspace-width w)))
    (jv-put! doc "context_width" (JInt (.context-width w)))
    (session/write-doc! a (session/cat a [(.home w) "/layout.json"]) doc)))
