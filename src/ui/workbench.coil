(module factory.ui.workbench)
(import "coil.alloc" :use *)
(import "coil.slice" :use *)
(import "coil.os" :as os)
(import "coil.serde.value" :use *)
(import "tui.widgets" :use *)
(import "factory.config" :use *)
(import "factory.proc" :use [search-path])
(import "factory.ui.store" :use *)
(import "factory.session" :as session)
(import "factory.ui.network" :as network)

;;; Local conversation and factory connection are separate pieces of state.
;;; Losing a factory connection cannot interrupt a personal conversation.
(defstruct Workbench
  [(home (slice u8))
   (session-id (slice u8))
   (status (slice u8))
   (sessions Snap)
   (current Snap)
   (profiles Snap)
   (sidebar Snap)
   (sidebar-visible bool)
   (sidebar-focus bool)
   (sidebar-sv ScrollView)
   (sidebar-polled i64)
   (history ListView)
   (history-focus bool)
   (settings-open bool)
   (settings (array TextInput 3))
   (settings-focus i64)
   (connections-open bool)
   (connection (array TextInput 3))
   (connection-focus i64)
   (connection-name (slice u8))
   (profile-list ListView)
   (connected bool)
   (starting bool)
   (start-time i64)
   (auto-submit bool)
   (polled i64)
   (job (ptr network/Job))
   (active-connection (ptr network/Job))])

(defn init! [(w (ptr Workbench)) (a (dyn Allocator)) (home (slice u8))] (-> i64)
  (set! (.home w) home)
  (set! (.session-id w) "")
  (set! (.status w) "new")
  (snap-init! (field w sessions) a)
  (snap-init! (field w current) a)
  (snap-init! (field w profiles) a)
  (snap-init! (field w sidebar) a)
  (set! (.sidebar-visible w) true)
  (set! (.sidebar-sv w) (scroll-view-new))
  (set! (.history w) (list-view-new))
  (set! (.connection-name w) (session/cat a ["Local factory"]))
  (set! (.profile-list w) (list-view-new))
  (for i (range 0 3)
    (set! (index (field w settings) i) (text-input-new a false))
    (set! (index (field w connection) i) (text-input-new a false)))
  (let [config
          (match (load-site-config a home)
            (SiteConfigOk [c] c)
            (_ (zeroed SiteConfig)))
        configured (> (len (.default-model config)) 0)
        provider
          (if (or configured (not (= (.default-harness config) "builtin")))
              (.default-harness config)
              (match (search-path a "claude")
                (Some [_] "claude")
                (_ (match (search-path a "codex")
                     (Some [_] "codex")
                     (_ "builtin")))))
        model
          (cond (= provider "claude") (.claude-model config)
                (= provider "codex") (.codex-model config)
                (= provider "opencode") (.opencode-model config)
                :else (.default-model config))
        cwd (match (os/current-dir a) (Ok [s] (slice s)) (_ ""))]
    (input-set-text! (index (field w settings) 0) cwd)
    (input-set-text! (index (field w settings) 1) provider)
    (input-set-text! (index (field w settings) 2) model))
  (let [pa (snap-spare (field w profiles))
        doc (session/read-doc pa (session/cat pa [home "/connections.json"]))]
    (snap-commit! (field w profiles) doc 0))
  0)

(defn value [(w (ptr Workbench)) (i i64)] (-> (slice u8))
  (input-text (index (field w settings) i)))

(defn connection-value [(w (ptr Workbench)) (i i64)] (-> (slice u8))
  (input-text (index (field w connection) i)))
