(module factory.ui.personal)
(import "coil.alloc" :use *)
(import "coil.slice" :use *)
(import "coil.arraylist" :use *)
(import "coil.serde.value" :use *)
(import "tui.canvas" :use *)
(import "tui.widgets" :use *)
(import "tui.app" :use [Frame])
(import "factory.ui.model" :use *)
(import "factory.ui.fmt" :use *)
(import "factory.ui.chat" :use *)
(import "factory.ui.workbench" :as workbench)

;;; Bearer tokens stay editable without ever placing their contents on screen.
(defn draw-token! [(c (ptr Canvas))
                   (r Rect)
                   (input (ptr TextInput))
                   (a (dyn Allocator))
                   (theme Theme)
                   (focused bool)] (-> i64)
  (let [(mut masked) (text-input-new a false)]
    (for byte (iter (input-text input))
      (push! (mut (.text masked)) (cast u8 42)))
    (set! (.cursor masked) (.cursor input))
    (draw-input! c
                 r
                 (mut masked)
                 (.text theme)
                 "Factory bearer token (SSH can fetch it)"
                 (.subtle theme)
                 focused)
    (text-input-free! (mut masked))))

(defn draw-sidebar! [(d (ptr Dash))
                     (c (ptr Canvas))
                     (a (dyn Allocator))
                     (r Rect)] (-> i64)
  (let [w (field d workbench)
        theme (.theme d)
        inner
          (rect-inset-xy (draw-box! c
                                    r
                                    (panel-opts theme
                                                "Workspace"
                                                (.history-focus w)))
                         1
                         0)
        sessions (.value (field w sessions))
        (mut labels) (ArrayList::new [(slice u8)] a)]
    (put-text-ellipsis! c
                        inner
                        (.x inner)
                        (.y inner)
                        "ctrl-n  New conversation"
                        (bold (.accent theme)))
    (put-text-ellipsis! c
                        inner
                        (.x inner)
                        (+ (.y inner) 2)
                        "ctrl-f  Factory activity"
                        (.text theme))
    (put-text-ellipsis! c
                        inner
                        (.x inner)
                        (+ (.y inner) 3)
                        (concat a
                                [(if (.connected w) "● " "○ ")
                                 (.connection-name w)])
                        (if (.connected w) (.success theme) (.muted theme)))
    (put-text-ellipsis! c
                        inner
                        (.x inner)
                        (+ (.y inner) 4)
                        (if (.starting w)
                            "Connecting to factory…"
                            (if (.connected w)
                                (concat a
                                        [(int-text a
                                                   (running-count (overview-runs d)))
                                         " running · "
                                         (int-text a
                                                   (needs-you-count (overview-runs d)))
                                         " need you"])
                                "Not connected"))
                        (.muted theme))
    (put-text-ellipsis! c
                        inner
                        (.x inner)
                        (+ (.y inner) 5)
                        "ctrl-k  Connections"
                        (.accent-alt theme))
    (put-text-ellipsis! c
                        inner
                        (.x inner)
                        (+ (.y inner) 7)
                        "CONVERSATIONS · ctrl-b"
                        (.subtle theme))
    (for i (range 0 (jv-len sessions))
      (let [item (jv-nth sessions i)]
        (push! (mut labels)
               (concat a
                       [(if (= (js item "status") "running") "⟳ " "· ")
                        (js item "title")]))))
    (list-set-count! (field w history) (len labels))
    (draw-list! c
                (rect-drop-top inner 9)
                (field w history)
                (slice labels)
                theme
                (.history-focus w))
    0))

(defn draw-personal! [(d (ptr Dash)) (frame (ptr Frame))] (-> i64)
  (let [c (.canvas frame)
        a (.scratch frame)
        theme (.theme d)
        w (field d workbench)
        current (.value (field w current))
        existing (> (len (.session-id w)) 0)
        provider (if existing (js current "harness") (workbench/value w 1))
        model (if existing (js current "model") (workbench/value w 2))
        chat (field d personal)
        full (canvas-rect c)
        sidebar (if (>= (.w full) 70) (if (>= (.w full) 110) 30 23) 0)
        body (rect-drop-top (rect-drop-bottom full 1) 2)
        left (rect (.x body) (.y body) sidebar (.h body))
        right (rect-drop-left body sidebar)
        inner
          (rect-inset-xy (draw-box! c
                                    right
                                    (panel-opts theme
                                                "Conversation"
                                                (not (.history-focus w))))
                         1
                         0)
        input-height
          (let [want (input-visual-rows (field chat input) (- (.w inner) 3))]
            (if (> want 5) 5 want))
        input-r
          (rect (.x inner)
                (- (rect-bottom inner) input-height)
                (.w inner)
                input-height)
        status-y (- (.y input-r) 2)
        messages-r
          (rect (.x inner)
                (.y inner)
                (.w inner)
                (if (> status-y (.y inner)) (- status-y (.y inner)) 0))
        lines (chat-lines chat (.w messages-r))]
    (put-text! c full 1 0 "◆ factory" (bold (.accent theme)))
    (put-text-ellipsis! c
                        (rect 13 0 (- (.w full) 13) 1)
                        13
                        0
                        (concat a
                                [provider
                                 " · "
                                 (if (= (len model) 0)
                                     "CLI default model"
                                     model)
                                 " · "
                                 (.status w)])
                        (.muted theme))
    (put-text-ellipsis! c
                        (rect 1 1 (- (.w full) 2) 1)
                        1
                        1
                        (if existing
                            (js current "workdir")
                            (workbench/value w 0))
                        (.subtle theme))
    (when (> sidebar 0) (draw-sidebar! d c a left))
    (if (= (len lines) 0)
        (do
          (put-text-ellipsis! c
                              messages-r
                              (+ (.x messages-r) 2)
                              (+ (.y messages-r) 2)
                              "What would you like to work on?"
                              (bold (.text theme)))
          (put-text-ellipsis! c
                              messages-r
                              (+ (.x messages-r) 2)
                              (+ (.y messages-r) 4)
                              "Start typing. Your conversation works without a factory connection."
                              (.muted theme))
          (put-text-ellipsis! c
                              messages-r
                              (+ (.x messages-r) 2)
                              (+ (.y messages-r) 6)
                              "ctrl-g chooses harness, model and project. ctrl-f opens your factories."
                              (.subtle theme)))
        (draw-lines! c messages-r (field chat sv) lines theme))
    (put-text-ellipsis! c
                        inner
                        (.x inner)
                        status-y
                        (cond (= (.status w) "running")
                                "⟳ Working · send another message to steer · ctrl-x cancels"
                              (= (.status w) "failed")
                                (js (.value (field w current)) "error")
                              (= (.status w) "cancelled")
                                "Stopped · send a message to continue"
                              (= (.status w) "interrupted")
                                "Interrupted · send a message to resume the saved session"
                              :else
                                "Your project · no factory recipe or gate required")
                        (if (= (.status w) "failed")
                            (.error theme)
                            (.muted theme)))
    (draw-box-divider! c
                       right
                       (- (.y input-r) 1)
                       (Rounded)
                       (.border-focus theme))
    (put-text! c input-r (.x input-r) (.y input-r) "❯" (bold (.accent theme)))
    (draw-input! c
                 (rect-drop-left input-r 2)
                 (field chat input)
                 (.text theme)
                 "Ask anything…"
                 (.subtle theme)
                 (not (or (.history-focus w)
                          (.settings-open w)
                          (.connections-open w)
                          (.commands-open d))))
    (draw-footer! d
                  c
                  (rect 0 (- (.h full) 1) (.w full) 1)
                  [(KeyHint :key "enter" :label "send")
                   (KeyHint :key "ctrl-f" :label "factory")
                   (KeyHint :key "ctrl-n" :label "new")
                   (KeyHint :key "ctrl-g" :label "settings")
                   (KeyHint :key "ctrl-p" :label "commands")])
    0))

(defn draw-settings! [(d (ptr Dash)) (c (ptr Canvas))] (-> i64)
  (let [w (field d workbench)
        theme (.theme d)
        r (rect-center (canvas-rect c) 86 13)
        (mut opts) (panel-opts theme "New conversation settings" true)]
    (canvas-hide-cursor! c)
    (fill! c r 32 (style-default))
    (set! (.footer opts)
          "tab next · enter apply to new conversation · esc close")
    (let [inner (rect-inset-xy (draw-box! c r opts) 1 1)]
      (for i (range 0 3)
        (let [y (+ (.y inner) (* i 2))]
          (put-text-ellipsis! c
                              (rect (.x inner) y 13 1)
                              (.x inner)
                              y
                              (get ["Project" "Harness" "Model"] i)
                              (.muted theme))
          (draw-input! c
                       (rect (+ (.x inner) 14) y (- (.w inner) 14) 1)
                       (index (field w settings) i)
                       (.text theme)
                       (get ["Project directory"
                             "claude, codex, builtin, opencode"
                             "Empty uses the CLI default (Claude / Codex)"]
                            i)
                       (.subtle theme)
                       (= (.settings-focus w) i))))
      0)))

(defn draw-connections! [(d (ptr Dash)) (c (ptr Canvas)) (a (dyn Allocator))]
  (-> i64)
  (let [w (field d workbench)
        theme (.theme d)
        r (rect-center (canvas-rect c) 90 22)
        (mut opts) (panel-opts theme "Factory connections" true)]
    (canvas-hide-cursor! c)
    (fill! c r 32 (style-default))
    (set! (.footer opts)
          "tab fields/saved · enter connect · ctrl-l local · ctrl-r start SSH")
    (let [inner (rect-inset-xy (draw-box! c r opts) 1 0)]
      (put-text-ellipsis! c
                          inner
                          (.x inner)
                          (.y inner)
                          (concat a
                                  [(if (.connected w)
                                       "Connected: "
                                       "Selected: ")
                                   (.connection-name w)
                                   " · "
                                   (if (= (cast i64 (.active-connection w)) 0)
                                       (.base-url (.hub d))
                                       (.address (.active-connection w)))])
                          (.accent theme))
      (for i (range 0 3)
        (let [y (+ (.y inner) (+ 2 (* i 2)))]
          (put-text-ellipsis! c
                              (rect (.x inner) y 13 1)
                              (.x inner)
                              y
                              (get ["Address" "Token" "Name"] i)
                              (.muted theme))
          (if (= i 1)
              (draw-token! c
                           (rect (+ (.x inner) 14) y (- (.w inner) 14) 1)
                           (index (field w connection) i)
                           a
                           theme
                           (= (.connection-focus w) i))
              (draw-input! c
                           (rect (+ (.x inner) 14) y (- (.w inner) 14) 1)
                           (index (field w connection) i)
                           (.text theme)
                           (get ["ssh://user@host or https://factory.example"
                                 "Factory bearer token (SSH can fetch it)"
                                 "A name for this computer"]
                                i)
                           (.subtle theme)
                           (= (.connection-focus w) i)))))
      (put-text-ellipsis! c
                          inner
                          (.x inner)
                          (+ (.y inner) 9)
                          "Saved connections · tab here, select, enter"
                          (.subtle theme))
      (let [profiles (.value (field w profiles))
            (mut labels) (ArrayList::new [(slice u8)] a)]
        (for i (range 0 (jv-len profiles))
          (let [item (jv-nth profiles i)]
            (push! (mut labels)
                   (concat a [(js item "name") "  " (js item "url")]))))
        (draw-list! c
                    (rect-drop-top inner 10)
                    (field w profile-list)
                    (slice labels)
                    theme
                    (= (.connection-focus w) 3)))
      0)))
