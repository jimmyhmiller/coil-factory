;;; The `factory` dashboard: an event loop over `factory.ui.model/Dash`. Every
;;; request happens here, in the event handler, never while drawing; each
;;; view reads only what the last successful fetch left in the model.
(defn wall-now [] (-> i64)
  (match (time/wall-now-ms)
    (Ok [ms] ms)
    (Err [e] 0)))

;; ---------------------------------------------------------------------------
;; Requests
(defn io-allocator [(d (ptr Dash))] (-> (dyn Allocator))
  (recycle! (field d io))
  (allocator (field d io)))

;;; One request to the hub, recording whether the hub answered at all.
(defn request! [(d (ptr Dash))
                (a (dyn Allocator))
                (method (slice u8))
                (path (slice u8))
                (body (slice u8))] (-> Reply)
  (let [reply (hub-call a (.hub d) method path body 5000)]
    (match reply
      (ReplyFailed [message]
                   (do
                     (set! (.connected (field d workbench)) false)
                     (own! d
                           (field d hub-error)
                           (concat a [message " (" (.base-url (.hub d)) ")"]))))
      (ReplyOk [status value text]
               (do
                 (own! d (field d hub-error) "")
                 (set! (.hub-ok-t d) (.now d))
                 (set! (.connected (field d workbench)) (reply-ok? reply))
                 0)))
    reply))

;;; An API error (the hub answered, but not 2xx) becomes a toast.
(defn complain! [(d (ptr Dash)) (a (dyn Allocator)) (reply Reply)] (-> i64)
  (match reply
    (ReplyOk [status value text] (toast! d (reply-error a reply) (ToneError)))
    (ReplyFailed [message] 0)))

(defn run-path [(a (dyn Allocator)) (run (slice u8)) (suffix (slice u8))]
  (-> (slice u8))
  (concat a ["/v1/runs/" run suffix]))

(defn fetch-overview! [(d (ptr Dash))] (-> i64)
  (set! (.polled-overview-t d) (.now d))
  (let [a (snap-spare (field d overview))
        reply (request! d a "GET" "/v1/overview" "")]
    (if (reply-ok? reply)
        (do
          (snap-commit! (field d overview) (reply-body reply) (.now d))
          (sync-selection! d))
        (complain! d a reply))))

(defn fetch-run! [(d (ptr Dash))] (-> i64)
  (set! (.polled-run-t d) (.now d))
  (let [a (snap-spare (field d run))
        reply (request! d a "GET" (run-path a (.run-id d) "") "")]
    (if (reply-ok? reply)
        (let [doc (reply-body reply)
              id (js doc "id")
              first (not (.has (field d run)))]
          (snap-commit! (field d run) doc (.now d))
          (run-loaded! d first)
          ;; A prefix given on the command line becomes the full id.
          (when (not (= id (.run-id d))) (own! d (field d run-id) id))
          (let [chat (field d chat)]
            (when (and (> (len (.run chat)) 0) (not (= (.run chat) id)))
              (let [old (.run chat)]
                (set! (.run chat) (copy-bytes (.allocator d) id))
                (free [u8] (.allocator d) old)))
            (chat-sync-pending! chat doc))
          0)
        (match reply
          (ReplyOk [status value text]
                   (do
                     (toast! d (reply-error a reply) (ToneError))
                     (when (= status 404)
                       (set! (.view d) (ViewOverview))
                       (fetch-overview! d))
                     0))
          (ReplyFailed [m] 0)))))

(defn fetch-feed! [(d (ptr Dash))] (-> i64)
  (set! (.polled-events-t d) (.now d))
  (let [feed (field d feed)
        (mut pages) 0]
    (loop (let [a (io-allocator d)
                path
                  (if (.loaded feed)
                      (run-path a
                                (.run-id d)
                                (concat a
                                        ["/events?after="
                                         (int-text a (.cursor feed))
                                         "&limit=500"]))
                      (run-path a (.run-id d) "/events?tail=300"))
                reply (request! d a "GET" path "")]
            (if (reply-ok? reply)
                (let [n (feed-ingest-page! feed (reply-body reply))]
                  (set! pages (+ (load pages) 1))
                  (when (or (< n 500) (>= (load pages) 4)) (break)))
                (do (complain! d a reply) (break)))))
    0))

;;; Fetch the agent document; returns true when an exact transcript was adopted
;;; and the overlay must be reread from the chat's cursor.
(defn fetch-transcript! [(d (ptr Dash))] (-> bool)
  (let [chat (field d chat)
        ta (snap-spare (field chat transcript))
        reply
          (request! d
                    ta
                    "GET"
                    (run-path ta
                              (.run chat)
                              (concat ta ["/agents/" (.agent chat)]))
                    "")]
    (if (reply-ok? reply)
        (chat-adopt-transcript! chat (reply-body reply) (.now d))
        (do (complain! d ta reply) false))))

;;; Read the journal after the chat's cursor, a few pages at most per poll.
(defn fetch-chat-events! [(d (ptr Dash))] (-> i64)
  (let [chat (field d chat)
        (mut pages) 0]
    (loop (let [a (io-allocator d)
                reply
                  (request! d
                            a
                            "GET"
                            (run-path a
                                      (.run chat)
                                      (concat a
                                              ["/events?after="
                                               (int-text a (.cursor chat))
                                               "&limit=500"]))
                            "")]
            (if (reply-ok? reply)
                (let [n (chat-ingest-page! chat (reply-body reply))]
                  (set! pages (+ (load pages) 1))
                  (when (or (< n 500) (>= (load pages) 4)) (break)))
                (do (complain! d a reply) (break)))))
    0))

;;; Keep the chat current. The transcript comes first: when it reports the
;;; journal cursor it reflects, the chat shows exactly the transcript plus the
;;; records from that cursor on. Sites without a cursor fall back to reading
;;; the tail and treating turn and station records as checkpoints.
(defn fetch-chat! [(d (ptr Dash))] (-> i64)
  (set! (.polled-events-t d) (.now d))
  (let [chat (field d chat)]
    (when (not (.loaded chat))
      (fetch-transcript! d))
    (if (.loaded chat)
        (fetch-chat-events! d)
        (let [a (io-allocator d)
              reply
                (request! d
                          a
                          "GET"
                          (run-path a (.run chat) "/events?tail=400")
                          "")]
          (if (reply-ok? reply)
              (chat-start-from-tail! chat (reply-body reply))
              (complain! d a reply))))
    (when (.needs-transcript chat)
      (when (fetch-transcript! d) (fetch-chat-events! d)))
    0))

;;; Refresh whatever the current view shows, at most once a second (events
;;; twice a second).
(defn poll! [(d (ptr Dash))] (-> i64)
  (poll-network! d)
  (poll-models! d)
  (project-actions/poll! d)
  (poll-personal! d)
  (poll-sidebar! d)
  (let [now (.now d)]
    (match (.view d)
      (ViewPersonal [] (refresh-factory-background! d))
      (ViewOverview [] (refresh-factory-background! d))
      (ViewRun []
               (do
                 (when (>= (- now (.polled-run-t d)) 1000) (fetch-run! d))
                 (when (>= (- now (.polled-events-t d)) 500) (fetch-feed! d))
                 0))
      (ViewChat []
                (do
                  (when (>= (- now (.polled-run-t d)) 1000) (fetch-run! d))
                  (when (>= (- now (.polled-events-t d)) 500) (fetch-chat! d))
                  0)))
    0))

;; ---------------------------------------------------------------------------
;; Navigation
(defn open-run! [(d (ptr Dash)) (id (slice u8))] (-> i64)
  (when (not (= id (.run-id d)))
    (own! d (field d run-id) id)
    (snap-reset! (field d run))
    (feed-reset! (field d feed))
    (set! (.feed-sv d) (scroll-view-new))
    (set! (.agents-lv d) (list-view-new)))
  (set! (.feed-focus d) false)
  (set! (.view d) (ViewRun))
  (fetch-run! d)
  (fetch-feed! d))

(defn open-chat! [(d (ptr Dash))
                  (run (slice u8))
                  (agent (slice u8))
                  (from-run bool)] (-> i64)
  (if (= (len agent) 0)
      (toast! d "this run has no agent yet" (ToneWarning))
      (do
        (when (not (= run (.run-id d)))
          (own! d (field d run-id) run)
          (snap-reset! (field d run))
          (feed-reset! (field d feed))
          (set! (.feed-sv d) (scroll-view-new))
          (set! (.agents-lv d) (list-view-new)))
        (let [chat (field d chat)]
          (when (or (not (= (.run chat) (.run-id d)))
                    (not (= (.agent chat) agent)))
            (chat-open! chat (.run-id d) agent)
            (snap-reset! (field (field d workbench) sidebar))
            (set! (.sidebar-polled (.workbench d)) 0)
            (set! (.sidebar-sv (.workbench d)) (scroll-view-new))
            (tree-free! (field d inspection))
            (set! (.inspection d) (tree-new (.allocator d)))))
        (set! (.chat-from-run d) from-run)
        (set! (.view d) (ViewChat))
        (fetch-run! d)
        (fetch-chat! d))))

(defn back! [(d (ptr Dash))] (-> i64)
  (match (.view d)
    (ViewPersonal [] 0)
    (ViewChat []
              (if (.chat-from-run d)
                  (open-run! d (.run-id d))
                  (do (set! (.view d) (ViewOverview)) (fetch-overview! d))))
    (ViewRun [] (do (set! (.view d) (ViewOverview)) (fetch-overview! d)))
    (ViewOverview [] 0)))

;;; The run the current view is about.
(defn focused-run [(d (ptr Dash))] (-> JVal)
  (match (.view d)
    (ViewPersonal [] (JNull))
    (ViewOverview [] (selected-run d))
    (_ (.value (field d run)))))

(defn after-action! [(d (ptr Dash))] (-> i64)
  (set! (.polled-overview-t d) 0)
  (set! (.polled-run-t d) 0)
  (poll! d))

(defn post-run! [(d (ptr Dash))
                 (id (slice u8))
                 (action (slice u8))
                 (done (slice u8))] (-> i64)
  (let [a (io-allocator d)
        reply (request! d a "POST" (run-path a id (concat a ["/" action])) "{}")]
    (if (reply-ok? reply)
        (toast! d (concat a [done " " id]) (ToneSuccess))
        (complain! d a reply))
    (after-action! d)))

(defn pause-or-resume! [(d (ptr Dash))] (-> i64)
  (let [run (focused-run d)
        id (js run "id")
        status (js run "status")
        a (io-allocator d)]
    (cond (= (len id) 0) 0
          (= status "running") (post-run! d id "pause" "paused")
          (or (= status "paused") (= status "lost") (= status "failed"))
            (post-run! d id "resume" "resumed")
          (= status "blocked")
            (toast! d
                    (concat a
                            [id
                             " is blocked — answer its agent in chat (c) to resume it"])
                    (ToneWarning))
          :else
            (toast! d
                    (concat a [id " is " status "; nothing to pause"])
                    (ToneMuted)))))

(defn ask-stop! [(d (ptr Dash))] (-> i64)
  (let [run (focused-run d)
        id (js run "id")
        status (js run "status")]
    (cond (= (len id) 0) 0
          (finished-status? status)
            (toast! d
                    (concat (io-allocator d) [id " is already " status])
                    (ToneMuted))
          :else
            (do
              (own! d (field d confirm-run) id)
              (set! (.confirm-stop d) true)
              0))))

(defn send! [(d (ptr Dash))] (-> i64)
  (let [chat (field d chat)
        text (trim (input-text (field chat input)))]
    (if (= (len text) 0)
        0
        (let [a (io-allocator d)
              body (jv-object a)]
          (jv-put! body "text" (JStr text))
          (let [reply
                  (request! d
                            a
                            "POST"
                            (run-path a
                                      (.run chat)
                                      (concat a
                                              ["/agents/"
                                               (.agent chat)
                                               "/messages"]))
                            (jv-encode a body))]
            (if (reply-ok? reply)
                (do
                  (chat-add-local! chat
                                   (ji (reply-body reply) "ref")
                                   text
                                   (.now d))
                  (input-submit! (field chat input) a)
                  (scroll-to-bottom! (field chat sv))
                  (after-action! d))
                (complain! d a reply)))))))

;; ---------------------------------------------------------------------------
;; Keys
(defn overview-key! [(d (ptr Dash)) (key Key)] (-> AppFlow)
  (match key
    (Char [ch]
          (cond (= ch #\n) (do (set! (.launch-open d) true) (Continue))
                (= ch #\q) (Quit)
                (= ch #\?) (do (set! (.help d) true) (Continue))
                (= ch #\c)
                  (let [run (selected-run d)]
                    (open-chat! d (js run "id") (default-agent run) false)
                    (Continue))
                (= ch #\p) (do (pause-or-resume! d) (Continue))
                (= ch #\x) (do (ask-stop! d) (Continue))
                (= ch #\r) (do (fetch-overview! d) (Continue))
                (= ch #\j)
                  (do
                    (list-move! (field d runs-lv) 1)
                    (sync-selection-id! d)
                    (Continue))
                (= ch #\k)
                  (do
                    (list-move! (field d runs-lv) -1)
                    (sync-selection-id! d)
                    (Continue))
                :else (Continue)))
    (Enter []
           (let [id (js (selected-run d) "id")]
             (when (> (len id) 0) (open-run! d id))
             (Continue)))
    (_ (do
         (when (list-handle-key! (field d runs-lv) key 10)
           (sync-selection-id! d))
         (Continue)))))

(defn sync-selection-id! [(d (ptr Dash))] (-> i64)
  (own! d (field d selected-id) (js (selected-run d) "id")))

(defn selected-agent [(d (ptr Dash))] (-> (slice u8))
  (let [run (.value (field d run))
        agents (jv-get run "agents")]
    (if (> (jv-len agents) 0)
        (js (jv-nth agents (.selected (.agents-lv d))) "name")
        (default-agent run))))

(defn run-key! [(d (ptr Dash)) (key Key)] (-> AppFlow)
  (let [sv (field d feed-sv)]
    (match key
      (Escape [] (do (back! d) (Continue)))
      (Char [ch]
            (cond (= ch #\q) (Quit)
                  (= ch #\?) (do (set! (.help d) true) (Continue))
                  (= ch #\c)
                    (do
                      (open-chat! d (.run-id d) (selected-agent d) true)
                      (Continue))
                  (= ch #\p) (do (pause-or-resume! d) (Continue))
                  (= ch #\x) (do (ask-stop! d) (Continue))
                  :else (Continue)))
      (Enter []
             (do (open-chat! d (.run-id d) (selected-agent d) true) (Continue)))
      (Tab [] (do (set! (.feed-focus d) (not (.feed-focus d))) (Continue)))
      (BackTab [] (do (set! (.feed-focus d) (not (.feed-focus d))) (Continue)))
      (PageUp []
              (do
                (scroll-up! sv (if (> (.height sv) 2) (- (.height sv) 1) 1))
                (Continue)))
      (PageDown []
                (do
                  (scroll-down! sv (if (> (.height sv) 2) (- (.height sv) 1) 1))
                  (Continue)))
      (Home [] (do (scroll-to-top! sv) (Continue)))
      (End [] (do (scroll-to-bottom! sv) (Continue)))
      (Up []
          (do
            (if (.feed-focus d)
                (scroll-up! sv 1)
                (list-move! (field d agents-lv) -1))
            (Continue)))
      (Down []
            (do
              (if (.feed-focus d)
                  (scroll-down! sv 1)
                  (list-move! (field d agents-lv) 1))
              (Continue)))
      (_ (Continue)))))

(defn chat-key! [(d (ptr Dash)) (key Key)] (-> AppFlow)
  (let [chat (field d chat)]
    (match key
      (Escape []
              (do
                (if (= (js (.value (field d run)) "status") "running")
                    (post-run! d (.run chat) "pause" "interrupted")
                    0)
                (Continue)))
      (PageUp []
              (do
                (scroll-up! (field chat sv)
                            (if (> (.height (.sv chat)) 2)
                                (- (.height (.sv chat)) 1)
                                1))
                (Continue)))
      (PageDown []
                (do
                  (scroll-down! (field chat sv)
                                (if (> (.height (.sv chat)) 2)
                                    (- (.height (.sv chat)) 1)
                                    1))
                  (Continue)))
      (Ctrl [l]
            (if (= l #\o)
                (do (set! (.inspection-open d) true) (Continue))
                (if (= l #\t)
                    (do (set! (.details chat) (not (.details chat))) (Continue))
                    (do (input-handle-key! (field chat input) key) (Continue)))))
      (_ (match (input-handle-key! (field chat input) key)
           (InputSubmitted [] (do (send! d) (Continue)))
           (_ (Continue)))))))

;;; Build commands from current state at use time, so actions cannot retain a
;;; stale run or agent across refreshes. IDs are stable, independent of filtering.
(defn focused-agent [(d (ptr Dash))] (-> (slice u8))
  (match (.view d)
    (ViewPersonal [] "")
    (ViewChat [] (.agent (.chat d)))
    (ViewRun [] (selected-agent d))
    (ViewOverview [] (default-agent (selected-run d)))))

(defn command-name [(id i64)] (-> (slice u8))
  (if (and (> id 0) (<= id 26))
      (get ["factory"
            "open"
            "agent"
            "pause"
            "resume-run"
            "stop"
            "help"
            "quit"
            "run"
            "inspect"
            "new"
            "chat"
            "settings"
            "connect"
            "local"
            "resume"
            "cancel"
            "details"
            "remote"
            "start"
            "confirm"
            "dismiss"
            ""
            ""
            "model"
            "sidebars"]
           (- id 1))
      ""))

(defn command-shortcut [(id i64)] (-> (slice u8))
  (if (and (> id 0) (<= id 26))
      (get ["Ctrl-F"
            "Enter"
            "c"
            "p"
            "p"
            "x"
            "?"
            "Ctrl-C"
            "n · Ctrl-S submits"
            "Ctrl-O"
            "Ctrl-N"
            "Ctrl-F"
            "Ctrl-G"
            ""
            "Ctrl-L in connections"
            "Ctrl-B"
            "Ctrl-X"
            "Ctrl-T"
            "Ctrl-R in connections"
            "Ctrl-S"
            "y"
            "Esc"
            ""
            ""
            ""
            ""]
           (- id 1))
      ""))

(defn command-label [(a (dyn Allocator)) (id i64)] (-> (slice u8))
  (let [shortcut (command-shortcut id)]
    (concat a
            ["/"
             (command-name id)
             (if (= (len shortcut) 0) "" (concat a [" · " shortcut]))])))

(defn dashboard-commands [(d (ptr Dash)) (a (dyn Allocator))]
  (-> (ArrayList Command))
  (let [(mut commands) (ArrayList::new [Command] a)
        run (focused-run d)
        id (js run "id")
        status (js run "status")]
    (for command (iter [(Command
                          :id 1
                          :title "Factory overview"
                          :detail "Every site and run"
                          :enabled true)
                        (Command
                          :id 2
                          :title "Open selected run"
                          :detail id
                          :enabled (> (len id) 0))
                        (Command
                          :id 3
                          :title "Chat with agent"
                          :detail id
                          :enabled (> (len (focused-agent d)) 0))
                        (Command
                          :id 4
                          :title "Pause run"
                          :detail id
                          :enabled (= status "running"))
                        (Command
                          :id 5
                          :title "Resume run"
                          :detail id
                          :enabled
                            (or (= status "paused")
                                (= status "lost")
                                (= status "failed")))
                        (Command
                          :id 6
                          :title "Stop run…"
                          :detail id
                          :enabled
                            (and (> (len id) 0) (not (finished-status? status))))
                        (Command
                          :id 7
                          :title "Browse commands"
                          :detail "Available actions"
                          :enabled true)
                        (Command
                          :id 8
                          :title "Quit"
                          :detail "Leave the dashboard"
                          :enabled true)
                        (Command
                          :id 9
                          :title "New factory run"
                          :detail "Choose factory, harness, model and site"
                          :enabled true)
                        (Command
                          :id 10
                          :title "Inspect tool calls"
                          :detail "Expand arguments, results and delegated work"
                          :enabled
                            (match (.view d)
                              (ViewChat [] true)
                              (ViewPersonal []
                                            (> (len (.session-id (.workbench d)))
                                               0))
                              (_ false)))
                        (Command
                          :id 11
                          :title "New conversation"
                          :detail "Work in your project without a factory"
                          :enabled true)
                        (Command
                          :id 12
                          :title "Return to conversation"
                          :detail "Keep your conversation and draft"
                          :enabled true)
                        (Command
                          :id 13
                          :title "Conversation settings"
                          :detail "Project, harness and model"
                          :enabled true)
                        (Command
                          :id 14
                          :title "Factory connections"
                          :detail "Local, HTTP or SSH factories"
                          :enabled true)
                        (Command
                          :id 15
                          :title "Start local factory"
                          :detail "Start and connect this computer"
                          :enabled true)
                        (Command
                          :id 16
                          :title "Resume conversation"
                          :detail "Choose a conversation"
                          :enabled true)
                        (Command
                          :id 17
                          :title "Cancel personal turn"
                          :detail "Stop the assistant"
                          :enabled (> (len (.session-id (.workbench d))) 0))
                        (Command
                          :id 18
                          :title "Toggle conversation details"
                          :detail "Tool output and reasoning"
                          :enabled
                            (match (.view d)
                              (ViewPersonal [] true)
                              (ViewChat [] true)
                              (_ false)))
                        (Command
                          :id 19
                          :title "Start SSH factory"
                          :detail "Start and connect a remote computer"
                          :enabled true)
                        (Command
                          :id 20
                          :title "Submit factory run"
                          :detail "Start the composed run"
                          :enabled (.launch-open d))
                        (Command
                          :id 21
                          :title "Confirm stop"
                          :detail "Cancel this run's agents"
                          :enabled (.confirm-stop d))
                        (Command
                          :id 22
                          :title "Keep running"
                          :detail "Dismiss stop confirmation"
                          :enabled (.confirm-stop d))
                        (Command
                          :id 25
                          :title "Choose model"
                          :detail
                            "Switch model and harness in this conversation"
                          :enabled
                            (match (.view d) (ViewPersonal [] true) (_ false)))
                        (Command
                          :id 26
                          :title "Configure sidebars"
                          :detail "--hide, --show, --toggle left|right|all"
                          :enabled true)])
      (push! (mut commands)
             (Command
               :id (.id command)
               :title
                 (concat a
                         ["/"
                          (command-name (.id command))
                          "  "
                          (.title command)])
               :detail (.detail command)
               :enabled (.enabled command))))
    (push! (mut commands)
           (Command
             :id 16
             :title "/history  Saved conversations"
             :detail "Choose a conversation"
             :enabled true))
    (load commands)))

(defn command-selected! [(d (ptr Dash)) (id i64)] (-> AppFlow)
  (set! (.commands-open d) false)
  (when (or (= id 1)
            (= id 2)
            (= id 3)
            (= id 7)
            (= id 9)
            (= id 10)
            (= id 11)
            (= id 12)
            (= id 13)
            (= id 14)
            (= id 16)
            (= id 19)
            (= id 25)
            (= id 26))
    (set! (.settings-open (.workbench d)) false)
    (set! (.connections-open (.workbench d)) false)
    (set! (.inspection-open d) false)
    (set! (.launch-open d) false)
    (set! (.help d) false)
    (set! (.confirm-stop d) false)
    (set! (.sidebar-focus (.workbench d)) false)
    0)
  (toast! d
          (command-label (.allocator d) id)
          (ToneMuted))
  (cond (= id 1)
          (do
            (set! (.view d) (ViewOverview))
            (refresh-factory-background! d)
            (Continue))
        (= id 2) (do (open-run! d (js (focused-run d) "id")) (Continue))
        (= id 3)
          (let [run (focused-run d)]
            (open-chat! d (js run "id") (focused-agent d) true)
            (Continue))
        (or (= id 4) (= id 5)) (do (pause-or-resume! d) (Continue))
        (= id 6) (do (ask-stop! d) (Continue))
        (= id 7) (open-slash! d "")
        (= id 8) (Quit)
        (= id 9) (do (set! (.launch-open d) true) (Continue))
        (= id 10) (do (set! (.inspection-open d) true) (Continue))
        (= id 11) (do (new-personal! d) (Continue))
        (= id 12) (do (set! (.view d) (ViewPersonal)) (Continue))
        (= id 13)
          (do (set! (.settings-open (field d workbench)) true) (Continue))
        (= id 14)
          (do (set! (.connections-open (field d workbench)) true) (Continue))
        (= id 15) (do (connect! d 3) (Continue))
        (= id 16)
          (do
            (set! (.view d) (ViewPersonal))
            (set! (.history-focus (.workbench d)) true)
            (Continue))
        (= id 17)
          (do
            (session/cancel! (.allocator d)
                             (.home (.workbench d))
                             (.session-id (.workbench d)))
            (Continue))
        (= id 18)
          (do
            (match (.view d)
              (ViewPersonal []
                            (set! (.details (.personal d))
                                  (not (.details (.personal d)))))
              (_ (set! (.details (.chat d)) (not (.details (.chat d))))))
            (Continue))
        (= id 19)
          (do
            (if (starts-with (workbench/connection-value (field d workbench) 0)
                             "ssh://")
                (connect! d 4)
                (set! (.connections-open (.workbench d)) true))
            (Continue))
        (= id 20) (do (submit-launch! d) (Continue))
        (= id 21)
          (do
            (when (.confirm-stop d)
              (set! (.confirm-stop d) false)
              (post-run! d (.confirm-run d) "cancel" "stopped")
              0)
            (Continue))
        (= id 22) (do (set! (.confirm-stop d) false) (Continue))
        (= id 25)
          (do
            (open-models! d)
            (Continue))
        (= id 26) (open-slash! d "sidebars ")
        :else (Continue)))

(defn submit-launch! [(d (ptr Dash))] (-> i64)
  (let [form (field d launch)
        problem (launch-problem form)]
    (if (> (len problem) 0)
        (toast! d problem (ToneWarning))
        (if (not (.connected (.workbench d)))
            (let [w (field d workbench)]
              (if (= (.connection-name w) "Local factory")
                  (do (set! (.auto-submit w) true) (connect! d 3))
                  (do
                    (set! (.connections-open w) true)
                    (toast! d
                            "Connect this factory before starting the run."
                            (ToneWarning)))))
            (let [a (io-allocator d)
                  reply
                    (request! d
                              a
                              "POST"
                              "/v1/runs"
                              (jv-encode a (launch-body a form)))]
              (if (reply-ok? reply)
                  (let [id (js (reply-body reply) "id")]
                    (if (= (len id) 0)
                        (toast! d
                                "The site accepted the run but returned no run id; check the overview before retrying."
                                (ToneWarning))
                        (do
                          (set! (.launch-open d) false)
                          (open-run! d id))))
                  (complain! d a reply)))))))

(defn slash-available? [(d (ptr Dash))] (-> bool)
  (and (not (or (.models-open (.workbench d))
                (.settings-open (.workbench d))
                (.action-editor (.workbench d))
                (.connections-open (.workbench d))
                (.inspection-open d)
                (.launch-open d)
                (.help d)))
       (or (.confirm-stop d)
           (.sidebar-focus (.workbench d))
           (match (.view d)
             (ViewPersonal []
                           (= (len (input-text (field (field d personal) input)))
                              0))
             (ViewChat [] (= (len (input-text (field (field d chat) input))) 0))
             (_ true)))))

(defn open-slash! [(d (ptr Dash)) (query (slice u8))] (-> AppFlow)
  (palette-reset! (field d commands))
  (input-set-text! (field (field d commands) input) (trim query))
  (set! (.commands-open d) true)
  (Continue))

(defn sidebars-key! [(d (ptr Dash)) (key Key)] (-> AppFlow)
  (let [w (field d workbench)
        p (field d commands)
        input (field p input)
        a (io-allocator d)
        query (input-text input)
        items
          (sidebar-command/suggestions a
                                       (subslice query 0 (.cursor input))
                                       (.workspace-visible w)
                                       (.sidebar-visible w))]
    (list-set-count! (field p list) (len items))
    (match key
      (Escape [] (set! (.commands-open d) false))
      (Up [] (list-move! (field p list) -1))
      (Down [] (list-move! (field p list) 1))
      (PageUp [] (list-move! (field p list) -8))
      (PageDown [] (list-move! (field p list) 8))
      (Tab []
           (when (> (len items) 0)
             (let [item (get items (.selected (.list p)))
                   (mut end) (.cursor input)]
               (loop (when (or (>= (load end) (len query))
                               (sidebar-command/space? (get query (load end))))
                       (break))
                 (set! end (+ (load end) 1)))
               (let [value (.value item)
                     tail (trim (subslice query (load end) (len query)))]
                 (input-set-text! input (concat a [value tail]))
                 (set! (.cursor input) (len value)))
               (list-select! (field p list) 0))))
      (Enter []
             (let [plan (sidebar-command/parse a query)]
               (cond (> (len (.error plan)) 0)
                       (toast! d (.error plan) (ToneError))
                     (or (.help plan)
                         (and (= (.left plan) 0) (= (.right plan) 0)))
                       (do
                         (input-set-text! input
                                          (if (.help plan)
                                              "sidebars --help"
                                              "sidebars "))
                         (list-select! (field p list) 0))
                     :else
                       (let [old-left (.workspace-visible w)
                             old-right (.sidebar-visible w)]
                         (set! (.workspace-visible w)
                               (sidebar-command/visible old-left (.left plan)))
                         (set! (.sidebar-visible w)
                               (sidebar-command/visible old-right (.right plan)))
                         (if (workbench/save-layout! w a)
                             (do
                               (when (not (.workspace-visible w))
                                 (set! (.history-focus w) false))
                               (when (not (.sidebar-visible w))
                                 (set! (.sidebar-focus w) false))
                               (set! (.dragging w) 0)
                               (set! (.commands-open d) false)
                               (toast! d
                                       (concat a
                                               ["Left "
                                                (sidebar-command/state (.workspace-visible w))
                                                " · Right "
                                                (sidebar-command/state (.sidebar-visible w))])
                                       (ToneSuccess)))
                             (do
                               (set! (.workspace-visible w) old-left)
                               (set! (.sidebar-visible w) old-right)
                               (toast! d
                                       "Could not save sidebar visibility."
                                       (ToneError))))))))
      (_ (do (input-handle-key! input key) (list-select! (field p list) 0))))
    (Continue)))

(defn slash-key! [(d (ptr Dash)) (key Key)] (-> AppFlow)
  (block :slash
    (when (sidebar-command/active? (input-text (field (field d commands) input)))
      (return-from :slash (sidebars-key! d key)))
    (let [a (io-allocator d)
          commands (dashboard-commands d a)]
      (match (palette-key! (field d commands) a (slice commands) key)
        (PaletteClose [] (do (set! (.commands-open d) false) (Continue)))
        (PaletteSelected [id] (command-selected! d id))
        (_ (Continue))))))

(defn wheel! [(d (ptr Dash)) (rows i64) (x i64) (y i64)] (-> AppFlow)
  (let [w (field d workbench)
        amount (* rows 3)
        r (.context-r w)]
    (cond (.models-open w) (list-move! (field (field w models) list) amount)
          (.commands-open d) (list-move! (field (field d commands) list) amount)
          (or (.settings-open w)
              (.action-editor w)
              (.connections-open w)
              (.inspection-open d)
              (.launch-open d)
              (.confirm-stop d)
              (.help d))
            0
          :else
            (match (.view d)
              (ViewPersonal []
                            (if (or (.history-focus w)
                                    (rect-contains? (.history-r w) x y))
                                (list-move! (field w history) amount)
                                (scroll-wheel! (if (and (>= x (.x r))
                                                        (< x (+ (.x r) (.w r)))
                                                        (>= y (.y r))
                                                        (< y (+ (.y r) (.h r))))
                                                   (field w sidebar-sv)
                                                   (field (field d personal) sv))
                                               amount)))
              (ViewChat []
                        (scroll-wheel! (if (and (>= x (.x r))
                                                (< x (+ (.x r) (.w r)))
                                                (>= y (.y r))
                                                (< y (+ (.y r) (.h r))))
                                           (field w sidebar-sv)
                                           (field (field d chat) sv))
                                       amount))
              (ViewOverview [] (list-move! (field d runs-lv) amount))
              (ViewRun [] (scroll-wheel! (field d feed-sv) amount)))))
  (Continue))

(defn scroll-wheel! [(sv (ptr ScrollView)) (rows i64)] (-> i64)
  (if (< rows 0) (scroll-up! sv (- 0 rows)) (scroll-down! sv rows)))

(defn drag! [(d (ptr Dash)) (x i64) (release bool)] (-> AppFlow)
  (let [w (field d workbench)
        body (.layout-r w)
        left (if (> (.w (.workspace-r w)) 0) (+ (.w (.workspace-r w)) 4) 0)]
    (when (> (.dragging w) 0)
      (let [want
              (if (= (.dragging w) 1) (- x (.x body)) (- (rect-right body) x))
            minimum (if (= (.dragging w) 1) 16 18)
            maximum
              (if (= (.dragging w) 1)
                  (- (- (.w body) (.w (.context-r w))) 40)
                  (- (- (.w body) left) 40))
            size
              (if (< want minimum) minimum (if (> want maximum) maximum want))]
        (if (= (.dragging w) 1)
            (set! (.workspace-width w) size)
            (set! (.context-width w) size)))
      (when release
        (set! (.dragging w) 0)
        (when (not (workbench/save-layout! w (io-allocator d)))
          (toast! d "Could not save sidebar widths." (ToneError)))))
    (Continue)))

(defn divider! [(d (ptr Dash)) (x i64) (y i64)] (-> bool)
  (let [w (field d workbench)
        body (.layout-r w)
        left (.workspace-r w)
        right (.context-r w)]
    (set! (.dragging w) 0)
    (when (and (or (match (.view d)
                     (ViewPersonal [] true)
                     (ViewChat [] true)
                     (_ false)))
               (>= y (.y body))
               (< y (rect-bottom body))
               (not (or (.history-focus w)
                        (.models-open w)
                        (.commands-open d)
                        (.settings-open w)
                        (.action-editor w)
                        (.connections-open w)
                        (.inspection-open d)
                        (.launch-open d)
                        (.help d)
                        (.confirm-stop d))))
      (cond (and (> (.w left) 0)
                 (>= x (+ (rect-right left) 1))
                 (<= x (+ (rect-right left) 2)))
              (set! (.dragging w) 1)
            (and (> (.w right) 0)
                 (< (.w right) (.w body))
                 (>= x (- (.x right) 1))
                 (<= x (.x right)))
              (set! (.dragging w) 2)
            :else 0))
    (> (.dragging w) 0)))

(defn conversation-typing? [(key Key)] (-> bool)
  (match key
    (Char [_] true)
    (Paste [_] true)
    (ShiftEnter [] true)
    (AltEnter [] true)
    (_ false)))

;;; Re-dispatch the original event so normal composer and slash handling apply.
(defn conversation-key! [(d (ptr Dash)) (key Key)] (-> AppFlow)
  (set! (.sidebar-focus (.workbench d)) false)
  (set! (.history-focus (.workbench d)) false)
  (dashboard-key! d key))

(defn click! [(d (ptr Dash)) (x i64) (y i64)] (-> AppFlow)
  (block :click
    (when (and (match (.view d)
                 (ViewPersonal [] true)
                 (ViewChat [] true)
                 (_ false))
               (not (.action-editor (.workbench d)))
               (not (or (.models-open (.workbench d))
                        (.settings-open (.workbench d))
                        (.connections-open (.workbench d))
                        (.commands-open d)
                        (.inspection-open d)
                        (.launch-open d)
                        (.help d)
                        (.confirm-stop d)))
               (project-actions/click! d x y))
      (return-from :click (Continue)))
    (when (divider! d x y) (return-from :click (Continue)))
    (let [w (field d workbench)]
      (when (and (match (.view d)
                   (ViewPersonal [] true)
                   (ViewChat [] true)
                   (_ false))
                 (not (or (.models-open w)
                          (.commands-open d)
                          (.settings-open w)
                          (.action-editor w)
                          (.connections-open w)
                          (.inspection-open d)
                          (.launch-open d)
                          (.help d)
                          (.confirm-stop d)))
                 (rect-contains? (.layout-r w) x y)
                 (not (rect-contains? (.workspace-r w) x y))
                 (not (rect-contains? (.context-r w) x y))
                 (not (and (.history-focus w)
                           (rect-contains? (.history-r w) x y))))
        (set! (.sidebar-focus w) false)
        (set! (.history-focus w) false)
        (return-from :click (Continue)))
      (when (and (match (.view d) (ViewPersonal [] true) (_ false))
                 (not (or (.models-open w)
                          (.commands-open d)
                          (.settings-open w)
                          (.action-editor w)
                          (.connections-open w)
                          (.inspection-open d)
                          (.launch-open d)
                          (.help d)
                          (.confirm-stop d))))
        (cond (rect-contains? (.history-r w) x y)
                (let [i (+ (.offset (.history w)) (- y (.y (.history-r w))))
                      sessions (.value (field w sessions))]
                  (when (and (>= i 0) (< i (jv-len sessions)))
                    (list-select! (field w history) i)
                    (open-personal! d (js (jv-nth sessions i) "id"))))
              (and (not (.history-focus w))
                   (rect-contains? (.workspace-r w) x y))
                (let [row (- y (.y (.workspace-r w)))]
                  (cond (= row 0) (new-personal! d)
                        (= row 2) (set! (.view d) (ViewOverview))
                        (= row 5) (set! (.connections-open w) true)
                        :else 0))
              :else 0))
      (Continue))))

(defn dashboard-key! [(d (ptr Dash)) (key Key)] (-> AppFlow)
  (cond (match key (Ctrl [l] (= l #\c)) (_ false)) (Quit)
        (match key (Scroll [_ _ _] true) (_ false))
          (match key (Scroll [rows x y] (wheel! d rows x y)) (_ (Continue)))
        (match key (Drag [_ _] true) (_ false))
          (match key (Drag [x y] (drag! d x false)) (_ (Continue)))
        (match key (Release [_ _] true) (_ false))
          (match key (Release [x y] (drag! d x true)) (_ (Continue)))
        (match key (Click [_ _] true) (_ false))
          (match key (Click [x y] (click! d x y)) (_ (Continue)))
        (.models-open (.workbench d)) (models-key! d key)
        (.commands-open d) (slash-key! d key)
        (match key (Ctrl [l] (= l #\p)) (_ false)) (open-slash! d "")
        (and (slash-available? d) (match key (Char [ch] (= ch #\/)) (_ false)))
          (open-slash! d "")
        (and (slash-available? d)
             (match key (Paste [text] (starts-with text "/")) (_ false)))
          (match key
            (Paste [text] (open-slash! d (subslice text 1 (len text))))
            (_ (Continue)))
        (.action-editor (.workbench d))
          (do (project-actions/editor-key! d key) (Continue))
        (.settings-open (.workbench d)) (settings-key! d key)
        (.connections-open (.workbench d)) (connections-key! d key)
        (and (match key (Ctrl [ch] (= ch #\y)) (_ false))
             (match (.view d)
               (ViewPersonal [] true)
               (ViewChat [] true)
               (_ false)))
          (do (focus-sidebar! d) (Continue))
        (.inspection-open d)
          (do
            (match key
              (Escape [] (set! (.inspection-open d) false))
              (_ (let [a (io-allocator d)
                       nodes (inspection-nodes d a (.inspection-width d))]
                   (tree-key! (field d inspection) a (slice nodes) key))))
            (Continue))
        (.launch-open d)
          (do
            (match key
              (Escape [] (set! (.launch-open d) false))
              (Ctrl [l]
                    (if (= l #\s)
                        (submit-launch! d)
                        (launch-key! (field d launch) key)))
              (_ (launch-key! (field d launch) key)))
            (Continue))
        (.confirm-stop d)
          (match key
            (Char [ch]
                  (cond (or (= ch #\y) (= ch #\Y))
                          (do
                            (set! (.confirm-stop d) false)
                            (post-run! d (.confirm-run d) "cancel" "stopped")
                            (Continue))
                        (or (= ch #\n) (= ch #\N))
                          (do (set! (.confirm-stop d) false) (Continue))
                        :else (Continue)))
            (Escape [] (do (set! (.confirm-stop d) false) (Continue)))
            (_ (Continue)))
        (.help d)
          (do
            (match key
              (Escape [] (set! (.help d) false))
              (Char [ch]
                    (when (or (= ch #\?) (= ch #\q)) (set! (.help d) false)))
              (_ 0))
            (Continue))
        (match key (Ctrl [l] (= l #\n)) (_ false))
          (do (new-personal! d) (Continue))
        (match key (Ctrl [l] (= l #\f)) (_ false))
          (do
            (set! (.view d)
                  (match (.view d)
                    (ViewPersonal [] (ViewOverview))
                    (_ (ViewPersonal))))
            (Continue))
        (match key (Ctrl [l] (= l #\g)) (_ false))
          (do (set! (.settings-open (.workbench d)) true) (Continue))
        (and (match (.view d) (ViewPersonal [] true) (_ false))
             (match key (Ctrl [l] (= l #\b)) (_ false)))
          (do
            (set! (.history-focus (.workbench d))
                  (not (.history-focus (.workbench d))))
            (Continue))
        (and (match (.view d) (ViewPersonal [] true) (_ false))
             (match key (Ctrl [l] (= l #\x)) (_ false)))
          (do
            (session/cancel! (.allocator d)
                             (.home (.workbench d))
                             (.session-id (.workbench d)))
            (Continue))
        (and (.sidebar-focus (.workbench d))
             (match (.view d)
               (ViewPersonal [] true)
               (ViewChat [] true)
               (_ false)))
          (sidebar-key! d key)
        :else
          (match (.view d)
            (ViewPersonal [] (personal-key! d key))
            (ViewOverview [] (overview-key! d key))
            (ViewRun [] (run-key! d key))
            (ViewChat [] (chat-key! d key)))))

;; ---------------------------------------------------------------------------
;; The app
(defn draw-slash! [(d (ptr Dash)) (frame (ptr Frame))] (-> i64)
  (block :draw
    (when (sidebar-command/active? (input-text (field (field d commands) input)))
      (return-from
        :draw
          (sidebar-command/draw! (field d commands)
                                 (.canvas frame)
                                 (.scratch frame)
                                 (canvas-rect (.canvas frame))
                                 (.theme d)
                                 (.workspace-visible (.workbench d))
                                 (.sidebar-visible (.workbench d)))))
    (let [a (.scratch frame)
          c (.canvas frame)
          bounds (canvas-rect c)
          commands (dashboard-commands d a)
          p (field d commands)
          items (palette-items a p (slice commands))
          bottom (rect 0 (- (.h bounds) 1) (.w bounds) 1)]
      (draw-palette! p c a bounds (slice commands) (.theme d))
      (fill! c bottom 32 (style-default))
      (when (> (len items) 0)
        (let [selected (get items (.selected (.list p)))]
          (put-text-ellipsis! c
                              bottom
                              1
                              (.y bottom)
                              (command-label a (.id selected))
                              (.muted (.theme d)))))
      0)))

(impl App Dash
  (app-draw [(self (ptr Dash)) (frame (ptr Frame))]
    (-> i64)
    (set! (.tick self) (.tick frame))
    (match (.view self)
      (ViewPersonal [] (personal/draw-personal! self frame))
      (ViewOverview [] (draw-overview! self frame))
      (ViewRun [] (draw-run-view! self frame))
      (ViewChat [] (draw-chat-view! self frame)))
    (when (.sidebar-focus (.workbench self))
      (canvas-hide-cursor! (.canvas frame)))
    (when (and (.history-focus (.workbench self))
               (match (.view self) (ViewPersonal [] true) (_ false)))
      (personal/draw-history! self (.canvas frame) (.scratch frame)))
    (when (.help self) (draw-help! self (.canvas frame)))
    (when (.confirm-stop self)
      (draw-confirm-stop! self (.canvas frame) (.scratch frame)))
    (when (.launch-open self)
      (draw-launch! (field self launch) (.canvas frame) (.theme self)))
    (when (.inspection-open self)
      (draw-inspection! self (.canvas frame) (.scratch frame)))
    (when (.action-editor (.workbench self))
      (project-actions/draw-editor! self (.canvas frame)))
    (when (.settings-open (.workbench self))
      (personal/draw-settings! self (.canvas frame)))
    (when (.connections-open (.workbench self))
      (personal/draw-connections! self (.canvas frame) (.scratch frame)))
    (when (.commands-open self) (draw-slash! self frame))
    (when (.models-open (.workbench self))
      (personal/draw-models! self (.canvas frame) (.scratch frame)))
    0)
  (app-event [(self (ptr Dash)) (event Event)]
    (-> AppFlow)
    (set! (.now self) (wall-now))
    (match event
      (TickEvent [n] (do (poll! self) (Continue)))
      (ResizeEvent [w h] (Continue))
      (KeyEvent [key] (dashboard-key! self key)))))

;;; The dashboard, full screen, until the person quits. With `initial-agent`
;;; (and `initial-run`) it opens that agent's chat; with only `initial-run`
;;; (an id or unique prefix) that run; otherwise the overview. Returns the
;;; process exit code.
(defn run-dashboard [(a (dyn Allocator))
                     (hub Hub)
                     (initial-run (slice u8))
                     (initial-agent (slice u8))] (-> i64)
  (let [d (box! a Dash (zeroed Dash))]
    (dash-init! d a hub)
    (workbench/init! (field d workbench) a (config/factory-home a))
    (new-personal! d)
    (let [w (field d workbench)]
      (input-set-text! (index (field w connection) 0) (.base-url hub))
      (input-set-text! (index (field w connection) 1) (.token hub))
      (input-set-text! (index (field w connection) 2) "Local factory")
      (when (> (jv-len (.value (field w profiles))) 0)
        (use-profile! d)))
    (set! (.now d) (wall-now))
    (cond (and (> (len initial-run) 0) (> (len initial-agent) 0))
            (open-chat! d initial-run initial-agent false)
          (> (len initial-run) 0) (open-run! d initial-run)
          :else 0)
    (let [(mut options) (app-options-default)]
      (set! (.mouse (.term options)) true)
      (let [result
              (match (app-run d options a)
                (Ok [_] 0)
                (Err [e]
                     (match e
                       (NotATerminal []
                                     (do
                                       (println "factory: the dashboard needs an interactive terminal (try `factory ps`)")
                                       1))
                       (_ (do
                            (println "factory: could not take over the terminal")
                            1)))))]
        (catalog/close! a (.model-job (.workbench d)))
        (network/close! a (.action-job (.workbench d)))
        (network/close! a (.job (.workbench d)))
        (network/close! a (.active-connection (.workbench d)))
        result))))

;;; Conversation-first workbench control. Local messages never pass through a
;;; factory hub; remote jobs publish results back to this event loop.
(defn new-personal! [(d (ptr Dash))] (-> i64)
  (let [w (field d workbench)
        chat (field d personal)]
    (own! d (field w session-id) "")
    (snap-reset! (field w current))
    (tree-free! (field d inspection))
    (set! (.inspection d) (tree-new (.allocator d)))
    (chat-open! chat "draft" "assistant")
    (set! (.exact chat) true)
    (set! (.needs-transcript chat) false)
    (set! (.status w) "new")
    (set! (.history-focus w) false)
    (set! (.sidebar-focus w) false)
    (set! (.sidebar-sv w) (scroll-view-new))
    (set! (.view d) (ViewPersonal))
    0))

(defn open-personal! [(d (ptr Dash)) (id (slice u8))] (-> i64)
  (let [w (field d workbench)]
    (tree-free! (field d inspection))
    (set! (.inspection d) (tree-new (.allocator d)))
    (own! d (field w session-id) id)
    (set! (.sidebar-focus w) false)
    (set! (.sidebar-sv w) (scroll-view-new))
    (chat-open! (field d personal) id "assistant")
    (set! (.exact (.personal d)) true)
    (set! (.needs-transcript (.personal d)) false)
    (set! (.view d) (ViewPersonal))
    (set! (.history-focus w) false)
    (set! (.polled w) 0)
    (poll-personal! d)
    0))

(defn poll-personal! [(d (ptr Dash))] (-> i64)
  (let [w (field d workbench)
        chat (field d personal)]
    (when (and (> (len (.home w)) 0) (>= (- (.now d) (.polled w)) 250))
      (set! (.polled w) (.now d))
      (let [a (snap-spare (field w sessions))]
        (snap-commit! (field w sessions)
                      (session/list-sessions a (.home w))
                      (.now d)))
      (when (> (len (.session-id w)) 0)
        (let [a (snap-spare (field w current))
              doc
                (session/state-info a
                                    (.home w)
                                    (.session-id w)
                                    (.inspection-open d))]
          (snap-commit! (field w current) doc (.now d))
          (set! (.status w) (js doc "status"))
          (let [state (jv-object a)]
            (jv-put! state "cursor" (JInt (+ (ji doc "inbox_cursor") 1)))
            (chat-sync-pending! chat state)))
        (let [a (io-allocator d)
              page (session/events a (.home w) (.session-id w) (.cursor chat))]
          (chat-ingest-page! chat page)))
      0)
    0))

(defn send-personal! [(d (ptr Dash))] (-> i64)
  (let [w (field d workbench)
        chat (field d personal)
        text (trim (input-text (field chat input)))]
    (block :send
      (when (= (len text) 0) (return-from :send 0))
      (let [a (io-allocator d)]
        (when (= (len (.session-id w)) 0)
          (match (session/create-tier! a
                                       (.home w)
                                       (trim (workbench/value w 1))
                                       (trim (workbench/value w 2))
                                       (workbench/value w 0)
                                       (first-line text)
                                       (if (= (trim (workbench/value w 1))
                                              "codex")
                                           (.service-tier w)
                                           ""))
            (Ok [id] (own! d (field w session-id) id))
            (Err [why] (do (toast! d why (ToneError)) (return-from :send 0)))))
        (match (session/send! a (.home w) (.session-id w) text)
          (Ok [ref]
              (do
                (chat-add-local! chat ref text (.now d))
                (input-submit! (field chat input) a)
                (scroll-to-bottom! (field chat sv))
                (set! (.polled w) 0)
                (poll-personal! d)))
          (Err [why] (toast! d why (ToneError))))))))

(defn interrupt-personal! [(d (ptr Dash))] (-> i64)
  (let [w (field d workbench)
        a (io-allocator d)]
    (when (and (> (len (.session-id w)) 0)
               (or (= (.status w) "running")
                   (proc/process-alive? (session/worker-pid a
                                                            (.home w)
                                                            (.session-id w)))))
      (if (session/cancel! a (.home w) (.session-id w))
          (toast! d "Stopping…" (ToneMuted))
          (toast! d "Could not interrupt the assistant." (ToneError))))
    0))

(defn personal-key! [(d (ptr Dash)) (key Key)] (-> AppFlow)
  (let [w (field d workbench)
        chat (field d personal)]
    (if (.history-focus w)
        (match key
          (Escape [] (do (set! (.history-focus w) false) (Continue)))
          (Enter []
                 (let [sessions (.value (field w sessions))
                       i (.selected (.history w))]
                   (when (and (>= i 0) (< i (jv-len sessions)))
                     (open-personal! d (js (jv-nth sessions i) "id")))
                   (Continue)))
          (_ (if (conversation-typing? key)
                 (conversation-key! d key)
                 (do (list-handle-key! (field w history) key 8) (Continue)))))
        (match key
          (Escape [] (do (interrupt-personal! d) (Continue)))
          (PageUp [] (do (scroll-up! (field chat sv) 10) (Continue)))
          (PageDown [] (do (scroll-down! (field chat sv) 10) (Continue)))
          (Ctrl [letter]
                (cond (= letter #\o)
                        (do (set! (.inspection-open d) true) (Continue))
                      (= letter #\t)
                        (do
                          (set! (.details chat) (not (.details chat)))
                          (Continue))
                      :else
                        (do
                          (input-handle-key! (field chat input) key)
                          (Continue))))
          (_ (match (input-handle-key! (field chat input) key)
               (InputSubmitted [] (do (send-personal! d) (Continue)))
               (_ (Continue))))))))

(defn connect! [(d (ptr Dash)) (kind i64)] (-> i64)
  (let [w (field d workbench)
        address (trim (workbench/connection-value w 0))
        token (trim (workbench/connection-value w 1))
        name (trim (workbench/connection-value w 2))]
    (cond (!= (cast i64 (.job w)) 0)
            (toast! d
                    "A factory connection request is already in progress."
                    (ToneMuted))
          (and (!= kind 3)
               (not (or (starts-with address "http://")
                        (starts-with address "https://")
                        (starts-with address "ssh://"))))
            (toast! d
                    "Enter an https://, http://, or ssh:// factory address."
                    (ToneWarning))
          (and (= kind 4) (not (starts-with address "ssh://")))
            (toast! d "Start remote requires an ssh:// address." (ToneWarning))
          :else
            (let [a (.allocator d)
                  (mut local-config)
                    (match (config/load-site-config a (.home w))
                      (config/SiteConfigOk [c] c)
                      (_ (zeroed config/SiteConfig)))
                  hub
                    (if (= kind 3)
                        (client/hub-for a (mut local-config))
                        (client/Hub :base-url address :token token))]
              (set! (.starting w) true)
              (set! (.job w)
                    (network/start a
                                   kind
                                   (.home w)
                                   hub
                                   (if (= kind 3) (.base-url hub) address)
                                   (if (= kind 3)
                                       "Local factory"
                                       (if (> (len name) 0) name address))))
              (toast! d
                      (if (= kind 3)
                          "Starting local factory…"
                          "Connecting to factory…")
                      (ToneAccent))))))

(defn save-profile! [(d (ptr Dash)) (job (ptr network/Job))] (-> bool)
  (let [w (field d workbench)
        a (snap-spare (field w profiles))
        out (jv-array a)
        entry (jv-object a)
        old (.value (field w profiles))]
    (jv-put! entry "url" (JStr (copy-bytes a (.address job))))
    (jv-put! entry "token" (JStr (copy-bytes a (.token (.hub job)))))
    (jv-put! entry "name" (JStr (copy-bytes a (.name job))))
    (jv-push! out entry)
    (for i (range 0 (jv-len old))
      (let [profile (jv-nth old i)]
        (when (and (< (jv-len out) 9)
                   (not (= (js profile "url") (.address job))))
          (jv-push! out (jv-clone a profile))
          0)))
    (snap-commit! (field w profiles) out (.now d))
    (session/write-doc! a (session/cat a [(.home w) "/connections.json"]) out)))

(defn poll-network! [(d (ptr Dash))] (-> i64)
  (let [w (field d workbench)
        job (.job w)]
    (when (network/ready? job)
      (set! (.job w) (cast (ptr network/Job) 0))
      (set! (.starting w) false)
      (if (= (.kind job) 5)
          (do (apply-sidebar! d job) (network/close! (.allocator d) job))
          (if (= (.kind job) 2)
              (do
                (set! (.polled-overview-t d) (.now d))
                (if (reply-ok? (.reply job))
                    (let [a (snap-spare (field d overview))]
                      (snap-commit! (field d overview)
                                    (jv-clone a (reply-body (.reply job)))
                                    (.now d))
                      (sync-selection! d)
                      (own! d
                            (field (field d hub) base-url)
                            (.base-url (.hub job)))
                      (set! (.connected w) true)
                      (own! d (field d hub-error) ""))
                    (do
                      (set! (.connected w) false)
                      (own! d
                            (field d hub-error)
                            "Factory is disconnected. Use /connect to choose a connection.")))
                (network/close! (.allocator d) job))
              (if (reply-ok? (.reply job))
                  (do
                    (network/close! (.allocator d) (.active-connection w))
                    (set! (.active-connection w) job)
                    (own! d
                          (field (field d hub) base-url)
                          (.base-url (.hub job)))
                    (own! d (field (field d hub) token) (.token (.hub job)))
                    (own! d (field w connection-name) (.name job))
                    (set! (.connected w) true)
                    (set! (.connections-open w) false)
                    (own! d (field d hub-error) "")
                    (snap-reset! (field d overview))
                    (snap-reset! (field d run))
                    (snap-reset! (field w sidebar))
                    (set! (.sidebar-polled w) 0)
                    (set! (.polled-overview-t d) 0)
                    (when (not (match (.view d)
                                 (ViewPersonal [] true)
                                 (_ false)))
                      (set! (.view d) (ViewOverview))
                      0)
                    (if (save-profile! d job)
                        (toast! d "Factory connected." (ToneSuccess))
                        (toast! d
                                "Factory connected, but the connection profile could not be saved."
                                (ToneWarning)))
                    (when (.auto-submit w)
                      (set! (.auto-submit w) false)
                      (submit-launch! d))
                    0)
                  (do
                    (toast! d
                            (reply-error (.allocator d) (.reply job))
                            (ToneError))
                    (set! (.auto-submit w) false)
                    (network/close! (.allocator d) job))))))
    0))

(defn refresh-factory-background! [(d (ptr Dash))] (-> i64)
  (let [w (field d workbench)]
    (when (and (> (len (.home w)) 0)
               (= (cast i64 (.job w)) 0)
               (>= (- (.now d) (.polled-overview-t d))
                   (match (.view d) (ViewOverview [] 1000) (_ 5000))))
      (set! (.polled-overview-t d) (.now d))
      (set! (.job w)
            (network/refresh (.allocator d)
                             (.home w)
                             (.hub d)
                             (.connection-name w)
                             (.active-connection w))))
    0))

(defn open-models! [(d (ptr Dash))] (-> i64)
  (let [w (field d workbench)
        a (snap-spare (field w model-options))
        meta
          (if (> (len (.session-id w)) 0)
              (session/read-doc a
                                (session/path a
                                              (.home w)
                                              (.session-id w)
                                              "session.json"))
              (JNull))
        harness (if (jv-null? meta) (workbench/value w 1) (js meta "harness"))
        model (if (jv-null? meta) (workbench/value w 2) (js meta "model"))
        options (catalog/catalog a (.home w) harness model)]
    (snap-commit! (field w model-options) options (.now d))
    (palette-reset! (field w models))
    (list-set-count! (field (field w models) list) (jv-len options))
    (for i (range 0 (jv-len options))
      (let [option (jv-nth options i)]
        (when (and (= (js option "harness") harness)
                   (= (js option "model") model)
                   (= (js option "service_tier")
                      (if (jv-null? meta)
                          (.service-tier w)
                          (js meta "service_tier"))))
          (list-select! (field (field w models) list) i))))
    (set! (.models-open w) true)
    (own! d (field w model-error) "")
    (when (= (cast i64 (.model-job w)) 0)
      (set! (.model-job w)
            (catalog/start-claude (.allocator d)
                                  (.home w)
                                  (if (jv-null? meta)
                                      (workbench/value w 0)
                                      (js meta "workdir")))))
    0))

;;; Discovery owns a separate arena. Publish on the UI thread and preserve the
;;; highlighted model by identity while the person is searching or navigating.
(defn poll-models! [(d (ptr Dash))] (-> i64)
  (let [w (field d workbench)
        job (.model-job w)]
    (when (catalog/ready? job)
      (join (field job thread))
      (own! d (field w model-error) (.error job))
      (when (and (.models-open w) (not (jv-null? (.models job))))
        (let [a (io-allocator d)
              old-commands (personal/model-commands d a)
              old-items (palette-items a (field w models) (slice old-commands))
              selected (.selected (.list (.models w)))
              old-option
                (if (and (>= selected 0) (< selected (len old-items)))
                    (jv-nth (.value (field w model-options))
                            (- (.id (get old-items selected)) 1))
                    (JNull))
              old-harness (js old-option "harness")
              old-model (js old-option "model")
              old-tier (js old-option "service_tier")
              pa (snap-spare (field w model-options))
              meta
                (if (> (len (.session-id w)) 0)
                    (session/read-doc pa
                                      (session/path pa
                                                    (.home w)
                                                    (.session-id w)
                                                    "session.json"))
                    (JNull))
              harness
                (if (jv-null? meta) (workbench/value w 1) (js meta "harness"))
              model (if (jv-null? meta) (workbench/value w 2) (js meta "model"))
              options
                (catalog/catalog-with-claude pa
                                             (.home w)
                                             harness
                                             model
                                             (.models job))]
          (snap-commit! (field w model-options) options (.now d))
          (let [commands (personal/model-commands d a)
                items (palette-items a (field w models) (slice commands))]
            (list-set-count! (field (field w models) list) (len items))
            (list-select! (field (field w models) list) 0)
            (for i (range 0 (len items))
              (let [option (jv-nth options (- (.id (get items i)) 1))
                    previous-model
                      (if (= old-harness "claude")
                          (catalog/resolve-claude-id (.models job) old-model)
                          old-model)]
                (when (and (= (js option "harness") old-harness)
                           (= (js option "model") previous-model)
                           (= (js option "service_tier") old-tier))
                  (list-select! (field (field w models) list) i)))))
          0))
      (catalog/close! (.allocator d) job)
      (set! (.model-job w) (cast (ptr catalog/Job) 0))
      0))
  0)

(defn models-key! [(d (ptr Dash)) (key Key)] (-> AppFlow)
  (let [w (field d workbench)
        a (io-allocator d)
        commands (personal/model-commands d a)]
    (match (palette-key! (field w models) a (slice commands) key)
      (PaletteClose [] (set! (.models-open w) false))
      (PaletteSelected [id]
                       (let [option
                               (jv-nth (.value (field w model-options))
                                       (- id 1))
                             harness (js option "harness")
                             model (js option "model")
                             result
                               (if (= (len (.session-id w)) 0)
                                   (Ok [i64 (slice u8)] 0)
                                   (session/select-model-tier! a
                                                               (.home w)
                                                               (.session-id w)
                                                               harness
                                                               model
                                                               (js option
                                                                   "service_tier")))]
                         (match result
                           (Err [why] (toast! d why (ToneError)))
                           (Ok [_]
                               (do
                                 (input-set-text! (index (field w settings) 1)
                                                  harness)
                                 (input-set-text! (index (field w settings) 2)
                                                  model)
                                 (own! d
                                       (field w service-tier)
                                       (js option "service_tier"))
                                 (set! (.models-open w) false)
                                 (set! (.polled w) 0)
                                 (poll-personal! d)
                                 (toast! d
                                         (concat a
                                                 [harness
                                                  " · "
                                                  (if (= (len model) 0)
                                                      "CLI default"
                                                      (js option "label"))
                                                  (if (= (.status w) "running")
                                                      " · next turn"
                                                      "")])
                                         (ToneSuccess))
                                 0)))))
      (_ 0))
    (Continue)))

(defn settings-key! [(d (ptr Dash)) (key Key)] (-> AppFlow)
  (let [w (field d workbench)]
    (match key
      (Escape [] (set! (.settings-open w) false))
      (Tab [] (set! (.settings-focus w) (% (+ (.settings-focus w) 1) 3)))
      (BackTab [] (set! (.settings-focus w) (% (+ (.settings-focus w) 2) 3)))
      (Enter [] (do (set! (.settings-open w) false) (new-personal! d)))
      (_ (do
           (input-handle-key! (index (field w settings) (.settings-focus w))
                              key)
           0)))
    (Continue)))

(defn use-profile! [(d (ptr Dash))] (-> i64)
  (let [w (field d workbench)
        profiles (.value (field w profiles))
        i (.selected (.profile-list w))]
    (when (and (>= i 0) (< i (jv-len profiles)))
      (let [profile (jv-nth profiles i)]
        (input-set-text! (index (field w connection) 0) (js profile "url"))
        (input-set-text! (index (field w connection) 1) (js profile "token"))
        (input-set-text! (index (field w connection) 2) (js profile "name"))
        (connect! d 1))))
  0)

(defn connections-key! [(d (ptr Dash)) (key Key)] (-> AppFlow)
  (let [w (field d workbench)]
    (match key
      (Escape [] (set! (.connections-open w) false))
      (Tab [] (set! (.connection-focus w) (% (+ (.connection-focus w) 1) 4)))
      (BackTab []
               (set! (.connection-focus w) (% (+ (.connection-focus w) 3) 4)))
      (Enter []
             (if (= (.connection-focus w) 3) (use-profile! d) (connect! d 1)))
      (Ctrl [letter]
            (cond (= letter #\l) (connect! d 3)
                  (= letter #\r) (connect! d 4)
                  :else
                    (do
                      (when (< (.connection-focus w) 3)
                        (input-handle-key! (index (field w connection)
                                                  (.connection-focus w))
                                           key))
                      0)))
      (_ (if (= (.connection-focus w) 3)
             (do (list-handle-key! (field w profile-list) key 8) 0)
             (do
               (input-handle-key! (index (field w connection)
                                         (.connection-focus w))
                                  key)
               0))))
    (Continue)))

(defn focus-sidebar! [(d (ptr Dash))] (-> i64)
  (let [w (field d workbench)]
    (set! (.sidebar-visible w) true)
    (set! (.sidebar-focus w) (not (.sidebar-focus w)))
    (set! (.sidebar-polled w) 0)
    0))

(defn sidebar-key! [(d (ptr Dash)) (key Key)] (-> AppFlow)
  (block
    :sidebar
      (let [w (field d workbench)]
        (when (and (match (.view d)
                     (ViewPersonal [] true)
                     (ViewChat [] true)
                     (_ false))
                   (project-actions/key! d key))
          (return-from :sidebar (Continue)))
        (when (conversation-typing? key)
          (return-from :sidebar (conversation-key! d key)))
        (match key
          (Escape [] (set! (.sidebar-focus w) false))
          (Up [] (scroll-up! (field w sidebar-sv) 1))
          (Down [] (scroll-down! (field w sidebar-sv) 1))
          (PageUp [] (scroll-up! (field w sidebar-sv) 10))
          (PageDown [] (scroll-down! (field w sidebar-sv) 10))
          (Home [] (scroll-to-top! (field w sidebar-sv)))
          (End [] (scroll-to-bottom! (field w sidebar-sv)))
          (_ 0))
        (Continue))))

(defn sidebar-scope [(d (ptr Dash)) (a (dyn Allocator))] (-> (slice u8))
  (concat a [(.run (.chat d)) "/" (.agent (.chat d))]))

(defn poll-sidebar! [(d (ptr Dash))] (-> i64)
  (let [w (field d workbench)]
    (when (and (> (len (.home w)) 0)
               (.sidebar-visible w)
               (match (.view d) (ViewChat [] true) (_ false))
               (= (cast i64 (.job w)) 0)
               (>= (- (.now d) (.sidebar-polled w)) 1000))
      (let [a (io-allocator d)]
        (set! (.sidebar-polled w) (.now d))
        (set! (.job w)
              (network/fetch (.allocator d)
                             (.home w)
                             (.hub d)
                             (sidebar-scope d a)
                             (run-path a
                                       (.run (.chat d))
                                       (concat a
                                               ["/agents/"
                                                (.agent (.chat d))
                                                "/sidebar"]))
                             (.active-connection w)))))
    0))

(defn apply-sidebar! [(d (ptr Dash)) (job (ptr network/Job))] (-> i64)
  (let [w (field d workbench)
        a (io-allocator d)]
    ;; Ignore a result for an agent the user has already left.
    (when (and (match (.view d) (ViewChat [] true) (_ false))
               (= (.name job) (sidebar-scope d a)))
      (let [sa (snap-spare (field w sidebar))
            doc
              (if (reply-ok? (.reply job))
                  (jv-clone sa (reply-body (.reply job)))
                  (let [old (.value (field w sidebar))]
                    (if (jv-null? old) (jv-object sa) (jv-clone sa old))))]
        (when (not (reply-ok? (.reply job)))
          (jv-put! doc
                   "error"
                   (JStr (copy-bytes sa
                                     "Context is unavailable; showing the last saved board.")))
          0)
        (snap-commit! (field w sidebar) doc (.now d))
        (when (reply-ok? (.reply job))
          (own! d (field (field d hub) base-url) (.base-url (.hub job)))
          0)))
    0))
