(module factory.ui.sidebar)
(import "agent.json" :use *)
(import "coil.str" :use [split])
(import "coil.alloc" :use *)
(import "coil.slice" :use *)
(import "coil.arraylist" :use *)
(import "coil.serde.value" :use *)
(import "tui.canvas" :use *)
(import "tui.widgets" :use *)
(import "factory.ui.model" :use *)
(import "factory.ui.fmt" :use *)
(import "factory.actions" :as actions)
(import "factory.ui.store" :use *)
(import "factory.ui.chat" :use [Line line draw-lines!])

;;; On narrow screens the board becomes a focused full-width pane. Wide
;;; screens keep it beside the conversation, independent of chat scrolling.
(defn panel-width [(d (ptr Dash)) (width i64)] (-> i64)
  (let [w (field d workbench)]
    (cond (not (.sidebar-visible w)) 0
          (< width 70) (if (.sidebar-focus w) width 0)
          (>= width 110)
            (if (< (.context-width w) (- width 60))
                (.context-width w)
                (- width 60))
          :else (if (< (.context-width w) 24) (.context-width w) 24))))

(defn board [(d (ptr Dash))] (-> JVal)
  (match (.view d)
    (ViewPersonal []
                  (jv-get (.value (field (field d workbench) current))
                          "sidebar"))
    (_ (.value (field (field d workbench) sidebar)))))

(defn draw! [(d (ptr Dash)) (c (ptr Canvas)) (a (dyn Allocator)) (r Rect)]
  (-> i64)
  (let [w (field d workbench)
        theme (.theme d)
        inner
          (rect-inset-xy (draw-box! c
                                    r
                                    (panel-opts theme
                                                "Context"
                                                (.sidebar-focus w)))
                         1
                         0)
        doc (board d)
        sections (jv-get doc "sections")
        (mut lines) (ArrayList::new [Line] a)
        ha (snap-spare (field w action-hits))
        hits (jv-array ha)]
    (when (match (.view d) (ViewPersonal [] true) (ViewChat [] true) (_ false))
      (let [doc (.value (field w actions)) list (jv-get doc "actions")]
        (push! (mut lines) (line "" (ToneMuted) "Actions" (ToneAccent)))
        (add-hit! ha (.actions-project w) hits 1 0 "new" (JNull) "")
        (push! (mut lines) (line "" (ToneMuted) "[New action]" (ToneAccent)))
        (for message (iter [(js doc "error") (.action-error w)])
          (when (> (len message) 0)
            (for row (iter (wrap-text a message (.w inner)))
              (push! (mut lines) (line "" (ToneMuted) row (ToneError))))))
        (for i (range 0 (jv-len list))
          (let [action (jv-nth list i) run (jv-get action "run")
                state (js run "state")
                label (concat a [(if (= i (.action-selected w)) "› " "  ") (js action "label")])]
            (push! (mut lines) (line "" (ToneMuted) "" (ToneMuted)))
            (for row (iter (wrap-text a label (.w inner)))
              (push! (mut lines) (line "" (ToneMuted) row (ToneAccent))))
            (for row (iter (wrap-text a (concat a [(if (.actions-unavailable w) "Unavailable" (if (= state "") "Idle" state))
                       (if (and (not (.actions-unavailable w)) (not (jv-null? (jv-get run "exit_code"))))
                         (concat a [" · exit " (int-text a (ji run "exit_code"))]) "")
                       (if (and (actions/active? run) (actions/definition-changed? a action (jv-get run "action")))
                         " · config changed" "")]) (.w inner)))
              (push! (mut lines) (line "" (ToneMuted) row (if (= state "failed") (ToneError) (ToneMuted)))))
            (when (> (len (js run "error")) 0)
              (for row (iter (wrap-text a (js run "error") (.w inner)))
                (push! (mut lines) (line "" (ToneMuted) row (ToneError)))))
            (add-hit! ha (.actions-project w) hits (len lines) 0 "run" action (js doc "token"))
            (add-hit! ha (.actions-project w) hits (len lines) 7 "output" action "")
            (push! (mut lines) (line "" (ToneMuted)
              (if (or (.actions-unavailable w) (.action-mutating w) (> (len (.action-pending w)) 0)) "[Wait] [Log]"
                (if (actions/active? run) "[Stop] [Log]" "[Run]  [Log]")) (ToneAccent)))
            (add-hit! ha (.actions-project w) hits (len lines) 0 "edit" action "")
            (push! (mut lines) (line "" (ToneMuted) "[Edit]" (ToneAccent)))
            (when (and (> (len (.action-output w)) 0) (= (.action-output w) (js run "run_id")))
              (for body (iter [(concat a ["$ " (js (jv-get run "action") "command")])
                               (concat a ["cwd: " (js run "cwd")])
                               (js run "error")
                               (if (= (js (jv-get doc "output_run") "run_id") (.action-output w))
                                 (concat a [(if (match (jv-get (jv-get doc "output_run") "truncated") (JBool [b] b) (_ false))
                                              "[Earlier output omitted]\n" "")
                                            (js (jv-get doc "output_run") "output")])
                                 "Loading output…")])
                (for raw (iter (split a body "\n"))
                  (for row (iter (wrap-text a raw (.w inner)))
                    (push! (mut lines) (line "" (ToneMuted) row (TonePlain)))))))))
        (push! (mut lines) (line "" (ToneMuted) "" (ToneMuted)))
        (push! (mut lines) (line "" (ToneMuted) "Context" (ToneAccent)))))
    (when (> (len (js doc "error")) 0)
      (for row (iter (wrap-text a (js doc "error") (.w inner)))
        (push! (mut lines) (line "" (ToneMuted) row (ToneError)))))
    (for i (range 0 (jv-len sections))
      (let [section (jv-nth sections i)
            items (jv-get section "items")]
        (when (> i 0)
          (push! (mut lines) (line "" (ToneMuted) "" (ToneMuted)))
          0)
        (for row (iter (wrap-text a (js section "title") (.w inner)))
          (push! (mut lines) (line "" (ToneAccent) row (ToneAccent))))
        (for j (range 0 (jv-len items))
          (let [item (jv-nth items j)
                status (js item "status")
                glyph
                  (cond (= status "done") "✓ "
                        (= status "todo") "☐ "
                        (= status "doing") "◐ "
                        :else "· ")
                tone
                  (cond (= status "done") (ToneSuccess)
                        (= status "doing") (ToneAccent)
                        :else (TonePlain))
                rows (wrap-text a (js item "text") (- (.w inner) 2))]
            (for n (range 0 (len rows))
              (push! (mut lines)
                     (line (if (= n 0) glyph "  ") tone (get rows n) tone)))))))
    (when (= (.total (.sidebar-sv w)) 0)
      (set! (.stick-bottom (.sidebar-sv w)) false)
      0)
    (draw-lines! c inner (field w sidebar-sv) (slice lines) theme)
    (snap-commit! (field w action-hits) hits (.now d))
    0))

(defn add-hit! [(a (dyn Allocator)) (project (slice u8)) (hits JVal) (row i64) (column i64) (kind (slice u8))
                (action JVal) (token (slice u8))] (-> i64)
  (let [hit (jv-object a)]
    (jv-put! hit "row" (JInt row)) (jv-put! hit "column" (JInt column))
    (jv-put! hit "kind" (JStr kind))
    (jv-put! hit "project" (JStr (copy-bytes a project)))
    (jv-put! hit "action" (jv-clone a action))
    (jv-put! hit "token" (JStr (copy-bytes a token)))
    (jv-push! hits hit)))
