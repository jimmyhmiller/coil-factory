(module factory.harnesses)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.primitive" :as primitive)
(import "coil.serde.value" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "durable.atomic" :as atomic)
(import "agent.harness" :use *)
(import "agent.json" :use *)
(import "agent.loop" :use *)
(import "agent.tool" :use *)
(import "agent_tools.sandbox" :as sandbox)
(import "agent_tools.workspace" :as ws)
(import "opencode.harness" :as opencode)
(import "codex.harness" :as codex)
(import "claude.harness" :as claude)
(import "factory.config" :use *)
(import "factory.finish" :use *)
(import "factory.models" :use *)
(import "factory.proc" :use *)
(import "factory.toolkit" :use *)
(import "factory.sidebar" :as sidebar)

;;; A station's agent in the harness the station asks for (see `HARNESSES` in
;;; factory.spec). The worker drives the result only through `Harness`.
;;;
;;; builtin    the factory's agent loop, calling `provider/model` directly with
;;;            the files and shell tools from agent-tools.
;;; opencode   `opencode run`, headless, with OpenCode's own tools and the
;;;            finish tool served over MCP by `factory _mcp-finish`. Its model
;;;            is named the way OpenCode names it (`opencode/big-pickle`). Its
;;;            state lives in the run directory (`opencode/`), its cache in the
;;;            site home, and under `isolation: sandbox` the whole program runs
;;;            in the sandbox.
;;; codex      `codex exec`, headless, with Codex's own tools in Codex's own
;;;            sandbox (workspace-write, or read-only for agents that only
;;;            look), and the finish tool served over MCP by `factory
;;;            _mcp-finish`. Its model is named the way Codex names it
;;;            (`gpt-6.1-sol`). Codex keeps its threads and credentials in the
;;;            operator's CODEX_HOME, whose AGENTS.md it always reads; every
;;;            setting is passed on the command line, never read from the
;;;            operator's config.toml, and Codex's own extras (ChatGPT apps,
;;;            plugins, skills, web search) are turned off.

(defstruct StationAgent
  [(harness (dyn Harness))
   ;;; What the journal and dashboard show: the model, and the harness when it
   ;;; is not the builtin one.
   (label (slice u8))
   ;;; The name the agent sees for the finish tool.
   (finish-tool (slice u8))
   ;;; What the harness puts in front of the names of tools served to it
   ;;; over MCP, as the agent sees them ("factory_" for OpenCode).
   (tool-prefix (slice u8))
   (workspace-note (slice u8))
   (tools-note (slice u8))])

(defsum AgentSetup
  (AgentReady [(agent StationAgent)])
  (AgentUnavailable [(message (slice u8))]))

(defstruct AgentRequest
  [(harness (slice u8))
   ;;; "" means the harness's default on this site.
   (model (slice u8))
   ;;; Tool groups: `files`, `read`, `shell`, comma-separated; "" for none.
   (tools (slice u8))
   ;;; Whether the agent has the `finish` tool (stations do; reviewers don't).
   (finish bool)
   (gate (slice u8))
   (workspace (slice u8))
   (run-dir (slice u8))
   ;;; Names the agent: its station, or `review-<reviewer>`.
   (station (slice u8))
   ;;; Keeps this agent's OpenCode sessions apart from the stations' ("" for a
   ;;; station), so a reviewer never shares a session database with the agent
   ;;; it is watching.
   (state-key (slice u8))
   ;;; Tools of the agent's own, offered after its tool groups: a standalone
   ;;; agent's (factory.agenttools). Empty for stations and reviewers.
   (extra-tools (slice (dyn Tool)))
   ;;; The command (program first) that serves `extra-tools` over MCP, for a
   ;;; harness that runs the agent in another program; empty for none. The
   ;;; harness adds `--ready FILE`.
   (agent-server (slice (slice u8)))
   ;;; The name of the extra tool that ends a run, when `finish` is false; ""
   ;;; for none.
   (stop-tool (slice u8))])

;;; No tools of an agent's own, for stations and reviewers.
(defn no-extra-tools [] (-> (slice (dyn Tool)))
  (slice::new (primitive/cast (ptr (dyn Tool)) 0) 0))

;;; No server for them either.
(defn no-agent-server [] (-> (slice (slice u8)))
  (slice::new (primitive/cast (ptr (slice u8)) 0) 0))

(defn context-note [(a (dyn Allocator))
                    (request AgentRequest)
                    (tools (slice u8))] (-> (slice u8))
  (if (= (len (.run-dir request)) 0)
      tools
      (cat a
           [tools
            ". Persistent context: use sidebar_read, sidebar_section and sidebar_item (with the harness's MCP prefix when present) to keep the latest results, todos and important working context visible beside the conversation. Use stable section/item ids and update them in place. The tools save automatically; this board is separate from the transcript."])))

;;; Persistent harnesses expose the context board and, for stations, finish.
;;; A standalone agent's custom server also receives its context scope.
;;; Requests without persistent state keep the legacy finish-only server.
(defn tool-server [(a (dyn Allocator))
                   (request AgentRequest)
                   (ready-file (slice u8))] (-> (ArrayList (slice u8)))
  (let [(mut command) (ArrayList::new [(slice u8)] a)]
    (cond (and (> (len (.run-dir request)) 0)
               (= (len (.agent-server request)) 0))
            (do
              (push! (mut command) (self-executable a))
              (push! (mut command) "_mcp-harness")
              (push! (mut command) (.run-dir request))
              (push! (mut command) (.station request))
              (when (.finish request) (push! (mut command) "--finish") 0)
              (when (> (len (.gate request)) 0)
                (push! (mut command) "--gate")
                0)
              0)
          (.finish request)
            (do
              (push! (mut command) (self-executable a))
              (push! (mut command) "_mcp-finish")
              (when (> (len (.gate request)) 0)
                (push! (mut command) "--gate")
                0)
              0)
          (> (len (.agent-server request)) 0)
            (do
              (for word (iter (.agent-server request))
                (push! (mut command) word))
              (when (> (len (.run-dir request)) 0)
                (for word (iter ["--sidebar-root"
                                 (.run-dir request)
                                 "--sidebar-agent"
                                 (.station request)])
                  (push! (mut command) word))
                0)
              0)
          :else 0)
    (when (> (len command) 0)
      (push! (mut command) "--ready")
      (push! (mut command) ready-file)
      0)
    (load command)))

;;; The name of the tool that ends the agent's runs, as the harness reports
;;; it; "" for none.
(defn stop-name [(request AgentRequest)] (-> (slice u8))
  (if (.finish request) "finish" (.stop-tool request)))

;;; The model a request resolves to in its harness: the one it names, else the
;;; site's default for that harness. "" when neither exists: the factory has no
;;; model of its own to fall back on.
(defn effective-model [(config (ptr SiteConfig))
                       (harness (slice u8))
                       (model (slice u8))] (-> (slice u8))
  (cond (> (len model) 0) model
        (= harness "opencode") (.opencode-model config)
        (= harness "codex") (.codex-model config)
        (= harness "claude") (.claude-model config)
        :else (.default-model config)))

;;; The site.json key that holds a harness's default model, quoted.
(defn model-setting [(harness (slice u8))] (-> (slice u8))
  (cond (= harness "opencode") "\"opencode_model\""
        (= harness "codex") "\"codex_model\""
        (= harness "claude") "\"claude_model\""
        :else "\"default_model\""))

;;; Where a model can be chosen, for a message about one that is missing.
(defn model-choices [(harness (slice u8))] (-> (slice u8))
  (cond (= harness "opencode")
          "--model, `model:` in the factory or station, or \"opencode_model\" in site.json"
        (= harness "codex")
          "--model, `model:` in the factory or station, or \"codex_model\" in site.json"
        (= harness "claude")
          "--model, `model:` in the factory or station, or \"claude_model\" in site.json"
        :else
          "--model, `model:` in the factory or station, or \"default_model\" in site.json"))

(defn cat [(a (dyn Allocator)) (parts (slice (slice u8)))] (-> (slice u8))
  (let [(mut out) (StrBuf::new a)]
    (for part (iter parts) (push-str! (mut out) part))
    (finish! (mut out))))

(defn station-agent [(a (dyn Allocator))
                     (config (ptr SiteConfig))
                     (request AgentRequest)
                     (observer (dyn AgentObserver))
                     (control (dyn AgentControl))] (-> AgentSetup)
  (cond (= (len (effective-model config (.harness request) (.model request))) 0)
          (AgentUnavailable (cat a
                                 ["no model is chosen for "
                                  (.station request)
                                  " ("
                                  (.harness request)
                                  " harness); choose one with "
                                  (model-choices (.harness request))]))
        (and (> (len (.extra-tools request)) 0)
             (= (len (.agent-server request)) 0)
             (not (= (.harness request) "builtin")))
          (AgentUnavailable (cat a
                                 ["the "
                                  (.harness request)
                                  " harness cannot offer "
                                  (.station request)
                                  "'s own tools yet; only the builtin harness can (choose it with --harness builtin or `harness: builtin`)"]))
        (= (.harness request) "builtin")
          (builtin-agent a config request observer control)
        (= (.harness request) "opencode")
          (opencode-agent a config request observer control)
        (= (.harness request) "codex")
          (codex-agent a config request observer control)
        (= (.harness request) "claude")
          (claude-agent a config request observer control)
        :else
          (AgentUnavailable (cat a
                                 ["unknown harness \""
                                  (.harness request)
                                  "\"; the harnesses are builtin, opencode, codex, and claude"]))))

;; ---------------------------------------------------------------------------
;; builtin

(defn builtin-agent [(a (dyn Allocator))
                     (config (ptr SiteConfig))
                     (request AgentRequest)
                     (observer (dyn AgentObserver))
                     (control (dyn AgentControl))] (-> AgentSetup)
  (match (resolve-model a
                        config
                        (effective-model config "builtin" (.model request)))
    (ModelBad [message] (AgentUnavailable message))
    (ModelOk [found]
             (let [resolved found
                   registry (box! a ToolRegistry (registry-new a))
                   finish (box! a FinishTool (FinishTool :gate (.gate request)))]
               (match (add-tool-groups! a
                                        registry
                                        (.workspace request)
                                        (.tools request)
                                        (.isolation config))
                 (Some [problem] (AgentUnavailable problem))
                 (None []
                       (block :tools
                         (when (.finish request)
                           (registry-add! registry finish)
                           0)
                         (sidebar/register! a
                                            registry
                                            (.run-dir request)
                                            (.station request))
                         (for tool (iter (.extra-tools request))
                           (when (not (registry-add! registry tool))
                             (return-from
                               :tools
                                 (AgentUnavailable (cat a
                                                        ["two of "
                                                         (.station request)
                                                         "'s tools are named \""
                                                         (.name (tool-spec tool))
                                                         "\"; rename the agent's own tool"])))
                             0))
                         (let [stop
                                 (if (.finish request)
                                     "finish"
                                     (.stop-tool request))
                               agent
                                 (box! a
                                       Agent
                                       (agent-new a
                                                  (.provider resolved)
                                                  (agent-config (.model resolved)
                                                                stop)
                                                  registry
                                                  observer
                                                  control))]
                           (AgentReady (StationAgent
                                         :harness agent
                                         :label (.label resolved)
                                         :finish-tool
                                           (if (.finish request)
                                               "finish"
                                               (.stop-tool request))
                                         :tool-prefix ""
                                         :workspace-note
                                           "Every path you give a tool is relative to that directory, and shell commands already start in it."
                                         :tools-note
                                           (context-note a
                                                         request
                                                         (.tools request))))))))))))

;; ---------------------------------------------------------------------------
;; opencode

;;; The OpenCode executable: site.json `opencode`, else `opencode` on PATH,
;;; else OpenCode's own install location, ~/.opencode/bin/opencode.
(defn find-opencode [(a (dyn Allocator)) (config (ptr SiteConfig))]
  (-> (Option (slice u8)))
  (if (> (len (.opencode config)) 0)
      (real-path a (.opencode config))
      (match (search-path a "opencode")
        (Some [path] (Some path))
        (None []
              (real-path a
                         (path-join a
                                    (env-or a "HOME" "/")
                                    ".opencode/bin/opencode"))))))

(defn has-group? [(a (dyn Allocator)) (tools (slice u8)) (group (slice u8))]
  (-> bool)
  (let [(mut found) false]
    (for name (iter (split-groups a tools))
      (when (= name group) (set! found true) 0))
    (load found)))

;;; OpenCode permissions for tool groups: nothing outside the workspace, no
;;; subagents (they run under other agents' permissions), no editing without
;;; `files`, and no searching or listing without `files` or `read`. `bash` and `read` are never denied here:
;;; OpenCode Zen's free models refuse a request whose tools lack either
;;; ("OpenCode's free tier can only be used from within OpenCode"), and a
;;; denied tool is removed from the request. They are refused by the guard
;;; plugin instead (`opencode-guard`), which keeps them offered.
(defn opencode-permission [(a (dyn Allocator)) (tools (slice u8))] (-> JVal)
  (let [permission (jv-object a)
        files (has-group? a tools "files")
        look (or files (has-group? a tools "read"))]
    (jv-put! permission "external_directory" (JStr "deny"))
    (jv-put! permission "task" (JStr "deny"))
    (jv-put! permission "edit" (JStr (if files "allow" "deny")))
    (for tool (iter ["glob" "grep" "list"])
      (jv-put! permission tool (JStr (if look "allow" "deny"))))
    permission))

;;; The OpenCode tools a station may not call that permissions cannot remove
;;; (see `opencode-permission`), with the reason the agent is shown.
(defn opencode-refusals [(a (dyn Allocator)) (tools (slice u8))]
  (-> (ArrayList (slice u8)))
  (let [(mut out) (ArrayList::new [(slice u8)] a)]
    (when (not (has-group? a tools "shell"))
      (push! (mut out) "bash")
      (push! (mut out)
             (cat a
                  ["This station has no shell (its tools are: "
                   tools
                   "), so the factory refused bash."]))
      0)
    (when (not (or (has-group? a tools "files") (has-group? a tools "read")))
      (push! (mut out) "read")
      (push! (mut out)
             (cat a
                  ["This station has no file tools (its tools are: "
                   tools
                   "), so the factory refused read."]))
      0)
    (load out)))

;;; A JSON string literal.
(defn json-string [(a (dyn Allocator)) (text (slice u8))] (-> (slice u8))
  (jv-encode a (JStr text)))

;;; An OpenCode plugin that refuses calls to the tools in `refusals`
;;; (tool, reason, tool, reason, ...), keeping them offered to the model.
(defn opencode-guard [(a (dyn Allocator))
                      (station (slice u8))
                      (refusals (slice (slice u8)))] (-> (slice u8))
  (let [(mut out) (StrBuf::new a)
        (mut i) 0]
    (push-str! (mut out) "// Generated by the factory for the station ")
    (push-str! (mut out) station)
    (push-str! (mut out)
               ". OpenCode Zen's free models only answer requests that offer\n// OpenCode's bash and read tools, so a tool this station may not use stays offered\n// and its calls are refused here.\nconst refused = {\n")
    (loop (if (>= (+ (load i) 1) (len refusals))
              (break)
              (do
                (push-str! (mut out) "  ")
                (push-str! (mut out) (json-string a (get refusals (load i))))
                (push-str! (mut out) ": ")
                (push-str! (mut out)
                           (json-string a (get refusals (+ (load i) 1))))
                (push-str! (mut out) ",\n")
                (set! i (+ (load i) 2)))))
    (push-str! (mut out)
               "};\nexport const FactoryGuard = async () => ({\n  \"tool.execute.before\": async (input) => {\n    const why = refused[input.tool];\n    if (why) throw new Error(why);\n  },\n});\n")
    (finish! (mut out))))

(defn opencode-tools-note [(a (dyn Allocator)) (tools (slice u8))]
  (-> (slice u8))
  (let [files (has-group? a tools "files")
        shell (has-group? a tools "shell")]
    (cond (and files shell)
            "OpenCode's file tools (read, edit, write, grep, glob, list) and bash"
          files
            "OpenCode's file tools (read, edit, write, grep, glob, list); no shell"
          (has-group? a tools "read")
            "OpenCode's read, grep, glob, and list; nothing that changes files"
          shell "OpenCode's bash; no file tools"
          :else "none")))

(defn ensure-dirs! [(a (dyn Allocator)) (dirs (slice (slice u8)))]
  (-> (slice u8))
  (let [(mut problem) ""]
    (for dir (iter dirs)
      (when (= (len (load problem)) 0)
        (match (atomic/ensure-dir! a dir 448)
          (Ok [made] 0)
          (Err [failure]
               (do (set! problem (cat a ["could not create " dir])) 0)))
        0))
    (load problem)))

;;; The sandbox argv to put in front of OpenCode: the station's workspace plus
;;; OpenCode's own state and cache are writable, the network is open (it is
;;; how OpenCode reaches the model). Empty without isolation.
(defn opencode-launcher [(a (dyn Allocator))
                         (config (ptr SiteConfig))
                         (workspace (slice u8))
                         (writable (slice (slice u8)))]
  (-> (Result (slice (slice u8)) (slice u8)))
  (if (= (.isolation config) "none")
      (Ok (slice::new (primitive/cast (ptr (slice u8)) 0) 0))
      (match (ws/workspace-open a workspace)
        (Err [message] (Err message))
        (Ok [opened]
            (match (sandbox/workspace-sandbox-options a opened true)
              (Err [message] (Err message))
              (Ok [base]
                  (let [(mut paths) (ArrayList::new [(slice u8)] a)]
                    (for path (iter (.extra-writable base))
                      (push! (mut paths) path))
                    (for path (iter writable)
                      ;; The macOS sandbox compares canonical paths.
                      (match (real-path a path)
                        (Some [canonical] (push! (mut paths) canonical))
                        (None [] (push! (mut paths) path))))
                    (let [options
                            (sandbox/sandbox-options-with-paths true
                                                                (slice paths))
                          policy (sandbox/sandbox-detect a options)]
                      (match policy
                        (sandbox/NoSandbox []
                                           (Err "this site's isolation is \"sandbox\" but this machine has neither sandbox-exec nor bwrap"))
                        (_ (let [(mut argv)
                                   (sandbox/sandbox-program-argv a
                                                                 policy
                                                                 (ws/workspace-root opened)
                                                                 (slice::new (primitive/cast (ptr (slice u8))
                                                                                             0)
                                                                             0))]
                             (Ok (slice argv)))))))))))))

(defn opencode-agent [(a (dyn Allocator))
                      (config (ptr SiteConfig))
                      (request AgentRequest)
                      (observer (dyn AgentObserver))
                      (control (dyn AgentControl))] (-> AgentSetup)
  (block
    :setup
      (let [program
              (match (find-opencode a config)
                (Some [path] path)
                (None []
                      (return-from
                        :setup
                          (AgentUnavailable "the opencode harness needs OpenCode on this site: install it (https://opencode.ai) or set \"opencode\" in site.json to its path"))))
            root (path-join a (.run-dir request) "opencode")
            state-dir
              (path-join a
                         root
                         (if (> (len (.state-key request)) 0)
                             (cat a ["state-" (.state-key request)])
                             "state"))
            ;; Shared by every run on the site: OpenCode installs its plugin
            ;; package (about 60 MB) into the config home and keeps the
            ;; models.dev catalog in the cache.
            site-root (path-join a (.home config) "opencode")
            config-home (path-join a site-root "config")
            cache-dir (path-join a site-root "cache")
            problem
              (ensure-dirs! a
                            [root
                             state-dir
                             site-root
                             config-home
                             cache-dir
                             (path-join a (.run-dir request) "sidebar")])]
        (when (> (len problem) 0)
          (return-from :setup (AgentUnavailable problem)))
        (let [launcher
                (match (opencode-launcher a
                                          config
                                          (.workspace request)
                                          [root
                                           site-root
                                           (path-join a
                                                      (.run-dir request)
                                                      "sidebar")])
                  (Ok [argv] argv)
                  (Err [message]
                       (return-from :setup (AgentUnavailable message))))
              model (effective-model config "opencode" (.model request))
              ready-file
                (path-join a root (cat a [(.station request) ".ready"]))
              finish-server (jv-object a)
              command (jv-array a)
              mcp (jv-object a)
              plugins (jv-array a)
              refusals (opencode-refusals a (.tools request))
              server (tool-server a request ready-file)
              stop (stop-name request)]
          (when (> (len refusals) 0)
            (let [guard-path
                    (path-join a root (cat a [(.station request) "-guard.js"]))]
              (match (atomic/write-file-atomic! a
                                                guard-path
                                                (opencode-guard a
                                                                (.station request)
                                                                (slice refusals))
                                                420)
                (Ok [_]
                    (jv-push! plugins (JStr (cat a ["file://" guard-path]))))
                (Err [_]
                     (return-from
                       :setup
                         (AgentUnavailable (cat a
                                                ["could not write " guard-path])))))
              0))
          (when (> (len server) 0)
            (for word (iter server) (jv-push! command (JStr word)))
            (jv-put! finish-server "type" (JStr "local"))
            (jv-put! finish-server "command" command)
            (jv-put! finish-server "enabled" (JBool true))
            (jv-put! mcp "factory" finish-server)
            0)
          (let [harness
                  (box! a
                        opencode/OpenCodeHarness
                        (opencode/opencode-new a
                                               (opencode/OpenCodeOptions :program
                                                                         program
                                                                         :launcher
                                                                         launcher
                                                                         :workdir
                                                                         (.workspace request)
                                                                         :state-dir
                                                                         state-dir
                                                                         :config-home
                                                                         config-home
                                                                         :cache-dir
                                                                         cache-dir
                                                                         :config-path
                                                                         (path-join a
                                                                                    root
                                                                                    (cat a
                                                                                         [(.station request)
                                                                                          ".json"]))
                                                                         :model
                                                                         model
                                                                         :agent-name
                                                                         (cat a
                                                                              ["factory-"
                                                                               (.station request)])
                                                                         :permission
                                                                         (opencode-permission a
                                                                                              (.tools request))
                                                                         :mcp
                                                                         mcp
                                                                         :plugins
                                                                         plugins
                                                                         ;; Without a tool server there is nothing to
                                                                         ;; wait for or stop on.
                                                                         :ready-file
                                                                         (if (> (len server)
                                                                                0)
                                                                             ready-file
                                                                             "")
                                                                         :stop-tool
                                                                         (if (> (len stop)
                                                                                0)
                                                                             (cat a
                                                                                  ["factory_"
                                                                                   stop])
                                                                             "")
                                                                         :stop-tool-as
                                                                         stop
                                                                         :idle-timeout-ms
                                                                         1800000)
                                               observer
                                               control))]
            (AgentReady (StationAgent
                          :harness harness
                          :label (cat a [model " via opencode"])
                          :finish-tool
                            (cat a
                                 ["factory_"
                                  (if (> (len stop) 0) stop "finish")])
                          :tool-prefix "factory_"
                          :workspace-note
                            "Your tools work in that directory, and shell commands already start in it. Keep every path inside it: file tools refuse paths outside it."
                          :tools-note
                            (context-note a
                                          request
                                          (opencode-tools-note a
                                                               (.tools request))))))))))

;; ---------------------------------------------------------------------------
;; codex

;;; The Codex executable: site.json `codex`, else `codex` on PATH.
(defn find-codex [(a (dyn Allocator)) (config (ptr SiteConfig))]
  (-> (Option (slice u8)))
  (if (> (len (.codex config)) 0)
      (real-path a (.codex config))
      (search-path a "codex")))

;;; Codex's home, where it keeps its threads' session logs: CODEX_HOME, else
;;; `~/.codex`.
(defn codex-home [(a (dyn Allocator))] (-> (slice u8))
  (let [given (env-or a "CODEX_HOME" "")]
    (if (> (len given) 0) given (path-join a (env-or a "HOME" "/") ".codex"))))

;;; Codex's sandbox for a tool list. Codex always offers its shell and its
;;; patch tool and cannot take either away, so only two shapes fit: both
;;; groups (the workspace is writable), or none of them (read-only; `read`
;;; looks without changing anything). Anything else is refused, not widened.
(defn codex-sandbox [(a (dyn Allocator)) (tools (slice u8))]
  (-> (Result (slice u8) (slice u8)))
  (let [files (has-group? a tools "files")
        shell (has-group? a tools "shell")]
    (cond (and files shell) (Ok "workspace-write")
          (and (not files) (not shell)) (Ok "read-only")
          :else
            (Err (cat a
                      ["the codex harness cannot give an agent only part of files and shell (its tools are: "
                       tools
                       "): Codex always has both, so give it both, or neither (read-only), or use another harness"])))))

(defn codex-tools-note [(sandbox (slice u8))] (-> (slice u8))
  (if (= sandbox "workspace-write")
      "Codex's shell and file editing; commands run in Codex's sandbox, which can write only inside the workspace"
      "Codex's shell, read-only: you can look at and run things, but nothing you run can change files"))

;;; Extra Codex settings for a sandbox: the site's `codex_writable`
;;; directories become writable roots of the workspace sandbox. A read-only
;;; agent gets none.
(defn codex-settings [(a (dyn Allocator))
                      (config (ptr SiteConfig))
                      (sandbox (slice u8))] (-> (slice (slice u8)))
  (let [(mut out) (ArrayList::new [(slice u8)] a)
        (mut roots) (ArrayList::new [(slice u8)] a)]
    (push! (mut out)
           (if (= sandbox "workspace-write")
               "features.multi_agent=true"
               "features.multi_agent=false"))
    (push! (mut out) "agents.max_threads=3")
    (when (= sandbox "workspace-write")
      (when (.codex-network config)
        (push! (mut out) "sandbox_workspace_write.network_access=true")
        0)
      (for raw (iter (split a (.codex-writable config) ","))
        (let [path (trim raw)]
          (when (> (len path) 0)
            (push! (mut roots)
                   (if (or (= path "~") (starts-with path "~/"))
                       (path-join a
                                  (env-or a "HOME" "/")
                                  (subslice path
                                            (if (= path "~") 1 2)
                                            (len path)))
                       path))
            0)))
      (when (> (len roots) 0)
        (push! (mut out)
               (cat a
                    ["sandbox_workspace_write.writable_roots="
                     (codex/toml-array a (slice roots))]))
        0)
      0)
    (slice out)))

(defn codex-agent [(a (dyn Allocator))
                   (config (ptr SiteConfig))
                   (request AgentRequest)
                   (observer (dyn AgentObserver))
                   (control (dyn AgentControl))] (-> AgentSetup)
  (block
    :setup
      (let [program
              (match (find-codex a config)
                (Some [path] path)
                (None []
                      (return-from
                        :setup
                          (AgentUnavailable "the codex harness needs the Codex CLI on this site: install it, or set \"codex\" in site.json to its path"))))
            sandbox
              (match (codex-sandbox a (.tools request))
                (Ok [mode] mode)
                (Err [message] (return-from :setup (AgentUnavailable message))))
            root (path-join a (.run-dir request) "codex")
            problem (ensure-dirs! a [root])]
        (when (> (len problem) 0)
          (return-from :setup (AgentUnavailable problem)))
        (let [model (effective-model config "codex" (.model request))
              ready-file
                (path-join a root (cat a [(.station request) ".ready"]))
              (mut command) (tool-server a request ready-file)
              stop (stop-name request)]
          (let [harness
                  (box! a
                        codex/CodexHarness
                        (codex/codex-new a
                                         (codex/CodexOptions
                                           :program program
                                           :workdir (.workspace request)
                                           :home (codex-home a)
                                           :model model
                                           :sandbox sandbox
                                           :stop-server "factory"
                                           :stop-command (slice command)
                                           :stop-tool stop
                                           :stop-tool-as stop
                                           :ready-file
                                             (if (> (len command) 0)
                                                 ready-file
                                                 "")
                                           :settings
                                             (codex-settings a config sandbox)
                                           :idle-timeout-ms 1800000)
                                         observer
                                         control))]
            (AgentReady (StationAgent
                          :harness harness
                          :label (cat a [model " via codex"])
                          :finish-tool (if (> (len stop) 0) stop "finish")
                          :tool-prefix ""
                          :workspace-note
                            "Your shell starts in that directory. Keep every change inside it: Codex's sandbox refuses writes outside it."
                          :tools-note
                            (context-note a request (codex-tools-note sandbox)))))))))

(defn claude-tools [(a (dyn Allocator)) (tools (slice u8))] (-> (slice u8))
  (let [files (has-group? a tools "files")
        shell (has-group? a tools "shell")
        look (or files (has-group? a tools "read"))
        (mut out) (StrBuf::new a)]
    (when look (push-str! (mut out) "Read,Glob,Grep") 0)
    (when files (push-str! (mut out) ",Edit,Write") 0)
    (when shell
      (when look (push-str! (mut out) ",") 0)
      (push-str! (mut out) "Bash")
      0)
    (when (and files shell) (push-str! (mut out) ",Agent") 0)
    (finish! (mut out))))

(defn claude-agent [(a (dyn Allocator))
                    (config (ptr SiteConfig))
                    (request AgentRequest)
                    (observer (dyn AgentObserver))
                    (control (dyn AgentControl))] (-> AgentSetup)
  (block
    :setup
      (let [program
              (match (if (> (len (.claude config)) 0)
                         (real-path a (.claude config))
                         (search-path a "claude"))
                (Some [path] path)
                (None []
                      (return-from
                        :setup
                          (AgentUnavailable "Install Claude Code on this site, or set claude in site.json to its executable path."))))
            root (path-join a (.run-dir request) "claude")
            problem
              (ensure-dirs! a [root (path-join a (.run-dir request) "sidebar")])]
        (when (> (len problem) 0)
          (return-from :setup (AgentUnavailable problem)))
        (let [launcher
                (match (opencode-launcher a
                                          config
                                          (.workspace request)
                                          [root
                                           (path-join a
                                                      (.run-dir request)
                                                      "sidebar")
                                           (path-join a
                                                      (env-or a "HOME" "/")
                                                      ".claude")])
                  (Ok [argv] argv)
                  (Err [message]
                       (return-from :setup (AgentUnavailable message))))
              ready (path-join a root (cat a [(.station request) ".ready"]))
              command (tool-server a request ready)
              stop (stop-name request)
              mcp (jv-object a)
              servers (jv-object a)
              server (jv-object a)
              args (jv-array a)]
          (when (> (len command) 0)
            (jv-put! server "command" (JStr (get command 0)))
            (for i (range 1 (len command))
              (jv-push! args (JStr (get command i))))
            (jv-put! server "args" args)
            (jv-put! servers "factory" server)
            0)
          (jv-put! mcp "mcpServers" servers)
          (let [model (effective-model config "claude" (.model request))
                harness
                  (box! a
                        claude/ClaudeHarness
                        (claude/claude-new a
                                           (claude/ClaudeOptions
                                             :program program
                                             :launcher launcher
                                             :workdir (.workspace request)
                                             :model model
                                             :tools
                                               (claude-tools a (.tools request))
                                             :mcp mcp
                                             :ready-file
                                               (if (> (len command) 0) ready "")
                                             :stop-tool
                                               (if (> (len stop) 0)
                                                   (cat a
                                                        ["mcp__factory__" stop])
                                                   "")
                                             :stop-tool-as stop
                                             :idle-timeout-ms 1800000)
                                           observer
                                           control))]
            (AgentReady (StationAgent
                          :harness harness
                          :label (cat a [model " via claude"])
                          :finish-tool
                            (if (> (len stop) 0)
                                (cat a ["mcp__factory__" stop])
                                "finish")
                          :tool-prefix "mcp__factory__"
                          :workspace-note
                            "Your tools start in this workspace. Keep changes inside it."
                          :tools-note
                            (context-note a
                                          request
                                          (claude-tools a (.tools request))))))))))
