;; ---------------------------------------------------------------------------
;; Test doubles

;;; Records the kind of every event, and the text of the interesting ones.
(defstruct Recorder [(allocator (dyn Allocator)) (seen (ArrayList (slice u8)))])

(defn cat [(a (dyn Allocator)) (parts (slice (slice u8)))] (-> (slice u8))
  (let [(mut out) (sb-new a)]
    (for part (iter parts) (sb-push-str! (mut out) part))
    (sb-finish! (mut out))))

(impl AgentObserver Recorder
  (observe [(self (ptr Recorder)) (event AgentEvent)] (-> i64)
    (let [a (.allocator self)
          line (match event
                 (TurnStarted [turn] "turn")
                 (MessageDelivered [m] (cat a ["delivered " (.text m)]))
                 (Thought [text] (cat a ["thought " text]))
                 (Said [text] (cat a ["said " text]))
                 (UsageReported [input output]
                                (let [(mut b) (sb-new a)]
                                  (sb-push-str! (mut b) "usage ")
                                  (sb-push-i64! (mut b) input)
                                  (sb-push-str! (mut b) "/")
                                  (sb-push-i64! (mut b) output)
                                  (sb-finish! (mut b))))
                 (ToolStarted [call summary] (cat a ["tool " summary]))
                 (ToolEnded [call summary ok output elapsed] (cat a [(if ok "ok " "failed ") output]))
                 (ModelRetrying [attempt error delay] "retry")
                 (PausedEvent [] "paused")
                 (ResumedEvent [] "resumed")
                 (UsageUnknown [reason] (cat a ["usage unknown: " reason]))
                 (Compacted [n bytes] "compacted"))]
      (push! (mut (.seen self)) line)
      0)))

(defn saw? [(r (ptr Recorder)) (line (slice u8))] (-> bool)
  (let [(mut found) false]
    (for seen (iter (.seen r)) (when (= seen line) (set! found true) 0))
    (load found)))

;;; Cancels once `cancel-at-ms` (monotonic, 0 = never) passes; hands out one
;;; message on its `message-on`-th inbox call (0 = never).
(defstruct Script
  [(cancel-at-ms i64)
   (message-on i64)
   (inbox-calls i64)])

(impl AgentControl Script
  (control-check [(self (ptr Script))] (-> Control)
    (if (and (> (.cancel-at-ms self) 0) (>= (sys/monotonic-ms) (.cancel-at-ms self)))
        (Cancel)
        (Proceed)))
  (control-inbox [(self (ptr Script)) (a (dyn Allocator))] (-> (ArrayList Inbound))
    (let [(mut out) (al-new [Inbound] a)]
      (set! (.inbox-calls self) (+ (.inbox-calls self) 1))
      (when (= (.inbox-calls self) (.message-on self))
        (push! (mut out) (Inbound :from "operator" :text "use tabs" :ref 7))
        0)
      (load out)))
  (control-idle [(self (ptr Script))] (-> i64) (sys/sleep-ms 50)))

(defn run-status [(a (dyn Allocator)) (program (slice u8)) (args (slice (slice u8)))] (-> i64)
  (let [child (primitive/alloc-stack subprocess/Child)]
    (match (subprocess/spawn a child program args (subprocess/null-stdio) (subprocess/inherit-stdio) (subprocess/inherit-stdio))
      (Err [_] -1)
      (Ok [_] (match (subprocess/child-wait child)
                (Ok [status] (match status (subprocess/Exited [code] code) (subprocess/Signaled [signal] (+ 128 signal))))
                (Err [_] -1))))))

;; ---------------------------------------------------------------------------
;; A fake `opencode`: a shell script that records how it was called and
;; replays `reply.N` (the Nth call), which is sourced as shell.

(defn fresh-dir [(a (dyn Allocator)) (label (slice u8))] (-> (slice u8))
  (let [(mut b) (sb-new a)]
    (sb-push-str! (mut b) "/private/tmp/opencode-test-")
    (sb-push-i64! (mut b) (process/id))
    (sb-push-str! (mut b) "-")
    (sb-push-str! (mut b) label)
    (let [dir (sb-finish! (mut b))]
      (run-status a "/bin/rm" ["-rf" dir])
      (match (sys/make-directory a dir)
        (Ok [_] dir)
        (Err [code] (do (assert false) dir))))))

(defn write! [(a (dyn Allocator)) (path (slice u8)) (text (slice u8))] (-> i64)
  (match (fs/write-file a path text)
    (Ok [_] 0)
    (Err [_] (do (println "cannot write {}" path) (assert false) 0))))

(defn read [(a (dyn Allocator)) (path (slice u8))] (-> (slice u8))
  (match (fs/read-file a path)
    (Ok [bytes] bytes)
    (Err [_] "")))

(defn contains? [(text (slice u8)) (needle (slice u8))] (-> bool)
  (match (str-find text needle) (Some [_] true) (None [] false)))

(const FAKE "#!/bin/sh
dir=\"$(dirname \"$0\")\"
n=$(cat \"$dir/count\" 2>/dev/null || echo 0); n=$((n+1)); echo $n > \"$dir/count\"
printf '%s\\n' \"$@\" > \"$dir/argv.$n\"
cat > \"$dir/stdin.$n\"
env > \"$dir/env.$n\"
. \"$dir/reply.$n\"
")

(defn ev [(a (dyn Allocator)) (body (slice u8))] (-> (slice u8))
  (cat a ["echo '{\"sessionID\":\"ses_1\"," body "}'\n"]))

(defn step-start [(a (dyn Allocator))] (-> (slice u8))
  (ev a "\"type\":\"step_start\",\"part\":{\"type\":\"step-start\"}"))

(defn step-finish [(a (dyn Allocator)) (reason (slice u8))] (-> (slice u8))
  (ev a (cat a ["\"type\":\"step_finish\",\"part\":{\"reason\":\"" reason "\",\"tokens\":{\"input\":100,\"output\":20,\"reasoning\":5,\"cache\":{\"read\":50,\"write\":0}}}"])))

(defn text-event [(a (dyn Allocator)) (text (slice u8))] (-> (slice u8))
  (ev a (cat a ["\"type\":\"text\",\"part\":{\"type\":\"text\",\"text\":\"" text "\"}"])))

(defn bash-event [(a (dyn Allocator))] (-> (slice u8))
  (ev a "\"type\":\"tool_use\",\"part\":{\"type\":\"tool\",\"tool\":\"bash\",\"callID\":\"c1\",\"state\":{\"status\":\"completed\",\"input\":{\"command\":\"ls\"},\"output\":\"a.txt\",\"title\":\"ls\",\"time\":{\"start\":10,\"end\":15}}}"))

(defn finish-event [(a (dyn Allocator))] (-> (slice u8))
  (ev a "\"type\":\"tool_use\",\"part\":{\"type\":\"tool\",\"tool\":\"factory_finish\",\"callID\":\"c2\",\"state\":{\"status\":\"completed\",\"input\":{\"outcome\":\"done\",\"summary\":\"did it\"},\"output\":\"Recorded.\",\"title\":\"\",\"time\":{\"start\":20,\"end\":21}}}"))

(defstruct Fixture
  [(dir (slice u8))
   (harness (ptr OpenCodeHarness))
   (recorder (ptr Recorder))
   (control (ptr Script))])

(defn fixture [(a (dyn Allocator)) (label (slice u8)) (replies (slice (slice u8))) (control (ptr Script))] (-> Fixture)
  (let [dir (fresh-dir a label)
        program (cat a [dir "/opencode"])
        recorder (box! a Recorder (Recorder :allocator a :seen (al-new [(slice u8)] a)))
        (mut i) 0]
    (write! a program FAKE)
    (run-status a "/bin/chmod" ["+x" program])
    (loop (if (>= (load i) (len replies))
              (break)
              (let [(mut name) (sb-new a)]
                (sb-push-str! (mut name) dir)
                (sb-push-str! (mut name) "/reply.")
                (sb-push-i64! (mut name) (+ (load i) 1))
                (write! a (sb-finish! (mut name)) (get replies (load i)))
                (set! i (+ (load i) 1)))))
    (let [permission (jv-object a)
          mcp (jv-object a)]
      (jv-put! permission "external_directory" (JStr "deny"))
      (let [harness (box! a OpenCodeHarness
                          (opencode-new a
                                        (OpenCodeOptions :program program
                                                         :launcher (slice-new (primitive/cast (ptr (slice u8)) 0) 0)
                                                         :workdir dir
                                                         :state-dir (cat a [dir "/state"])
                                                         :config-home (cat a [dir "/config"])
                                                         :cache-dir (cat a [dir "/cache"])
                                                         :config-path (cat a [dir "/opencode.json"])
                                                         :model "opencode/big-pickle"
                                                         :agent-name "factory-build"
                                                         :permission permission
                                                         :mcp mcp
                                                         :plugins (jv-array a)
                                                         :ready-file ""
                                                         :stop-tool "factory_finish"
                                                         :stop-tool-as "finish"
                                                         :idle-timeout-ms 0)
                                        recorder control))]
        (Fixture :dir dir :harness harness :recorder recorder :control control)))))

(defn script [(a (dyn Allocator))] (-> (ptr Script))
  (box! a Script (Script :cancel-at-ms 0 :message-on 0 :inbox-calls 0)))

;; ---------------------------------------------------------------------------
;; Tests

(deftest finishes-when-the-stop-tool-is-called-and-stops-the-process
  (let [a (malloc-allocator)
        f (fixture a "finish"
                   [(cat a [(step-start a) (text-event a "working") (bash-event a) (step-finish a "tool-calls")
                            (step-start a) (finish-event a) (step-finish a "tool-calls")
                            "sleep 20\necho never\n"])]
                   (script a))
        h (.harness f)
        started (sys/monotonic-ms)]
    (harness-add-system! h "You are a station.")
    (harness-add-user! h "Begin.")
    (match (harness-run! h)
      (Finished [call result]
                (do (assert (= (.name call) "finish"))
                    (assert (= (call-string call "summary") "did it"))
                    (assert (= result "Recorded."))))
      (_ (assert false)))
    (assert (< (- (sys/monotonic-ms) started) 8000))
    (let [r (.recorder f)
          argv (read a (cat a [(.dir f) "/argv.1"]))
          env (read a (cat a [(.dir f) "/env.1"]))
          config (read a (cat a [(.dir f) "/opencode.json"]))]
      (assert (saw? r "said working"))
      (assert (saw? r "tool $ ls"))
      (assert (saw? r "ok a.txt"))
      (assert (saw? r "tool finish: done"))
      (assert (saw? r "usage 150/25"))
      (assert (contains? argv "run\n--format\njson\n--auto\n--agent\nfactory-build\n"))
      (assert (contains? argv "-m\nopencode/big-pickle\n"))
      (assert (= (read a (cat a [(.dir f) "/stdin.1"])) "Begin."))
      (assert (contains? env (cat a ["PWD=" (.dir f) "\n"])))
      (assert (contains? env "OPENCODE_DISABLE_CLAUDE_CODE=1"))
      (assert (contains? env "OPENCODE_DISABLE_EXTERNAL_SKILLS=1"))
      (assert (not (contains? argv "-s\n")))
      (assert (contains? env (cat a ["XDG_DATA_HOME=" (.dir f) "/state"])))
      (assert (contains? env (cat a ["XDG_CONFIG_HOME=" (.dir f) "/config"])))
      (assert (contains? env (cat a ["OPENCODE_CONFIG=" (.dir f) "/opencode.json"])))
      (assert (contains? config "\"prompt\":\"You are a station.\""))
      (assert (contains? config "\"external_directory\":\"deny\"")))
    (assert (= (.session h) "ses_1"))))

(deftest continues-the-session-and-replies
  (let [a (malloc-allocator)
        f (fixture a "continue"
                   [(cat a [(step-start a) (finish-event a) (step-finish a "tool-calls")])
                    (cat a [(step-start a) (text-event a "all good") (step-finish a "stop")])]
                   (script a))
        h (.harness f)]
    (harness-add-system! h "sys")
    (harness-add-user! h "Begin.")
    (match (harness-run! h) (Finished [call result] 0) (_ (assert false)))
    (harness-add-user! h "The gate failed.")
    (match (harness-run! h)
      (Replied [text] (assert (= text "all good")))
      (_ (assert false)))
    (let [argv (read a (cat a [(.dir f) "/argv.2"]))]
      (assert (contains? argv "-s\nses_1\n"))
      (assert (= (read a (cat a [(.dir f) "/stdin.2"])) "The gate failed.")))))

(deftest a-checkpoint-restores-the-session
  (let [a (malloc-allocator)
        f (fixture a "checkpoint"
                   [(cat a [(step-start a) (text-event a "hello") (step-finish a "stop")])]
                   (script a))
        h (.harness f)]
    (harness-add-system! h "sys")
    (harness-add-user! h "Begin.")
    (harness-run! h)
    (harness-add-user! h "not yet sent")
    (let [saved (harness-checkpoint h a)
          g (fixture a "restored" ["exit 0\n"] (script a))
          restored (.harness g)]
      (assert (harness-restore! restored saved))
      (assert (= (.session restored) "ses_1"))
      (assert (= (.system restored) "sys"))
      (assert-eq (len (.pending restored)) 1)
      (assert (= (get (.pending restored) 0) "not yet sent"))
      (assert (not (harness-restore! restored "[]"))))))

(deftest a-message-interrupts-at-the-next-step-boundary
  (let [a (malloc-allocator)
        control (script a)
        _ (set! (.message-on control) 2)
        f (fixture a "steer"
                   [(cat a [(step-start a) "sleep 1\n" (bash-event a) (step-finish a "tool-calls") "sleep 20\n"])
                    (cat a [(step-start a) (finish-event a) (step-finish a "tool-calls")])]
                   control)
        h (.harness f)
        started (sys/monotonic-ms)]
    (harness-add-system! h "sys")
    (harness-add-user! h "Begin.")
    (match (harness-run! h) (Finished [call result] 0) (_ (assert false)))
    (assert (< (- (sys/monotonic-ms) started) 10000))
    (assert (saw? (.recorder f) "delivered use tabs"))
    (assert (contains? (read a (cat a [(.dir f) "/argv.2"])) "-s\nses_1\n"))
    (assert (= (read a (cat a [(.dir f) "/stdin.2"])) "[operator] use tabs"))))

(deftest cancellation-stops-a-running-agent
  (let [a (malloc-allocator)
        control (script a)
        f (fixture a "cancel" [(cat a [(step-start a) "sleep 30\n"])] control)
        h (.harness f)
        started (sys/monotonic-ms)]
    (set! (.cancel-at-ms control) (+ started 500))
    (harness-add-system! h "sys")
    (harness-add-user! h "Begin.")
    (match (harness-run! h) (Cancelled [] 0) (_ (assert false)))
    (assert (< (- (sys/monotonic-ms) started) 8000))))

(deftest errors-and-failed-exits-are-failures
  (let [a (malloc-allocator)
        f (fixture a "error"
                   [(cat a [(step-start a) (ev a "\"type\":\"error\",\"error\":{\"name\":\"APIError\",\"data\":{\"message\":\"Model is unavailable\"}}") "exit 1\n"])
                    "echo 'boom: no such column: name' >&2\nexit 3\n"]
                   (script a))
        h (.harness f)]
    (harness-add-system! h "sys")
    (harness-add-user! h "Begin.")
    (match (harness-run! h)
      (Failed [error] (do (assert (= (.kind error) "harness"))
                          (assert (= (.message error) "APIError: Model is unavailable"))))
      (_ (assert false)))
    (harness-add-user! h "again")
    (match (harness-run! h)
      (Failed [error] (assert (= (.message error) "opencode exited with status 3: boom: no such column: name")))
      (_ (assert false)))))

(deftest a-stop-tool-that-never-started-is-a-failure
  (let [a (malloc-allocator)
        f (fixture a "ready" [(cat a [(step-start a) (text-event a "done, I think") (step-finish a "stop")])] (script a))
        h (.harness f)]
    (set! (.ready-file (field h options)) (cat a [(.dir f) "/ready"]))
    (harness-add-system! h "sys")
    (harness-add-user! h "Begin.")
    (match (harness-run! h)
      (Failed [error] (assert (contains? (.message error) "never started in OpenCode")))
      (_ (assert false)))))
