(module mcp.client-test)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.fs" :as fs)
(import "coil.os" :as os)
(import "coil.primitive" :as primitive)
(import "coil.serde.value" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "agent.json" :use *)
(import "agent.tool" :use *)
(import "mcp.client" :use *)

(defn contains? [(hay (slice u8)) (needle (slice u8))] (-> bool)
  (match (find hay needle) (Some [at] true) (None [] false)))

;; A server written in sh: it answers initialize, lists its tools in two
;; pages (one with keywords json-schema cannot check), pings the client before
;; answering a call, echoes `text`, and exits on `quit`, saying why on stderr.
(const FAKE-SERVER "
while IFS= read -r line; do
  id=$(printf '%s' \"$line\" | sed -n 's/.*\"id\":\\([0-9][0-9]*\\).*/\\1/p')
  case \"$line\" in
    *'\"method\":\"initialize\"'*)
      printf '{\"jsonrpc\":\"2.0\",\"id\":%s,\"result\":{\"protocolVersion\":\"2025-06-18\",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"fake\",\"version\":\"1\"}}}\\n' \"$id\";;
    *'\"method\":\"tools/list\"'*'\"cursor\":\"two\"'*|*'\"cursor\":\"two\"'*'\"method\":\"tools/list\"'*)
      printf '{\"jsonrpc\":\"2.0\",\"id\":%s,\"result\":{\"tools\":[{\"name\":\"quit\",\"description\":\"Stop.\"}]}}\\n' \"$id\";;
    *'\"method\":\"tools/list\"'*)
      echo 'listing page one' >&2
      printf '{\"jsonrpc\":\"2.0\",\"id\":%s,\"result\":{\"nextCursor\":\"two\",\"tools\":[{\"name\":\"echo\",\"description\":\"Echo text.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\",\"minLength\":1}},\"required\":[\"text\"]}}]}}\\n' \"$id\";;
    *'\"name\":\"quit\"'*)
      echo 'quitting as asked' >&2
      exit 3;;
    *'\"method\":\"tools/call\"'*)
      printf '{\"jsonrpc\":\"2.0\",\"id\":\"s1\",\"method\":\"ping\"}\\n'
      IFS= read -r pong
      case \"$pong\" in *'\"result\"'*) ;; *) exit 9;; esac
      text=$(printf '%s' \"$line\" | sed -n 's/.*\"text\":\"\\([^\"]*\\)\".*/\\1/p')
      if [ \"$text\" = fail ]; then
        printf '{\"jsonrpc\":\"2.0\",\"id\":%s,\"result\":{\"isError\":true,\"content\":[{\"type\":\"text\",\"text\":\"it failed\"}]}}\\n' \"$id\"
      else
        printf '{\"jsonrpc\":\"2.0\",\"id\":%s,\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"echo: %s\"},{\"type\":\"image\",\"mimeType\":\"image/png\",\"data\":\"\"}]}}\\n' \"$id\" \"$text\"
      fi;;
    *) ;;
  esac
done
")

(defn server-file [(a (dyn Allocator))] (-> (slice u8))
  (let [(mut path) (StrBuf::new a)]
    (push-str! (mut path) "/tmp/mcp-client-test-")
    (push-i64! (mut path) (primitive/cast i64 (os/getpid)))
    (push-str! (mut path) ".sh")
    (let [file (finish! (mut path))]
      (match (fs/write-file a file FAKE-SERVER)
        (Ok [n] file)
        (Err [e] (do (assert false) file))))))

(defn never [(a (dyn Allocator))] (-> (dyn ToolContext))
  (box! a NeverCancelled (NeverCancelled :unused 0)))

(defn connected [(a (dyn Allocator))] (-> (ptr McpClient))
  (match (mcp-connect a ["/bin/sh" (server-file a)] "/" "fake" 10000 (never a))
    (Ok [client] client)
    (Err [message] (do (println "connect failed: {s}" message) (assert false) (connected a)))))

(deftest lists-tools-across-pages-and-calls-them
  (let [a (malloc-allocator)
        client (connected a)]
    (match (mcp-list-tools! client a 10000 (never a))
      (Err [message] (do (println "{s}" message) (assert false)))
      (Ok [tools]
          (do (assert-eq (len tools) 2)
              (assert (= (.name (get tools 0)) "echo"))
              (assert (contains? (.schema (get tools 0)) "minLength"))
              (assert (= (.name (get tools 1)) "quit"))
              ;; A tool with no input schema takes any object.
              (assert (= (.schema (get tools 1)) "{\"type\":\"object\"}")))))
    (let [arguments (jv-object a)]
      (jv-put! arguments "text" (JStr "hello"))
      (match (mcp-call-tool! client a "echo" arguments 10000 (never a))
        (Err [message] (do (println "{s}" message) (assert false)))
        (Ok [result] (do (assert (not (.is-error result)))
                         (assert (contains? (.text result) "echo: hello"))
                         (assert (contains? (.text result) "(image content, image/png")))))
      (jv-put! arguments "text" (JStr "fail"))
      (match (mcp-call-tool! client a "echo" arguments 10000 (never a))
        (Err [message] (assert false))
        (Ok [result] (do (assert (.is-error result)) (assert (= (.text result) "it failed"))))))
    (mcp-close! client)
    (mcp-close! client)))

(deftest a-server-that-exits-says-why
  (let [a (malloc-allocator)
        client (connected a)]
    (match (mcp-call-tool! client a "quit" (jv-object a) 10000 (never a))
      (Ok [result] (assert false))
      (Err [message] (do (assert (contains? message "the MCP server `fake` exited"))
                         (assert (contains? message "quitting as asked")))))
    (mcp-close! client)))

(deftest a-server-that-cannot-start-is-an-error
  (let [a (malloc-allocator)]
    (match (mcp-connect a ["/bin/sh" "-c" "echo no such server >&2; exit 127"] "/" "missing" 10000 (never a))
      (Ok [client] (assert false))
      (Err [message] (assert (contains? message "the MCP server `missing` exited: no such server"))))))

(defstruct CancelAfter [(checks i64)])

(impl ToolContext CancelAfter
  (tool-cancelled? [(self (ptr CancelAfter))] (-> bool)
                   (do (set! (.checks self) (+ (.checks self) 1)) (> (.checks self) 3))))

(deftest a-silent-server-times-out-or-is-cancelled
  (let [a (malloc-allocator)]
    (match (mcp-connect a ["/bin/sh" "-c" "sleep 30"] "/" "silent" 500 (never a))
      (Ok [client] (assert false))
      (Err [message] (assert (contains? message "did not answer initialize within"))))
    (match (mcp-connect a ["/bin/sh" "-c" "sleep 30"] "/" "silent" 60000 (box! a CancelAfter (CancelAfter :checks 0)))
      (Ok [client] (assert false))
      (Err [message] (assert (= message "cancelled"))))))
