(module sse.core)
(import "coil.primitive" :as primitive)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.match" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)

;;; Delivery is synchronous: returning false applies backpressure by aborting the
;;; decoder and, once connected to HTTP, the libcurl write callback.
(defstruct SseEvent
  [(name (slice u8))
   (data (slice u8))
   (id (slice u8))
   (id-present bool)
   (retry-ms i64)])

(deftrait SseEventSink [Self]
  (consume-sse-event [(self (ptr Self))
                      (event SseEvent)]
                     (-> bool)))

(defstruct SseBoundary [(found bool) (block-end i64) (consumed i64)])

(defstruct SseDecoder
  [(allocator (dyn Allocator))
   (buffer (ArrayList u8))
   (sink (dyn SseEventSink))
   (max-buffer-bytes i64)
   (last-id (ArrayList u8))
   (retry-ms i64)
   (pending-cr bool)
   (failed bool)])

(defn sse-decoder-new [(allocator (dyn Allocator))
                       (sink (dyn SseEventSink))
                       (max-buffer-bytes i64)] (-> SseDecoder)
  (let [decoder (primitive/alloc-stack SseDecoder)]
    (set! (.allocator decoder) allocator)
    (set! (.buffer decoder) (al-new [u8] allocator))
    (set! (.sink decoder) sink)
    (set! (.max-buffer-bytes decoder)
          (if (> max-buffer-bytes 0) max-buffer-bytes 1048576))
    (set! (.last-id decoder) (al-new [u8] allocator))
    (set! (.retry-ms decoder) -1)
    (set! (.pending-cr decoder) false)
    (set! (.failed decoder) false)
    (load decoder)))

(defn sse-boundary [(bytes (slice u8))] (-> SseBoundary)
  (let [result (primitive/alloc-stack SseBoundary)
        n (len bytes)
        (mut i) 0
        (mut last-was-newline) false
        (mut last-newline-index) -1]
    (set! (.found result) false)
    (loop (if (>= (load i) n)
              (break)
              (let [byte (cast i64 (get bytes (load i)))]
                (if (= byte 10)
                    (if (load last-was-newline)
                        (do
                          (set! (.found result) true)
                          (set! (.block-end result)
                                (if (and (> (load last-newline-index) 0)
                                         (= (cast i64
                                                  (get bytes
                                                       (- (load last-newline-index)
                                                          1)))
                                            13))
                                    (- (load last-newline-index) 1)
                                    (load last-newline-index)))
                          (set! (.consumed result) (+ (load i) 1))
                          (break))
                        (do
                          (set! last-was-newline true)
                          (set! last-newline-index (load i))
                          (set! i (+ (load i) 1))))
                    (do
                      (when (!= byte 13) (set! last-was-newline false) 0)
                      (set! i (+ (load i) 1)))))))
    (load result)))

(defn sse-field-value [(line (slice u8)) (prefix-len i64)] (-> (slice u8))
  (let [n (len line)
        start
          (if (and (< prefix-len n)
                   (= (cast i64 (get line prefix-len)) 32))
              (+ prefix-len 1)
              prefix-len)]
    (subslice [u8] line start n)))

(defn sse-dispatch-block [(decoder (ptr SseDecoder)) (frame (slice u8))] (-> bool)
  (let [(mut data) (sb-new (.allocator decoder))
        (mut event-name) ""
        (mut event-id) (al-slice [u8] (.last-id decoder))
        (mut id-seen) false
        (mut retry-ms) (.retry-ms decoder)
        (mut data-lines) 0
        n (len frame)
        (mut start) 0]
    (loop (if (> (load start) n)
              (break)
              (let [(mut end) (load start)]
                (loop (if (or (>= (load end) n)
                              (= (cast i64 (get frame (load end)))
                                 10))
                          (break)
                          (set! end (+ (load end) 1))))
                (let [trimmed-end
                        (if (and (> (load end) (load start))
                                 (= (cast i64
                                          (get frame (- (load end) 1)))
                                    13))
                            (- (load end) 1)
                            (load end))
                      line (subslice [u8] frame (load start) trimmed-end)]
                  (cond (starts-with line "data:")
                          (do
                            (when (> (load data-lines) 0)
                              (sb-push-str! (mut data) "\n")
                              0)
                            (sb-push-str! (mut data) (sse-field-value line 5))
                            (set! data-lines (+ (load data-lines) 1)))
                        (starts-with line "event:")
                          (set! event-name (sse-field-value line 6))
                        (starts-with line "id:")
                          (let [candidate (sse-field-value line 3)]
                            (when (not (sse-contains-byte? candidate 0))
                              (set! event-id candidate)
                              (set! id-seen true)
                              0))
                        (starts-with line "retry:")
                          (let [raw (sse-field-value line 6)
                                (mut value) 0
                                (mut valid) (> (len raw) 0)
                                (mut at) 0]
                            (loop (if (>= (load at) (len raw))
                                      (break)
                                      (let [digit
                                              (cast i64
                                                    (get raw (load at)))]
                                        (if (or (< digit 48)
                                                (> digit 57)
                                                (> (load value)
                                                   922337203685477580)
                                                (and (= (load value)
                                                        922337203685477580)
                                                     (> digit 55)))
                                            (do (set! valid false) (break))
                                            (do
                                              (set! value
                                                    (+ (* (load value) 10)
                                                       (- digit 48)))
                                              (set! at (+ (load at) 1)))))))
                            (when (load valid)
                              (set! retry-ms (load value))
                              (set! (.retry-ms decoder) (load value))
                              0))
                        :else 0))
                (if (>= (load end) n)
                    (break)
                    (set! start (+ (load end) 1))))))
    (when (load id-seen)
      (set! (.len (.last-id decoder)) 0)
      (al-extend! [u8]
                  (mut (.last-id decoder))
                  (slice-data [u8] (load event-id))
                  (len (load event-id)))
      0)
    (let [accepted
            (if (> (load data-lines) 0)
                (let [(mut event) (primitive/zeroed SseEvent)]
                  (set! (.name event) (load event-name))
                  (set! (.data event) (sb-str (load data)))
                  (set! (.id event) (al-slice [u8] (.last-id decoder)))
                  (set! (.id-present event) (load id-seen))
                  (set! (.retry-ms event) (load retry-ms))
                  (consume-sse-event (.sink decoder) (load event)))
                true)]
      (sb-free! (mut data))
      accepted)))

(defn sse-drop-prefix! [(buffer (mut (ArrayList u8))) (count i64)] (-> i64)
  (let [n (len (load buffer))
        remaining (- n count)
        (mut i) 0]
    (loop (if (>= (load i) remaining)
              (break)
              (do
                (set! (mut buffer)
                      (load i)
                      (get (load buffer) (+ count (load i))))
                (set! i (+ (load i) 1)))))
    (set! (.len buffer) remaining)
    remaining))

(defn sse-decoder-drain! [(decoder (ptr SseDecoder))] (-> bool)
  (let [boundary (sse-boundary (al-slice [u8] (.buffer decoder)))]
    (if (not (.found boundary))
        true
        (let [accepted
                (sse-dispatch-block decoder
                                    (subslice [u8]
                                              (al-slice [u8] (.buffer decoder))
                                              0
                                              (.block-end boundary)))]
          (sse-drop-prefix! (mut (.buffer decoder))
                            (.consumed boundary))
          (if accepted
              (sse-decoder-drain! decoder)
              (do (set! (.failed decoder) true) false))))))

;;; Accept an arbitrary transport chunk. Frames may span chunks or share one chunk.
;;; False is sticky and means either bounded-buffer overflow or downstream rejection.
(defn sse-decoder-feed! [(decoder (ptr SseDecoder)) (chunk (slice u8))] (-> bool)
  (if (.failed decoder)
      false
      (let [(mut at) 0
            n (len chunk)]
        (loop (if (or (>= (load at) n) (.failed decoder))
                  (break)
                  (let [byte (cast i64 (get chunk (load at)))
                        skip (and (.pending-cr decoder) (= byte 10))]
                    (set! (.pending-cr decoder) false)
                    (if skip
                        0
                        (let [normalized (if (= byte 13) 10 byte)]
                          (if (= byte 13) (set! (.pending-cr decoder) true) 0)
                          (push! [u8]
                                 (mut (.buffer decoder))
                                 (cast u8 normalized))
                          (if (> (len (.buffer decoder))
                                 (.max-buffer-bytes decoder))
                              (set! (.failed decoder) true)
                              (if (= normalized 10)
                                  (if (not (sse-decoder-drain! decoder))
                                      (set! (.failed decoder) true)
                                      0)
                                  0))))
                    (set! at (+ (load at) 1)))))
        (not (.failed decoder)))))

(defn sse-http-chunk [(data (ptr u8)) (length usize) (context (ptr i8))] (-> usize)
  (if (sse-decoder-feed! (cast (ptr SseDecoder) context)
                         (slice-new [u8] data (cast i64 length)))
      length
      (cast usize 0)))

(defn sse-decoder-failed? [(decoder (ptr SseDecoder))] (-> bool)
  (.failed decoder))

(defn sse-decoder-buffered-bytes [(decoder (ptr SseDecoder))] (-> i64)
  (len (.buffer decoder)))

(defn sse-decoder-retry-ms [(decoder (ptr SseDecoder))] (-> i64)
  (.retry-ms decoder))

(defn sse-decoder-last-id [(decoder (ptr SseDecoder))] (-> (slice u8))
  (al-slice [u8] (.last-id decoder)))

(defn sse-decoder-free! [(decoder (ptr SseDecoder))] (-> i64)
  (al-free! [u8] (mut (.buffer decoder)))
  (al-free! [u8] (mut (.last-id decoder))))

;;; Reject line separators in fields that must occupy one wire line.
(defn sse-contains-byte? [(value (slice u8)) (wanted i64)] (-> bool)
  (let [(mut at) 0
        (mut found) false]
    (loop (if (>= (load at) (len value))
              (break)
              (if (= (cast i64 (get value (load at))) wanted)
                  (do (set! found true) (break))
                  (set! at (+ (load at) 1)))))
    (load found)))

;;; Encode one event. `retry-ms = -1` omits the reconnect hint.
;;; The returned slice belongs to `allocator`.
(defn sse-encode [(allocator (dyn Allocator)) (event SseEvent)] (-> (slice u8))
  (if (or (sse-contains-byte? (.name event) 10)
          (sse-contains-byte? (.name event) 13)
          (sse-contains-byte? (.id event) 10)
          (sse-contains-byte? (.id event) 13)
          (sse-contains-byte? (.id event) 0))
      ""
      (let [(mut out) (sb-new allocator)
            (mut start) 0
            (mut at) 0
            data (.data event)
            length (len data)]
        (when (> (len (.name event)) 0)
          (sb-push-str! (mut out) "event: ")
          (sb-push-str! (mut out) (.name event))
          (sb-push-str! (mut out) "\n")
          0)
        (when (or (.id-present event) (> (len (.id event)) 0))
          (sb-push-str! (mut out) "id: ")
          (sb-push-str! (mut out) (.id event))
          (sb-push-str! (mut out) "\n")
          0)
        (when (>= (.retry-ms event) 0)
          (sb-push-str! (mut out) "retry: ")
          (sb-push-i64! (mut out) (.retry-ms event))
          (sb-push-str! (mut out) "\n")
          0)
        (loop (if (> (load at) length)
                  (break)
                  (if (or (= (load at) length)
                          (= (cast i64 (get data (load at))) 10))
                      (do
                        (sb-push-str! (mut out) "data: ")
                        (sb-push-str! (mut out)
                                      (subslice [u8]
                                                data
                                                (load start)
                                                (load at)))
                        (sb-push-str! (mut out) "\n")
                        (set! start (+ (load at) 1))
                        (set! at (+ (load at) 1)))
                      (set! at (+ (load at) 1)))))
        (sb-push-str! (mut out) "\n")
        (sb-finish! (mut out)))))
