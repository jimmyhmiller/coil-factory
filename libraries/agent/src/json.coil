(module agent.json)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.primitive" :as primitive)
(import "coil.serde.json" :use *)
(import "coil.serde.value" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "agent.fail" :use *)

;;; JSON values the agent keeps for the life of a conversation. Everything the
;;; model returns is parsed in a per-turn arena and copied here with `jv-clone`,
;;; so a long run does not retain every request body it ever encoded.

(defn copy-bytes [(a (dyn Allocator)) (bytes (slice u8))] (-> (slice u8))
  (if (= (len bytes) 0)
      ""
      (match (str-concat a "" bytes)
        (Some [owned] owned)
        (None [] (fail [(slice u8)] "agent.json: out of memory copying a string")))))

(defn jv-object [(a (dyn Allocator))] (-> JVal)
  (JObj (box! a
              (HashMap (slice u8) JVal)
              (hm-new [(slice u8) JVal] a (str-keyops-borrowed)))))

(defn jv-array [(a (dyn Allocator))] (-> JVal)
  (JArr (box! a (ArrayList JVal) (al-new [JVal] a))))

;;; Store `value` under `key`. The key is borrowed: pass a literal or a copy
;;; that lives as long as the object.
(defn jv-put! [(object JVal) (key (slice u8)) (value JVal)] (-> i64)
  (match object
    (JObj [map] (do (hm-put! map key value) 0))
    (_ (fail [i64] "agent.json: jv-put! on a value that is not an object"))))

(defn jv-push! [(array JVal) (value JVal)] (-> i64)
  (match array
    (JArr [items] (do (push! [JVal] items value) 0))
    (_ (fail [i64] "agent.json: jv-push! on a value that is not an array"))))

(defn jv-count [(array JVal)] (-> i64)
  (match array
    (JArr [items] (len items))
    (_ 0)))

;;; A deep copy whose strings and containers all live in `a`.
(defn jv-clone [(a (dyn Allocator)) (value JVal)] (-> JVal)
  (match value
    (JNull [] (JNull))
    (JBool [b] (JBool b))
    (JInt [n] (JInt n))
    (JFloat [x] (JFloat x))
    (JStr [s] (JStr (copy-bytes a s)))
    (JBytes [bs] (JBytes (copy-bytes a bs)))
    (JArr [items]
          (let [result (jv-array a)
                n (len items)
                (mut i) 0]
            (loop (if (>= (load i) n)
                      (break)
                      (do
                        (jv-push! result (jv-clone a (get items (load i))))
                        (set! i (+ (load i) 1)))))
            result))
    (JObj [map]
          (let [result (jv-object a)]
            (hm-for [k v map]
                    (jv-put! result (copy-bytes a k) (jv-clone a v)))
            result))))

(defn jv-encode [(a (dyn Allocator)) (value JVal)] (-> (slice u8))
  (match (to-json-str a value)
    (Ok [encoded] encoded)
    (Err [failure] (fail [(slice u8)] "agent.json: could not encode a JSON value"))))

(defn jv-parse [(a (dyn Allocator)) (text (slice u8))] (-> (Option JVal))
  (match (from-json [JVal] a text)
    (Ok [value] (Some value))
    (Err [failure] (None))))

(defn jv-string-or [(value JVal) (fallback (slice u8))] (-> (slice u8))
  (match value
    (JStr [s] s)
    (_ fallback)))

;;; `{"role": role, "content": text}` with the text copied into `a`.
(defn chat-message [(a (dyn Allocator)) (role (slice u8)) (text (slice u8))] (-> JVal)
  (let [message (jv-object a)]
    (jv-put! message "role" (JStr role))
    (jv-put! message "content" (JStr (copy-bytes a text)))
    message))
