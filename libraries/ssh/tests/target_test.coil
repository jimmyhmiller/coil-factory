(module ssh.target-test)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.str" :use *)
(import "ssh.target" :use *)

(defn parsed [(text (slice u8))] (-> Target)
  (match (parse-target text)
    (Ok [value] value)
    (Err [problem] (do (assert-eq problem "<parsed>") (target "" "" 0)))))

(defn problem-of [(text (slice u8))] (-> (slice u8))
  (match (parse-target text)
    (Ok [_] "<no error>")
    (Err [problem] problem)))

(deftest parses-plain-forms
         (let [host (parsed "box")
               user (parsed "jimmy@box.example.com")
               port (parsed "box:2222")
               both (parsed "deploy@10.0.0.5:22")]
           (assert-eq (.user host) "")
           (assert-eq (.host host) "box")
           (assert-eq (.port host) 0)
           (assert-eq (.user user) "jimmy")
           (assert-eq (.host user) "box.example.com")
           (assert-eq (.port port) 2222)
           (assert-eq (.host port) "box")
           (assert-eq (.user both) "deploy")
           (assert-eq (.host both) "10.0.0.5")
           (assert-eq (.port both) 22)))

(deftest parses-urls-and-ipv6
         (let [url (parsed "ssh://me@computer.jimmyhmiller.com:2200")
               bare-url (parsed "ssh://host/")
               v6 (parsed "[::1]:2222")
               v6-user (parsed "root@[fe80::1]")
               v6-bare (parsed "::1")
               v6-url (parsed "ssh://u@[2001:db8::7]:22")]
           (assert-eq (.user url) "me")
           (assert-eq (.host url) "computer.jimmyhmiller.com")
           (assert-eq (.port url) 2200)
           (assert-eq (.host bare-url) "host")
           (assert-eq (.port bare-url) 0)
           (assert-eq (.host v6) "::1")
           (assert-eq (.port v6) 2222)
           (assert-eq (.user v6-user) "root")
           (assert-eq (.host v6-user) "fe80::1")
           (assert-eq (.port v6-user) 0)
           (assert-eq (.host v6-bare) "::1")
           (assert-eq (.host v6-url) "2001:db8::7")
           (assert-eq (.port v6-url) 22)))

(deftest rejects-malformed-and-dangerous-targets
         (assert-eq (problem-of "") "the target is empty")
         (assert-eq (problem-of "@host") "the user before '@' is empty")
         (assert-eq (problem-of "user@") "the host is empty")
         (assert-eq (problem-of "a@b@c")
                    "the target contains more than one '@'")
         (assert-eq (problem-of "host:") "the port must be a number")
         (assert-eq (problem-of "host:ssh") "the port must be a number")
         (assert-eq (problem-of "host:0")
                    "the port must be between 1 and 65535")
         (assert-eq (problem-of "host:65536")
                    "the port must be between 1 and 65535")
         (assert-eq (problem-of "-oProxyCommand=touch /tmp/x")
                    "the host must not start with '-'")
         (assert-eq (problem-of "-oProxyCommand=x")
                    "the host must not start with '-'")
         (assert-eq (problem-of "-l@host") "the user must not start with '-'")
         (assert-eq (problem-of "my host")
                    "the host contains a character that is not allowed")
         (assert-eq (problem-of "host/path")
                    "the host contains a character that is not allowed")
         (assert-eq (problem-of "ssh://host/path")
                    "an ssh:// URL cannot have a path")
         (assert-eq (problem-of "ssh://::1")
                    "an IPv6 address in an ssh:// URL needs brackets")
         (assert-eq (problem-of "[::1")
                    "an IPv6 address is missing its closing ']'")
         (assert-eq (problem-of "[::1]x") "unexpected text after ']'"))

(deftest renders-targets
         (let [a (malloc-allocator)]
           (assert-eq (target-display a (parsed "box")) "box")
           (assert-eq (target-display a (parsed "me@box:2222")) "me@box:2222")
           (assert-eq (target-display a (parsed "[::1]:22")) "[::1]:22")
           (assert-eq (target-display a (parsed "::1")) "::1")
           (assert-eq (target-destination a (parsed "me@box:2222")) "me@box")
           (let [args (target-ssh-args a (parsed "me@box:2222"))]
             (assert-eq (len args) 3)
             (assert-eq (get args 0) "-p")
             (assert-eq (get args 1) "2222")
             (assert-eq (get args 2) "me@box"))
           (let [args (target-ssh-args a (parsed "box"))]
             (assert-eq (len args) 1)
             (assert-eq (get args 0) "box"))))
