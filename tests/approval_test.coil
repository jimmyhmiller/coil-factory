(module factory.approval-test)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.serde.value" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "agent.json" :use *)
(import "factory.approval" :use *)

(defn contains? [(hay (slice u8)) (needle (slice u8))] (-> bool)
  (match (find hay needle) (Some [at] true) (None [] false)))

(defn summary-of [(a (dyn Allocator)) (kind (slice u8)) (reply (slice u8))] (-> Summary)
  (match (parse-summary a kind reply)
    (Ok [s] s)
    (Err [why] (do (println "{s}" why) (assert false) (empty-summary)))))

(defn empty-summary [] (-> Summary)
  (Summary :title "" :summary "" :proposals (ArrayList::new [Proposal] (malloc-allocator)) :questions (ArrayList::new [Question] (malloc-allocator))))

(defn refusal [(a (dyn Allocator)) (kind (slice u8)) (reply (slice u8))] (-> (slice u8))
  (match (parse-summary a kind reply)
    (Ok [_] "")
    (Err [why] why)))

(const WHAT "In experiments/host_attachment.coil the program defines f returning 1 and caller calling f, opens a JIT session, and redefines f there to return 2; the program's own caller still returns 1 afterwards.")

(defn proposal-json [(a (dyn Allocator)) (title (slice u8)) (what (slice u8))] (-> (slice u8))
  (let [(mut out) (StrBuf::new a)]
    (push-str! (mut out) "{\"title\": \"")
    (push-str! (mut out) title)
    (push-str! (mut out) "\", \"what\": \"")
    (push-str! (mut out) what)
    (push-str! (mut out) "\", \"why\": \"It decides the design.\", \"if_approved\": \"It is treated as established.\", \"if_rejected\": \"The agent investigates further.\", \"evidence\": \"host-after=1\"}")
    (finish! (mut out))))

(defn reply-with [(a (dyn Allocator)) (proposals (slice u8)) (questions (slice u8))] (-> (slice u8))
  (let [(mut out) (StrBuf::new a)]
    (push-str! (mut out) "{\"title\": \"plan: host attachment\", \"summary\": \"It says X.\", \"proposals\": [")
    (push-str! (mut out) proposals)
    (push-str! (mut out) "], \"questions\": [")
    (push-str! (mut out) questions)
    (push-str! (mut out) "]}")
    (finish! (mut out))))

(deftest reads-a-self-contained-summary
  (let [a (malloc-allocator)
        s (summary-of a "station" (reply-with a (proposal-json a "A fresh JIT session cannot see the host's functions" WHAT)
                                              "{\"text\": \"Wait for Coil?\", \"context\": \"No API was found.\"}"))
        (mut p) (get (.proposals s) 0)
        (mut q) (get (.questions s) 0)]
    (assert (= (.title s) "plan: host attachment"))
    (assert (= (.title p) "A fresh JIT session cannot see the host's functions"))
    (assert (= (.why p) "It decides the design."))
    (assert (= (.if-rejected p) "The agent investigates further."))
    (assert (= (.context q) "No API was found."))))

(deftest refuses-what-cannot-be-decided-from-a-phone
  (let [a (malloc-allocator)]
    (assert (contains? (refusal a "station" "no json here") "not a JSON object"))
    (assert (contains? (refusal a "station" (reply-with a (proposal-json a "Accept the partial PLAN.md as a planning artifact" WHAT) ""))
                       "asks for approval instead of saying what is being approved"))
    (assert (contains? (refusal a "station" (reply-with a (proposal-json a "approve TARGET" WHAT) "")) "asks for approval"))
    (assert (contains? (refusal a "station" (reply-with a (proposal-json a "The plan is sound" "See PLAN.md.") ""))
                       "does not say enough in `what`"))
    (assert (contains? (refusal a "station" (reply-with a "{\"title\": \"t\", \"what\": \"" ""))
                       "is not a JSON object"))
    (assert (contains? (refusal a "station" (reply-with a (str-replace-why a (proposal-json a "The plan is sound" WHAT)) ""))
                       "has no `why`"))
    (assert (contains? (refusal a "question" (reply-with a "" "{\"text\": \"Which?\"}")) "has no `context`"))
    (assert (contains? (refusal a "station" (reply-with a "" "{\"text\": \"Which?\", \"context\": \"c\"}")) "no proposals for finished work"))
    (assert (contains? (refusal a "question" (reply-with a "" "")) "nothing to decide"))
    ;; A stopped agent may only ask.
    (assert (= (refusal a "question" (reply-with a "" "{\"text\": \"Which?\", \"context\": \"c\"}")) ""))))

(defn str-replace-why [(a (dyn Allocator)) (text (slice u8))] (-> (slice u8))
  (match (find text "\"why\": \"It decides the design.\"")
    (None [] text)
    (Some [at] (let [(mut out) (StrBuf::new a)]
                 (push-str! (mut out) (subslice text 0 at))
                 (push-str! (mut out) "\"why\": \"\"")
                 (push-str! (mut out) (subslice text (+ at 31) (len text)))
                 (finish! (mut out))))))

(deftest reads-a-summarizer
  (let [a (malloc-allocator)]
    (match (parse-summarizer a "---\nname: careful\nharness: codex\nmodel: gpt-6.1-sol\ntools: read\n---\n\nSummarize.\n")
      (SummarizerOk [s] (do (assert (= (.name s) "careful")) (assert (= (.harness s) "codex")) (assert (= (.instructions s) "Summarize."))))
      (SummarizerBad [_] (assert false)))
    (match (parse-summarizer a "---\nname: x\ntools: files\nverdicts: a, b\n---\n\nGo.\n")
      (SummarizerOk [_] (assert false))
      (SummarizerBad [problems] (assert-eq (len problems) 2)))))

(deftest a-decision-becomes-the-agents-next-instruction
  (let [a (malloc-allocator)
        request (match (jv-parse a "{\"proposals\": [{\"title\": \"Accept X\"}, {\"title\": \"Do not boot in JIT\"}], \"questions\": [{\"text\": \"Which category?\"}]}")
                  (Some [v] v) (None [] (do (assert false) (jv-object a))))
        decision (match (jv-parse a "{\"approved_all\": false, \"proposals\": [{\"approved\": true, \"comment\": \"\"}, {\"approved\": false, \"comment\": \"Show the probe first.\"}], \"answers\": [\"not-implemented\"], \"comment\": \"Good find.\"}")
                   (Some [v] v) (None [] (do (assert false) (jv-object a))))
        text (decision-message a request decision)]
    (assert (contains? text "1. APPROVED: Accept X"))
    (assert (contains? text "2. REJECTED: Do not boot in JIT\n   Jimmy: Show the probe first."))
    (assert (contains? text "Question: Which category?\nAnswer: not-implemented"))
    (assert (contains? text "Jimmy's note: Good find."))))

(deftest the-request-carries-the-summary-and-the-raw-material
  (let [a (malloc-allocator)
        s (summary-of a "station" (reply-with a (proposal-json a "p is done" WHAT) ""))
        (mut evidence) (ArrayList::new [Evidence] a)]
    (push! (mut evidence) (Evidence :name "The agent's own words" :content "I did it" :format "text"))
    (let [body (request-json a (RequestSource :site "laptop" :run "r-1" :station "plan" :kind "station" :round 2) s (load evidence))]
      (match (jv-parse a body)
        (None [] (assert false))
        (Some [o]
              (do (assert (= (jv-string-or (jv-get o "title") "") "plan: host attachment"))
                  (assert (= (jv-string-or (jv-get (jv-get o "source") "station") "") "plan"))
                  (assert-eq (jv-int (jv-get (jv-get o "source") "round")) 2)
                  (assert (= (jv-string-or (jv-get (jv-nth (jv-get o "evidence") 0) "content") "") "I did it"))
                  (assert (= (jv-string-or (jv-get (jv-nth (jv-get o "proposals") 0) "title") "") "p is done"))
                  (assert (= (jv-string-or (jv-get (jv-nth (jv-get o "proposals") 0) "if_approved") "") "It is treated as established."))))))))
