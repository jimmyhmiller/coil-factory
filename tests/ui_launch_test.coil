(module factory.ui-launch-test)
(import "coil.alloc" :use *)
(import "coil.slice" :use *)
(import "coil.serde.value" :use *)
(import "agent.json" :use [jv-string-or])
(import "tui.canvas" :use *)
(import "tui.keys" :use *)
(import "tui.widgets" :use *)
(import "factory.ui.launch" :use *)

(deftest composer-preserves-fields-and-encodes-a-run-request
  (let [a (malloc-allocator)
        (mut form) (launch-new a)]
    (assert (> (len (launch-problem (mut form))) 0))
    (launch-key! (mut form) (Paste "feature"))
    (launch-key! (mut form) (Tab))
    (launch-key! (mut form) (Paste "Build a \"nice\" app\nwith tests"))
    (assert (= (launch-problem (mut form)) ""))
    (assert (= (jv-string-or (jv-get (launch-body a (mut form)) "factory") "")
               "feature"))
    (launch-key! (mut form) (BackTab))
    (assert-eq (.focus form) 0)
    (launch-key! (mut form) (BackTab))
    (assert-eq (.focus form) 7)
    (input-set-text! (index (field (mut form) fields) 4) "invalid")
    (assert (> (len (launch-problem (mut form))) 0))
    (input-set-text! (index (field (mut form) fields) 4) "codex")
    (assert (= (launch-problem (mut form)) ""))
    (for size (iter [0 1 4 20 100])
      (let [(mut c) (canvas-new a size size)]
        (draw-launch! (mut form) (mut c) (theme-default))
        (canvas-free! (mut c))))
    (launch-free! (mut form))))
