(module factory.runstate-test)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.serde.value" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "agent.json" :use *)
(import "factory.events" :use *)
(import "factory.runstate" :use *)

(defn fold-lines! [(st (ptr RunState)) (lines (slice (slice u8)))] (-> i64)
  (let [(mut offset) 0]
    (for line (iter lines)
      (let [next (+ (load offset) (+ (len line) 1))]
        (match (jv-parse (malloc-allocator) line)
          (Some [record] (fold-record! st (load offset) next record))
          (None [] (assert false)))
        (set! offset next)))
    (load offset)))

(deftest folds-a-run-through-stations-gates-messages-and-findings
  (let [a (malloc-allocator)
        (mut st) (runstate-new a "fixer-7f3a")
        created "{\"t\":1000,\"kind\":\"run.created\",\"factory\":\"fixer\",\"site\":\"laptop\",\"project\":\"/p\",\"branch\":\"factory/fixer-7f3a\",\"model\":\"deepseek/deepseek-v4-flash\",\"brief\":\"Wrap the snake\\nat walls\",\"stations\":[\"implement\",\"review\"]}"]
    (fold-lines! (mut st)
                 [created
                  "{\"t\":1100,\"kind\":\"run.started\",\"base\":\"abc123\"}"
                  "{\"t\":1200,\"kind\":\"station.started\",\"agent\":\"implement\"}"
                  "{\"t\":1300,\"kind\":\"agent.turn\",\"agent\":\"implement\",\"turn\":1}"
                  "{\"t\":1310,\"kind\":\"agent.usage\",\"agent\":\"implement\",\"input\":100,\"output\":20}"
                  "{\"t\":1400,\"kind\":\"tool.started\",\"agent\":\"implement\",\"call\":\"c1\",\"tool\":\"shell\",\"summary\":\"$ coil test\"}"])
    (assert (= (.status st) "running"))
    (assert (= (.current st) "implement"))
    (assert (= (.brief st) "Wrap the snake"))
    (assert-eq (len (.stations st)) 2)
    (let [agent (agent-at (mut st) "implement")]
      (assert (= (.phase agent) "tool"))
      (assert (= (.activity agent) "$ coil test"))
      (assert-eq (.input-tokens agent) 100))
    ;; An operator message is pending until the agent receives it.
    (let [(mut next) 0]
      (fold-record! (mut st) 5000 5100
                    (match (jv-parse a "{\"t\":1500,\"kind\":\"message.sent\",\"agent\":\"implement\",\"from\":\"operator\",\"text\":\"keep it small\"}")
                      (Some [r] r) (None [] (JNull))))
      (assert-eq (len (.pending st)) 1)
      (fold-record! (mut st) 5100 5200
                    (match (jv-parse a "{\"t\":1600,\"kind\":\"message.received\",\"agent\":\"implement\",\"ref\":5000,\"text\":\"keep it small\"}")
                      (Some [r] r) (None [] (JNull))))
      (assert-eq (len (.pending st)) 0)
      (assert (= (.activity (agent-at (mut st) "implement")) "✉ keep it small"))
      (set! next 0))
    (fold-lines! (mut st)
                 ["{\"t\":1700,\"kind\":\"gate.started\",\"agent\":\"implement\",\"command\":\"coil test\"}"
                  "{\"t\":1800,\"kind\":\"gate.finished\",\"agent\":\"implement\",\"ok\":false,\"exit\":1}"
                  "{\"t\":1900,\"kind\":\"finding\",\"agent\":\"implement\",\"severity\":\"warn\",\"code\":\"looping\",\"message\":\"same test 4x\"}"
                  "{\"t\":2000,\"kind\":\"control\",\"action\":\"pause\"}"])
    (assert (= (.status st) "paused"))
    (let [station (station-at (mut st) "implement")]
      (assert (= (.status station) "running"))
      (assert-eq (.gate-failures station) 1))
    (assert-eq (len (.findings st)) 1)
    (fold-lines! (mut st)
                 ["{\"t\":2100,\"kind\":\"control\",\"action\":\"resume\"}"
                  "{\"t\":2200,\"kind\":\"station.finished\",\"agent\":\"implement\",\"outcome\":\"passed\",\"summary\":\"Wrapped at walls.\"}"
                  "{\"t\":2300,\"kind\":\"run.finished\",\"status\":\"succeeded\",\"reason\":\"\"}"])
    (assert (= (.status st) "succeeded"))
    (assert (= (.summary (station-at (mut st) "implement")) "Wrapped at walls."))
    (assert (= (.phase (agent-at (mut st) "implement")) "done"))
    (let [json (jv-encode a (runstate-json a (mut st)))]
      (match (str-find json "\"status\":\"succeeded\"")
        (Some [at] 0)
        (None [] (assert false))))))

(deftest previews-cut-on-utf8-boundaries
  (let [a (malloc-allocator)]
    (assert (= (preview a "hello" 10) "hello"))
    (assert (= (preview a "hello world" 5) "hello…"))
    ;; "é" is two bytes; cutting inside it backs off to before it.
    (assert (= (preview a "aé" 2) "a…"))
    (assert (= (first-line a "\n\n  first line  \nsecond" 100) "first line"))))

(deftest folds-each-reviewer-separately
  (let [a (malloc-allocator)
        (mut st) (runstate-new a "free-1a2b")]
    (fold-lines! (mut st)
                 ["{\"t\":1000,\"kind\":\"run.created\",\"factory\":\"free\",\"stations\":[\"build\"],\"reviewers\":[\"judge\",\"security\"]}"
                  "{\"t\":2000,\"kind\":\"oversight\",\"agent\":\"build\",\"reviewer\":\"judge\",\"verdict\":\"drifting\",\"level\":\"warn\",\"reason\":\"off brief\"}"
                  "{\"t\":2100,\"kind\":\"oversight.failed\",\"reviewer\":\"security\",\"message\":\"the model failed (provider): 403\"}"
                  "{\"t\":2200,\"kind\":\"finding\",\"agent\":\"build\",\"severity\":\"warn\",\"code\":\"drifting\",\"reviewer\":\"judge\",\"message\":\"off brief\"}"])
    (assert-eq (len (.reviewers st)) 2)
    (let [judge (reviewer-at (mut st) "judge")
          security (reviewer-at (mut st) "security")]
      (assert (= (.verdict judge) "drifting"))
      (assert (= (.level judge) "warn"))
      (assert (= (.reason judge) "off brief"))
      (assert (= (.verdict security) ""))
      (assert (= (.failure security) "the model failed (provider): 403"))
      (assert-eq (.failure-t security) 2100))
    (assert (= (.reviewer (get (.findings st) 0)) "judge"))
    ;; A later verdict clears the failure.
    (fold-lines! (mut st) ["{\"t\":3000,\"kind\":\"oversight\",\"agent\":\"build\",\"reviewer\":\"security\",\"verdict\":\"clean\",\"level\":\"ok\",\"reason\":\"nothing leaks\"}"])
    (assert (= (.failure (reviewer-at (mut st) "security")) ""))))

(deftest reads-oversight-from-before-reviewers
  (let [a (malloc-allocator)
        (mut st) (runstate-new a "old-0000")]
    (fold-lines! (mut st)
                 ["{\"t\":1000,\"kind\":\"run.created\",\"factory\":\"old\",\"stations\":[\"build\"]}"
                  "{\"t\":2000,\"kind\":\"oversight\",\"agent\":\"build\",\"verdict\":\"cheating\",\"reason\":\"stubbed\"}"])
    (let [judge (reviewer-at (mut st) "judge")]
      (assert (= (.verdict judge) "cheating"))
      (assert (= (.level judge) "alert")))))

(deftest folds-station-reviews
  (let [a (malloc-allocator)
        (mut st) (runstate-new a "r-1")]
    (fold-lines! (mut st)
                 ["{\"t\":1000,\"kind\":\"station.started\",\"agent\":\"build\"}"
                  "{\"t\":1100,\"kind\":\"review.started\",\"agent\":\"build\",\"reviewers\":\"rules, spec\",\"round\":1}"])
    (let [station (station-at (mut st) "build")
          agent (agent-at (mut st) "build")]
      (assert (= (.status station) "review"))
      (assert (contains? (.activity agent) "rules, spec")))
    (fold-lines! (mut st)
                 ["{\"t\":1200,\"kind\":\"review.verdict\",\"agent\":\"build\",\"reviewer\":\"rules\",\"verdict\":\"violates\",\"level\":\"alert\"}"
                  "{\"t\":1300,\"kind\":\"review.round\",\"agent\":\"build\",\"round\":1,\"approved\":false}"])
    (let [station (station-at (mut st) "build")]
      (assert (= (.status station) "running"))
      (assert-eq (.review-rejections station) 1))
    (fold-lines! (mut st)
                 ["{\"t\":1400,\"kind\":\"review.round\",\"agent\":\"build\",\"round\":2,\"approved\":true}"])
    (assert-eq (.review-rejections (station-at (mut st) "build")) 1)))

(defn contains? [(hay (slice u8)) (needle (slice u8))] (-> bool)
  (match (str-find hay needle) (Some [at] true) (None [] false)))
