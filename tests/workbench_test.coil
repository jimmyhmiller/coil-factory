(module factory.workbench-test)
(import "coil.alloc" :use *)
(import "coil.slice" :use *)
(import "tui.keys" :use *)
(import "tui.widgets" :use *)
(import "tui.app" :use [app-snapshot])
(import "factory.client" :use [Hub])
(import "factory.client" :as client)
(import "factory.session" :as session)
(import "factory.ui.store" :use *)
(import "agent.json" :use *)
(import "coil.serde.value" :use *)
(import "factory.ui.model" :use *)
(import "factory.ui.dashboard" :use *)
(import "factory.ui.chat" :use [chat-open!])
(import "factory.ui.workbench" :as workbench)
(import "factory.ui.network" :as network)
(import "factory.ui-views-test" :use [str-contains?])
(import "agent.loop" :use [sleep-ms])
(import "factory.session-test" :use [fresh-home])
(import "factory.sidebar" :as context)
(import "factory.sidebar-test" :use [json ok])

(defn standalone [(a (dyn Allocator)) (tag (slice u8))] (-> (ptr Dash))
  (let [d (box! a Dash (zeroed Dash))]
    (dash-init! d a (Hub :base-url "http://127.0.0.1:1" :token ""))
    (workbench/init! (field d workbench) a (fresh-home a tag))
    (new-personal! d)
    d))

(deftest standalone-opens-without-a-hub-and-preserves-draft-across-factory-view
  (let [a (malloc-allocator)
        d (standalone a "draft")]
    (assert (str-contains? (app-snapshot d 120 30 0 a)
                           "What would you like to work on?"))
    (dashboard-key! d (Paste "Build something useful"))
    (dashboard-key! d (Ctrl #\f))
    (assert (match (.view d) (ViewOverview [] true) (_ false)))
    (dashboard-key! d (Ctrl #\f))
    (assert (match (.view d) (ViewPersonal [] true) (_ false)))
    (assert (= (input-text (field (field d personal) input))
               "Build something useful"))
    (dashboard-key! d (Ctrl #\g))
    (assert (.settings-open (.workbench d)))
    (dashboard-key! d (Escape))
    (assert (not (.settings-open (.workbench d))))))

(deftest connection-token-is-masked-and-small-terminals-render
  (let [a (malloc-allocator)
        d (standalone a "mask")
        w (field d workbench)]
    (input-set-text! (index (field w connection) 1)
                     "do-not-display-this-secret")
    (dashboard-key! d (Ctrl #\k))
    (let [screen (app-snapshot d 110 32 0 a)]
      (assert (str-contains? screen "Factory connections"))
      (assert (str-contains? screen "********"))
      (assert (not (str-contains? screen "do-not-display-this-secret"))))
    (for size (iter [0 1 4 20 50])
      (app-snapshot d size size 0 a))
    (dashboard-key! d (Escape))
    (dashboard-key! d (Ctrl #\g))
    (for size (iter [0 1 4 20 50])
      (app-snapshot d size size 0 a))))

(deftest failed-background-connection-does-not-take-over-conversation
  (let [a (malloc-allocator)
        d (standalone a "async")
        w (field d workbench)]
    (input-set-text! (index (field w connection) 0) "http://127.0.0.1:1")
    (input-set-text! (index (field w connection) 2) "Offline test factory")
    (connect! d 1)
    (dashboard-key! d (Paste "still typing while connecting"))
    (assert (= (input-text (field (field d personal) input))
               "still typing while connecting"))
    (let [(mut attempts) 0]
      (loop (when (or (network/ready? (.job w)) (> (load attempts) 400))
              (break))
        (sleep-ms 10)
        (set! attempts (+ (load attempts) 1))))
    (assert (network/ready? (.job w)))
    (poll-network! d)
    (assert (= (cast i64 (.job w)) 0))
    (assert (not (.connected w)))
    (assert (match (.view d) (ViewPersonal [] true) (_ false)))
    (assert (= (input-text (field (field d personal) input))
               "still typing while connecting"))))

(deftest applying-a-connection-preserves-personal-session-and-saves-the-profile
  (let [a (malloc-allocator)
        d (standalone a "profile")
        w (field d workbench)
        job
          (network/start a
                         1
                         (.home w)
                         (Hub
                           :base-url "http://127.0.0.1:1"
                           :token "saved-token")
                         "http://127.0.0.1:1"
                         "Test computer")]
    (let [(mut attempts) 0]
      (loop (when (or (network/ready? job) (> (load attempts) 400)) (break))
        (sleep-ms 10)
        (set! attempts (+ (load attempts) 1))))
    (assert (network/ready? job))
    ;; Exercise result application separately from transport and credentials.
    (set! (.reply job)
          (client/ReplyOk
            :status 200
            :body (jv-object a)
            :text "{}"))
    (set! (.job w) job)
    (own! d (field w session-id) "0123456789abcdef01234567")
    (dashboard-key! d (Paste "my draft"))
    (poll-network! d)
    (assert (.connected w))
    (assert (match (.view d) (ViewPersonal [] true) (_ false)))
    (assert (= (.session-id w) "0123456789abcdef01234567"))
    (assert (= (input-text (field (field d personal) input)) "my draft"))
    (assert (= (.connection-name w) "Test computer"))
    (let [(mut reloaded) (zeroed workbench/Workbench)]
      (workbench/init! (mut reloaded) a (.home w))
      (let [profile (jv-nth (.value (.profiles reloaded)) 0)]
        (assert (= (session/str profile "name") "Test computer"))
        (assert (= (session/str profile "token") "saved-token"))))
    (network/close! a (.active-connection w))
    (set! (.active-connection w) (cast (ptr network/Job) 0))))

(deftest slash-commands-reveal-shortcuts-only-while-discovering-an-action
  (let [a (malloc-allocator)
        d (standalone a "slash")]
    (let [screen (app-snapshot d 110 32 0 a)]
      (assert (not (str-contains? screen "ctrl-")))
      (assert (not (str-contains? screen "Ctrl-"))))
    (dashboard-key! d (Char #\/))
    (dashboard-key! d (Paste "settings"))
    (assert (.commands-open d))
    (assert (= (input-text (field (field d personal) input)) ""))
    (let [screen (app-snapshot d 110 32 0 a)]
      (assert (str-contains? screen "/settings"))
      (let [footer " /settings · Ctrl-G\n"]
        (assert (= (subslice screen (- (len screen) (len footer)) (len screen))
                   footer))))
    (for size (iter [0 1 4 20]) (app-snapshot d size size 0 a))
    (dashboard-key! d (Enter))
    (assert (.settings-open (.workbench d)))
    (assert (not (.commands-open d)))
    (dashboard-key! d (Escape))))

(deftest slash-navigation-preserves-drafts-and-leaves-message-slashes-alone
  (let [a (malloc-allocator)
        d (standalone a "slash-draft")]
    (dashboard-key! d (Paste "keep this draft"))
    (dashboard-key! d (Ctrl #\p))
    (dashboard-key! d (Paste "factory"))
    (dashboard-key! d (Enter))
    (assert (match (.view d) (ViewOverview [] true) (_ false)))
    (dashboard-key! d (Paste "/chat"))
    (dashboard-key! d (Enter))
    (assert (match (.view d) (ViewPersonal [] true) (_ false)))
    (assert (= (input-text (field (field d personal) input)) "keep this draft"))
    (dashboard-key! d (Char #\/))
    (assert (not (.commands-open d)))
    (assert (= (input-text (field (field d personal) input)) "keep this draft/"))))

(deftest unknown-slash-command-does-not-send-a-message-and-forms-can-search-commands
  (let [a (malloc-allocator)
        d (standalone a "slash-unknown")]
    (dashboard-key! d (Paste "/not-a-command"))
    (dashboard-key! d (Enter))
    (assert (.commands-open d))
    (assert (= (.session-id (.workbench d)) ""))
    (assert (str-contains? (app-snapshot d 100 28 0 a) "No matching commands"))
    (dashboard-key! d (Escape))
    (dashboard-key! d (Paste "/run"))
    (dashboard-key! d (Enter))
    (assert (.launch-open d))
    (dashboard-key! d (Ctrl #\p))
    (dashboard-key! d (Paste "start"))
    (assert (str-contains? (app-snapshot d 100 28 0 a) "/start · Ctrl-S"))
    (dashboard-key! d (Escape))
    (assert (.launch-open d))
    (dashboard-key! d (Ctrl #\p))
    (dashboard-key! d (Paste "factory"))
    (dashboard-key! d (Enter))
    (assert (not (.launch-open d)))
    (assert (match (.view d) (ViewOverview [] true) (_ false)))))

(deftest stop-confirmation-can-be-dismissed-with-a-slash-command
  (let [a (malloc-allocator)
        d (standalone a "slash-confirm")]
    (set! (.confirm-stop d) true)
    (dashboard-key! d (Paste "/dismiss"))
    (assert (.commands-open d))
    (assert (str-contains? (app-snapshot d 100 28 0 a) "/dismiss · Esc"))
    (dashboard-key! d (Enter))
    (assert (not (.confirm-stop d)))
    (assert (not (.commands-open d)))))

(deftest context-sidebar-updates-live-persists-and-never-leaks-across-conversations
  (let [a (malloc-allocator)
        d (standalone a "context-board")
        w (field d workbench)
        id
          (match (session/create! a
                                  (.home w)
                                  "claude"
                                  "haiku"
                                  (.home w)
                                  "Benchmark session")
            (Ok [id] id)
            (_ (do (assert false) "")))
        root (session/path a (.home w) id "")]
    (ok (context/update! a
                         root
                         "assistant"
                         2
                         (json a
                               "{\"section\":\"results\",\"title\":\"Benchmark\",\"items\":[{\"id\":\"latest\",\"text\":\"42 ms\"}]}")))
    (set! (.now d) 1000)
    (open-personal! d id)
    (dashboard-key! d (Paste "my draft"))
    (let [screen (app-snapshot d 120 30 0 a)]
      (assert (str-contains? screen "Context"))
      (assert (str-contains? screen "Benchmark"))
      (assert (str-contains? screen "42 ms")))
    (ok (context/update! a
                         root
                         "assistant"
                         3
                         (json a
                               "{\"section\":\"results\",\"id\":\"latest\",\"text\":\"31 ms\",\"status\":\"done\"}")))
    (set! (.now d) 1400)
    (poll-personal! d)
    (assert (str-contains? (app-snapshot d 120 30 0 a) "31 ms"))
    (assert (= (input-text (field (field d personal) input)) "my draft"))
    (new-personal! d)
    (assert (not (str-contains? (app-snapshot d 120 30 0 a) "31 ms")))
    (set! (.now d) 1800)
    (open-personal! d id)
    (assert (str-contains? (app-snapshot d 120 30 0 a) "31 ms"))
    (dashboard-key! d (Paste "/history"))
    (dashboard-key! d (Enter))
    (assert (str-contains? (app-snapshot d 80 24 0 a) "Benchmark session"))
    (dashboard-key! d (Escape))
    (dashboard-key! d (Paste "/sidebar"))
    (dashboard-key! d (Enter))
    (assert (.sidebar-focus w))
    (for size (iter [0 1 4 20 40]) (app-snapshot d size size 0 a))
    (assert (str-contains? (app-snapshot d 40 20 0 a) "31 ms"))
    (dashboard-key! d (Escape))
    (assert (not (.sidebar-focus w)))
    (dashboard-key! d (Paste "/sidebar-hide"))
    (dashboard-key! d (Enter))
    (assert (not (.sidebar-visible w)))))

(deftest remote-sidebar-results-ignore-old-agents-and-preserve-last-board-on-failure
  (let [a (malloc-allocator)
        d (standalone a "context-remote")
        w (field d workbench)
        job (box! a network/Job (zeroed network/Job))
        doc
          (json a
                "{\"version\":1,\"revision\":2,\"sections\":[{\"id\":\"bench\",\"title\":\"Latest\",\"items\":[{\"id\":\"result\",\"text\":\"31 ms\"}]}]}")]
    (chat-open! (field d chat) "run-123" "assistant")
    (set! (.view d) (ViewChat))
    (set! (.name job) "run-123/assistant")
    (set! (.hub job) (.hub d))
    (set! (.reply job)
          (client/ReplyOk
            :status 200
            :body doc
            :text ""))
    (apply-sidebar! d job)
    (assert-eq (jv-int (jv-get (.value (.sidebar w)) "revision")) 2)
    (set! (.name job) "other-run/assistant")
    (set! (.reply job)
          (client/ReplyOk
            :status 200
            :body (jv-object a)
            :text ""))
    (apply-sidebar! d job)
    (assert-eq (jv-int (jv-get (.value (.sidebar w)) "revision")) 2)
    (set! (.name job) "run-123/assistant")
    (set! (.reply job) (client/ReplyFailed "offline"))
    (apply-sidebar! d job)
    (assert-eq (jv-int (jv-get (.value (.sidebar w)) "revision")) 2)
    (assert (str-contains? (app-snapshot d 110 30 0 a) "31 ms"))
    (assert (> (len (context/text (.value (.sidebar w)) "error")) 0))))
