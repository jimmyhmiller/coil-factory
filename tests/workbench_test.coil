(defn standalone [(a (dyn Allocator)) (tag (slice u8))] (-> (ptr Dash))
  (let [d (box! a Dash (zeroed Dash))]
    (dash-init! d a (Hub :base-url "http://127.0.0.1:1" :token ""))
    (workbench/init! (field d workbench) a (fresh-home a tag))
    (new-personal! d)
    d))

(deftest standalone-opens-without-a-hub-and-preserves-draft-across-factory-view
  (let [a (malloc-allocator)
        d (standalone a "draft")]
    (assert (str-contains? (app-snapshot d 120 30 0 a)
                           (workbench/value (field d workbench) 0)))
    (dashboard-key! d (Paste "Build something useful"))
    (dashboard-key! d (Ctrl #\f))
    (assert (match (.view d) (ViewOverview [] true) (_ false)))
    (dashboard-key! d (Ctrl #\f))
    (assert (match (.view d) (ViewPersonal [] true) (_ false)))
    (assert (= (input-text (field (field d personal) input))
               "Build something useful"))
    (dashboard-key! d (Ctrl #\g))
    (assert (.settings-open (.workbench d)))
    (dashboard-key! d (Escape))
    (assert (not (.settings-open (.workbench d))))))

(deftest ctrl-k-edits-the-composer-instead-of-opening-connections
  (let [a (malloc-allocator)
        d (standalone a "kill-line")
        input (field (field d personal) input)]
    (dashboard-key! d (Paste "keep remove\nnext"))
    (set! (.cursor input) 5)
    (dashboard-key! d (Ctrl #\k))
    (assert (= (input-text input) "keep \nnext"))
    (assert (= (.cursor input) 5))
    (dashboard-key! d (Ctrl #\k))
    (assert (= (input-text input) "keep next"))
    (dashboard-key! d (End))
    (dashboard-key! d (Ctrl #\k))
    (assert (= (input-text input) "keep next"))
    (assert (not (.connections-open (.workbench d))))))

(defn model-options! [(d (ptr Dash))] (-> i64)
  (let [w (field d workbench)
        a (snap-spare (field w model-options))
        options (jv-array a)]
    (catalog/add! a options "claude" "haiku" "Test Haiku")
    (catalog/add! a options "codex" "test-codex" "Test Codex")
    (snap-commit! (field w model-options) options 0)
    0))

(deftest model-command-picks-a-model-and-its-harness-without-clearing-the-draft
  (let [a (malloc-allocator)
        d (standalone a "model-command")
        w (field d workbench)]
    (dashboard-key! d (Paste "/model"))
    (dashboard-key! d (Enter))
    (assert (.models-open w))
    (assert (not (.settings-open w)))
    (model-options! d)
    (dashboard-key! d (Paste "Test Codex"))
    (let [screen (app-snapshot d 110 32 0 a)]
      (assert (str-contains? screen "Test Codex"))
      (assert (str-contains? screen "codex")))
    (dashboard-key! d (Enter))
    (assert (not (.models-open w)))
    (assert (= (workbench/value w 1) "codex"))
    (assert (= (workbench/value w 2) "test-codex"))
    (assert (= (.session-id w) ""))
    (dashboard-key! d (Paste "keep my draft"))
    (dashboard-key! d (Ctrl #\p))
    (dashboard-key! d (Paste "model"))
    (dashboard-key! d (Enter))
    (assert (.models-open w))
    (for size (iter [0 1 4 20 40]) (app-snapshot d size size 0 a))
    (dashboard-key! d (Escape))
    (assert (= (input-text (field (field d personal) input)) "keep my draft"))
    (assert (= (workbench/value w 2) "test-codex"))
    (catalog/close! a (.model-job w))))

(deftest model-selection-updates-the-existing-conversation-and-keeps-context
  (let [a (malloc-allocator)
        d (standalone a "model-existing")
        w (field d workbench)
        id
          (match (session/create! a
                                  (.home w)
                                  "claude"
                                  "haiku"
                                  (.home w)
                                  "Existing")
            (Ok [id] id)
            (_ (do (assert false) "")))]
    (ok (context/update! a
                         (session/path a (.home w) id "")
                         "assistant"
                         2
                         (json a
                               "{\"section\":\"notes\",\"title\":\"Keep this context\",\"items\":[]}")))
    (set! (.now d) 1000)
    (open-personal! d id)
    (dashboard-key! d (Paste "unsent draft"))
    (dashboard-key! d (Ctrl #\p))
    (dashboard-key! d (Paste "model"))
    (dashboard-key! d (Enter))
    (model-options! d)
    (dashboard-key! d (Paste "Test Codex"))
    (dashboard-key! d (Enter))
    (assert (= (.session-id w) id))
    (assert (= (session/str (session/info a (.home w) id) "harness") "codex"))
    (assert (= (session/str (session/info a (.home w) id) "model") "test-codex"))
    (assert (= (input-text (field (field d personal) input)) "unsent draft"))
    (assert (= (jv-count (session/list-sessions a (.home w))) 1))
    (open-personal! d id)
    (assert (str-contains? (app-snapshot d 120 30 0 a) "Keep this context"))
    (catalog/close! a (.model-job w))))

(deftest connection-token-is-masked-and-small-terminals-render
  (let [a (malloc-allocator)
        d (standalone a "mask")
        w (field d workbench)]
    (input-set-text! (index (field w connection) 1)
                     "do-not-display-this-secret")
    (dashboard-key! d (Paste "/connect"))
    (dashboard-key! d (Enter))
    (let [screen (app-snapshot d 110 32 0 a)]
      (assert (str-contains? screen "Factory connections"))
      (assert (str-contains? screen "********"))
      (assert (not (str-contains? screen "do-not-display-this-secret"))))
    (for size (iter [0 1 4 20 50])
      (app-snapshot d size size 0 a))
    (dashboard-key! d (Escape))
    (dashboard-key! d (Ctrl #\g))
    (for size (iter [0 1 4 20 50])
      (app-snapshot d size size 0 a))))

(deftest failed-background-connection-does-not-take-over-conversation
  (let [a (malloc-allocator)
        d (standalone a "async")
        w (field d workbench)]
    (input-set-text! (index (field w connection) 0) "http://127.0.0.1:1")
    (input-set-text! (index (field w connection) 2) "Offline test factory")
    (connect! d 1)
    (dashboard-key! d (Paste "still typing while connecting"))
    (assert (= (input-text (field (field d personal) input))
               "still typing while connecting"))
    (let [(mut attempts) 0]
      (loop (when (or (network/ready? (.job w)) (> (load attempts) 400))
              (break))
        (sleep-ms 10)
        (set! attempts (+ (load attempts) 1))))
    (assert (network/ready? (.job w)))
    (poll-network! d)
    (assert (= (cast i64 (.job w)) 0))
    (assert (not (.connected w)))
    (assert (match (.view d) (ViewPersonal [] true) (_ false)))
    (assert (= (input-text (field (field d personal) input))
               "still typing while connecting"))))

(deftest applying-a-connection-preserves-personal-session-and-saves-the-profile
  (let [a (malloc-allocator)
        d (standalone a "profile")
        w (field d workbench)
        job
          (network/start a
                         1
                         (.home w)
                         (Hub
                           :base-url "http://127.0.0.1:1"
                           :token "saved-token")
                         "http://127.0.0.1:1"
                         "Test computer")]
    (let [(mut attempts) 0]
      (loop (when (or (network/ready? job) (> (load attempts) 400)) (break))
        (sleep-ms 10)
        (set! attempts (+ (load attempts) 1))))
    (assert (network/ready? job))
    ;; Exercise result application separately from transport and credentials.
    (set! (.reply job)
          (client/ReplyOk
            :status 200
            :body (jv-object a)
            :text "{}"))
    (set! (.job w) job)
    (own! d (field w session-id) "0123456789abcdef01234567")
    (dashboard-key! d (Paste "my draft"))
    (poll-network! d)
    (assert (.connected w))
    (assert (match (.view d) (ViewPersonal [] true) (_ false)))
    (assert (= (.session-id w) "0123456789abcdef01234567"))
    (assert (= (input-text (field (field d personal) input)) "my draft"))
    (assert (= (.connection-name w) "Test computer"))
    (let [(mut reloaded) (zeroed workbench/Workbench)]
      (workbench/init! (mut reloaded) a (.home w))
      (let [profile (jv-nth (.value (.profiles reloaded)) 0)]
        (assert (= (session/str profile "name") "Test computer"))
        (assert (= (session/str profile "token") "saved-token"))))
    (network/close! a (.active-connection w))
    (set! (.active-connection w) (cast (ptr network/Job) 0))))

(deftest slash-commands-reveal-shortcuts-only-while-discovering-an-action
  (let [a (malloc-allocator)
        d (standalone a "slash")]
    (let [screen (app-snapshot d 110 32 0 a)]
      (assert (not (str-contains? screen "ctrl-")))
      (assert (not (str-contains? screen "Ctrl-"))))
    (dashboard-key! d (Char #\/))
    (dashboard-key! d (Paste "settings"))
    (assert (.commands-open d))
    (assert (= (input-text (field (field d personal) input)) ""))
    (let [screen (app-snapshot d 110 32 0 a)]
      (assert (str-contains? screen "/settings"))
      (let [footer " /settings · Ctrl-G\n"]
        (assert (= (subslice screen (- (len screen) (len footer)) (len screen))
                   footer))))
    (for size (iter [0 1 4 20]) (app-snapshot d size size 0 a))
    (dashboard-key! d (Enter))
    (assert (.settings-open (.workbench d)))
    (assert (not (.commands-open d)))
    (dashboard-key! d (Escape))))

(deftest slash-navigation-preserves-drafts-and-leaves-message-slashes-alone
  (let [a (malloc-allocator)
        d (standalone a "slash-draft")]
    (dashboard-key! d (Paste "keep this draft"))
    (dashboard-key! d (Ctrl #\p))
    (dashboard-key! d (Paste "factory"))
    (dashboard-key! d (Enter))
    (assert (match (.view d) (ViewOverview [] true) (_ false)))
    (dashboard-key! d (Paste "/chat"))
    (dashboard-key! d (Enter))
    (assert (match (.view d) (ViewPersonal [] true) (_ false)))
    (assert (= (input-text (field (field d personal) input)) "keep this draft"))
    (dashboard-key! d (Char #\/))
    (assert (not (.commands-open d)))
    (assert (= (input-text (field (field d personal) input)) "keep this draft/"))))

(deftest unknown-slash-command-does-not-send-a-message-and-forms-can-search-commands
  (let [a (malloc-allocator)
        d (standalone a "slash-unknown")]
    (dashboard-key! d (Paste "/not-a-command"))
    (dashboard-key! d (Enter))
    (assert (.commands-open d))
    (assert (= (.session-id (.workbench d)) ""))
    (assert (str-contains? (app-snapshot d 100 28 0 a) "No matching commands"))
    (dashboard-key! d (Escape))
    (dashboard-key! d (Paste "/run"))
    (dashboard-key! d (Enter))
    (assert (.launch-open d))
    (dashboard-key! d (Ctrl #\p))
    (dashboard-key! d (Paste "start"))
    (assert (str-contains? (app-snapshot d 100 28 0 a) "/start · Ctrl-S"))
    (dashboard-key! d (Escape))
    (assert (.launch-open d))
    (dashboard-key! d (Ctrl #\p))
    (dashboard-key! d (Paste "factory"))
    (dashboard-key! d (Enter))
    (assert (not (.launch-open d)))
    (assert (match (.view d) (ViewOverview [] true) (_ false)))))

(deftest stop-confirmation-can-be-dismissed-with-a-slash-command
  (let [a (malloc-allocator)
        d (standalone a "slash-confirm")]
    (set! (.confirm-stop d) true)
    (dashboard-key! d (Paste "/dismiss"))
    (assert (.commands-open d))
    (assert (str-contains? (app-snapshot d 100 28 0 a) "/dismiss · Esc"))
    (dashboard-key! d (Enter))
    (assert (not (.confirm-stop d)))
    (assert (not (.commands-open d)))))

(deftest context-sidebar-updates-live-persists-and-never-leaks-across-conversations
  (let [a (malloc-allocator)
        d (standalone a "context-board")
        w (field d workbench)
        id
          (match (session/create! a
                                  (.home w)
                                  "claude"
                                  "haiku"
                                  (.home w)
                                  "Benchmark session")
            (Ok [id] id)
            (_ (do (assert false) "")))
        root (session/path a (.home w) id "")]
    (ok (context/update! a
                         root
                         "assistant"
                         2
                         (json a
                               "{\"section\":\"results\",\"title\":\"Benchmark\",\"items\":[{\"id\":\"latest\",\"text\":\"42 ms\"}]}")))
    (set! (.now d) 1000)
    (open-personal! d id)
    (dashboard-key! d (Paste "my draft"))
    (let [screen (app-snapshot d 120 30 0 a)]
      (assert (str-contains? screen "Context"))
      (assert (str-contains? screen "Benchmark"))
      (assert (str-contains? screen "42 ms")))
    (ok (context/update! a
                         root
                         "assistant"
                         3
                         (json a
                               "{\"section\":\"results\",\"id\":\"latest\",\"text\":\"31 ms\",\"status\":\"done\"}")))
    (set! (.now d) 1400)
    (poll-personal! d)
    (assert (str-contains? (app-snapshot d 120 30 0 a) "31 ms"))
    (assert (= (input-text (field (field d personal) input)) "my draft"))
    (new-personal! d)
    (assert (not (str-contains? (app-snapshot d 120 30 0 a) "31 ms")))
    (set! (.now d) 1800)
    (open-personal! d id)
    (assert (str-contains? (app-snapshot d 120 30 0 a) "31 ms"))
    (dashboard-key! d (Paste "/history"))
    (dashboard-key! d (Enter))
    (assert (str-contains? (app-snapshot d 80 24 0 a) "Benchmark session"))
    (dashboard-key! d (Escape))
    (dashboard-key! d (Ctrl #\y))
    (assert (.sidebar-focus w))
    (for size (iter [0 1 4 20 40]) (app-snapshot d size size 0 a))
    (assert (str-contains? (app-snapshot d 40 20 0 a) "31 ms"))
    (dashboard-key! d (Escape))
    (assert (not (.sidebar-focus w)))
    (dashboard-key! d (Paste "/sidebars --hide right"))
    (dashboard-key! d (Enter))
    (assert (not (.sidebar-visible w)))))

(deftest remote-sidebar-results-ignore-old-agents-and-preserve-last-board-on-failure
  (let [a (malloc-allocator)
        d (standalone a "context-remote")
        w (field d workbench)
        job (box! a network/Job (zeroed network/Job))
        doc
          (json a
                "{\"version\":1,\"revision\":2,\"sections\":[{\"id\":\"bench\",\"title\":\"Latest\",\"items\":[{\"id\":\"result\",\"text\":\"31 ms\"}]}]}")]
    (chat-open! (field d chat) "run-123" "assistant")
    (set! (.view d) (ViewChat))
    (set! (.name job) "run-123/assistant")
    (set! (.hub job) (.hub d))
    (set! (.reply job)
          (client/ReplyOk
            :status 200
            :body doc
            :text ""))
    (apply-sidebar! d job)
    (assert-eq (jv-int (jv-get (.value (.sidebar w)) "revision")) 2)
    (set! (.name job) "other-run/assistant")
    (set! (.reply job)
          (client/ReplyOk
            :status 200
            :body (jv-object a)
            :text ""))
    (apply-sidebar! d job)
    (assert-eq (jv-int (jv-get (.value (.sidebar w)) "revision")) 2)
    (set! (.name job) "run-123/assistant")
    (set! (.reply job) (client/ReplyFailed "offline"))
    (apply-sidebar! d job)
    (assert-eq (jv-int (jv-get (.value (.sidebar w)) "revision")) 2)
    (assert (str-contains? (app-snapshot d 110 30 0 a) "31 ms"))
    (assert (> (len (context/text (.value (.sidebar w)) "error")) 0))))

(defn finish-model-discovery! [(d (ptr Dash))] (-> i64)
  (let [w (field d workbench)
        (mut attempts) 0]
    (loop (when (or (catalog/ready? (.model-job w)) (> (load attempts) 400))
            (break))
      (sleep-ms 10)
      (set! attempts (+ (load attempts) 1)))
    (assert (catalog/ready? (.model-job w)))
    (poll-models! d)
    (assert (= (cast i64 (.model-job w)) 0))
    0))

(deftest native-model-discovery-refreshes-asynchronously-and-preserves-the-highlighted-model
  (let [a (malloc-allocator)
        d (standalone a "model-discovery")
        w (field d workbench)
        program (session/cat a [(.home w) "/claude-fixture"])
        config (jv-object a)]
    (match (disk/write-file-atomic! a
                                    program
                                    "#!/bin/sh\ncat >/dev/null\nsleep 0.1\nprintf '%s\\n' '{\"type\":\"control_response\",\"response\":{\"subtype\":\"success\",\"request_id\":\"factory-models\",\"response\":{\"models\":[{\"value\":\"opus\",\"resolvedModel\":\"claude-opus-5-5\",\"displayName\":\"Opus 5.5\"},{\"value\":\"fable\",\"resolvedModel\":\"claude-fable-5-1\",\"displayName\":\"Fable 5.1\"}]}}}'\n"
                                    493)
      (Ok [_] 0)
      (_ (assert false)))
    (jv-put! config "claude" (JStr program))
    (assert (session/write-doc! a
                                (session/cat a [(.home w) "/site.json"])
                                config))
    (input-set-text! (index (field w settings) 1) "codex")
    (input-set-text! (index (field w settings) 2) "fixture-codex")
    (open-models! d)
    (assert (.models-open w))
    (assert (!= (cast i64 (.model-job w)) 0))
    (finish-model-discovery! d)
    (let [selected
            (jv-nth (.value (.model-options w)) (.selected (.list (.models w))))]
      (assert (= (session/str selected "model") "fixture-codex")))
    (assert (= (session/str (jv-nth (.value (.model-options w)) 0) "label")
               "Opus 5.5"))
    (dashboard-key! d (Paste "Fable"))
    (dashboard-key! d (Enter))
    (assert (= (workbench/value w 1) "claude"))
    (assert (= (workbench/value w 2) "claude-fable-5-1"))
    (let [cached
            (session/read-doc a
                              (session/cat a [(.home w) "/claude-models.json"]))]
      (assert-eq (jv-count (jv-get cached "models")) 2))
    ;; A later discovery error leaves the last successful versioned list usable.
    (jv-put! config "claude" (JStr "/usr/bin/false"))
    (assert (session/write-doc! a
                                (session/cat a [(.home w) "/site.json"])
                                config))
    (open-models! d)
    (finish-model-discovery! d)
    (assert (> (len (.model-error w)) 0))
    (dashboard-key! d (Paste "Fable"))
    (assert (str-contains? (app-snapshot d 110 32 0 a) "Fable 5.1"))
    (dashboard-key! d (Escape))))

(deftest wheel-scrolls-the-conversation-without-changing-the-input-or-input-history
  (let [a (malloc-allocator)
        d (standalone a "wheel")
        chat (field d personal)
        input (field chat input)]
    (input-history-push! input "old input")
    (dashboard-key! d (Paste "keep this draft"))
    (set! (.cursor input) 4)
    (set! (.total (.sv chat)) 100)
    (set! (.height (.sv chat)) 10)
    (set! (.offset (.sv chat)) 90)
    (dashboard-key! d (Scroll -1 40 10))
    (assert-eq (.offset (.sv chat)) 87)
    (assert (not (.stick-bottom (.sv chat))))
    (assert (= (input-text input) "keep this draft"))
    (assert-eq (.cursor input) 4)
    (assert-eq (.history-pos input) -1)
    (dashboard-key! d (Scroll 1 40 10))
    (assert-eq (.offset (.sv chat)) 90)
    (assert (.stick-bottom (.sv chat)))
    (assert (= (input-text input) "keep this draft"))
    (set! (.view d) (ViewChat))
    (set! (.total (.sv (.chat d))) 100)
    (set! (.height (.sv (.chat d))) 10)
    (set! (.offset (.sv (.chat d))) 90)
    (dashboard-key! d (Scroll -1 40 10))
    (assert-eq (.offset (.sv (.chat d))) 87)))

(deftest escape-dismisses-overlays-before-interrupting-the-active-personal-turn
  (let [a (malloc-allocator)
        d (standalone a "escape-interrupt")
        w (field d workbench)
        id
          (match (session/create! a
                                  (.home w)
                                  "claude"
                                  "haiku"
                                  (.home w)
                                  "Interrupt")
            (Ok [id] id)
            (_ (do (assert false) "")))
        cancel (session/path a (.home w) id "cancel")]
    (own! d (field w session-id) id)
    (set! (.status w) "running")
    (dashboard-key! d (Paste "keep my draft"))
    (dashboard-key! d (Ctrl #\p))
    (dashboard-key! d (Escape))
    (assert (match (disk/file-exists? a cancel)
              (Ok [exists] (not exists))
              (_ false)))
    (dashboard-key! d (Escape))
    (assert (match (disk/file-exists? a cancel) (Ok [exists] exists) (_ false)))
    (assert (= (input-text (field (field d personal) input)) "keep my draft"))
    (assert (match (.view d) (ViewPersonal [] true) (_ false)))))

(deftest resume-command-and-sidebar-clicks-open-saved-conversations
  (let [a (malloc-allocator)
        d (standalone a "resume-click")
        w (field d workbench)]
    (for i (range 0 18)
      (match (session/create! a
                              (.home w)
                              "claude"
                              "haiku"
                              (.home w)
                              "Saved conversation")
        (Ok [id] 0)
        (_ (assert false))))
    (set! (.now d) 1000)
    (poll-personal! d)
    (app-snapshot d 120 25 0 a)
    (dashboard-key! d (Paste "/resume"))
    (dashboard-key! d (Enter))
    (assert (.history-focus w))
    (app-snapshot d 90 25 0 a)
    (let [r (.history-r w)
          expected (js (jv-nth (.value (field w sessions)) 1) "id")]
      (dashboard-key! d (Click (.x r) (+ (.y r) 1)))
      (assert (= (.session-id w) expected))
      (assert (not (.history-focus w))))
    (app-snapshot d 120 25 0 a)
    (let [r (.history-r w)]
      (dashboard-key! d (Scroll 1 (.x r) (.y r)))
      (dashboard-key! d (Scroll 1 (.x r) (.y r)))
      (dashboard-key! d (Scroll 1 (.x r) (.y r)))
      (dashboard-key! d (Scroll 1 (.x r) (.y r)))
      (app-snapshot d 120 25 0 a)
      (assert (> (.offset (.history w)) 0))
      (let [expected
              (js (jv-nth (.value (field w sessions)) (.offset (.history w)))
                  "id")]
        (dashboard-key! d (Click (.x r) (.y r)))
        (assert (= (.session-id w) expected))))
    (app-snapshot d 120 25 0 a)
    (set! (.settings-open w) true)
    (let [saved (.session-id w)
          r (.workspace-r w)]
      (dashboard-key! d (Click (.x r) (.y r)))
      (assert (= (.session-id w) saved)))
    (set! (.settings-open w) false)
    (let [r (.workspace-r w)]
      (dashboard-key! d (Click (.x r) (.y r)))
      (assert (= (.session-id w) "")))
    (dashboard-key! d (Paste "/history"))
    (dashboard-key! d (Enter))
    (assert (.history-focus w))))

(deftest mouse-drags-resize-sidebars-clamp-the-conversation-and-persist-widths
  (let [a (malloc-allocator)
        d (standalone a "resize-sidebar")
        w (field d workbench)]
    (app-snapshot d 140 30 0 a)
    (dashboard-key! d (Click 22 8))
    (assert-eq (.dragging w) 1)
    (dashboard-key! d (Drag 35 8))
    (app-snapshot d 140 30 0 a)
    (assert-eq (.workspace-width w) 35)
    (dashboard-key! d (Release 35 8))
    (assert-eq (.dragging w) 0)
    (let [r (.context-r w)]
      (dashboard-key! d (Click (.x r) 8))
      (assert-eq (.dragging w) 2)
      (dashboard-key! d (Drag 90 8))
      (dashboard-key! d (Release 90 8))
      (assert-eq (.context-width w) 50))
    (app-snapshot d 140 30 0 a)
    (dashboard-key! d (Click (.x (.context-r w)) 8))
    (dashboard-key! d (Release 0 8))
    (assert-eq (.context-width w) 65)
    (let [(mut restored) (zeroed workbench/Workbench)]
      (workbench/init! (mut restored) a (.home w))
      (assert-eq (.workspace-width restored) 35)
      (assert-eq (.context-width restored) 65))
    (set! (.settings-open w) true)
    (app-snapshot d 140 30 0 a)
    (dashboard-key! d (Click 34 8))
    (assert-eq (.dragging w) 0)
    (set! (.settings-open w) false)
    (for width (iter [20 69 80 119 120 140]) (app-snapshot d width 25 0 a))))

(deftest sidebar-flags-complete-without-mutation-and-apply-atomically
  (let [a (malloc-allocator)
        d (standalone a "sidebar-flags")
        w (field d workbench)]
    (dashboard-key! d (Paste "keep this draft"))
    (dashboard-key! d (Ctrl #\p))
    (dashboard-key! d (Paste "sidebars"))
    (dashboard-key! d (Enter))
    (assert (.commands-open d))
    (assert (.workspace-visible w))
    (assert (.sidebar-visible w))
    (dashboard-key! d (Paste "--hi"))
    (dashboard-key! d (Tab))
    (assert (= (input-text (field (field d commands) input)) "sidebars --hide "))
    (dashboard-key! d (Paste "le"))
    (dashboard-key! d (Tab))
    (assert (.workspace-visible w))
    (dashboard-key! d (Enter))
    (assert (not (.commands-open d)))
    (assert (not (.workspace-visible w)))
    (assert (.sidebar-visible w))
    (assert (= (input-text (field (field d personal) input)) "keep this draft"))
    (open-slash! d "sidebars --show left --hide all")
    (dashboard-key! d (Enter))
    (assert (.commands-open d))
    (assert (not (.workspace-visible w)))
    (assert (.sidebar-visible w))
    (open-slash! d "sidebars --toggle all")
    (dashboard-key! d (Enter))
    (assert (.workspace-visible w))
    (assert (not (.sidebar-visible w)))
    (open-slash! d "sidebars --help")
    (dashboard-key! d (Enter))
    (assert (.commands-open d))
    (assert (str-contains? (app-snapshot d 120 30 0 a) "Targets cannot overlap"))
    (dashboard-key! d (Home))
    (dashboard-key! d (Tab))
    (for size (iter [0 1 20 40 120]) (app-snapshot d size size 0 a))
    (dashboard-key! d (Escape))
    (let [(mut saved) (zeroed workbench/Workbench)]
      (workbench/init! (mut saved) a (.home w))
      (assert (.workspace-visible saved))
      (assert (not (.sidebar-visible saved))))))

(deftest unused-sidebar-typing-restores-conversation-and-preserves-the-event
  (let [a (malloc-allocator)
        d (standalone a "typing-focus")
        w (field d workbench)
        input (field (field d personal) input)]
    (dashboard-key! d (Paste "draft "))
    (set! (.sidebar-focus w) true)
    (dashboard-key! d (Down))
    (assert (.sidebar-focus w))
    (dashboard-key! d (Char #\h))
    (assert (not (.sidebar-focus w)))
    (assert (= (input-text input) "draft h"))
    (set! (.history-focus w) true)
    (dashboard-key! d (Up))
    (assert (.history-focus w))
    (dashboard-key! d (Paste "ello"))
    (assert (not (.history-focus w)))
    (assert (= (input-text input) "draft hello"))
    (set! (.sidebar-focus w) true)
    (set! (.settings-open w) true)
    (dashboard-key! d (Char #\x))
    (assert (.sidebar-focus w))
    (assert (= (input-text input) "draft hello"))
    (set! (.settings-open w) false)
    (set! (.view d) (ViewChat))
    (dashboard-key! d (Paste "agent draft"))
    (assert (not (.sidebar-focus w)))
    (assert (= (input-text (field (field d chat) input)) "agent draft"))))

(deftest conversation-click-clears-both-sidebar-focuses-in-personal-and-agent-chat
  (let [a (malloc-allocator)
        d (standalone a "click-focus")
        w (field d workbench)]
    (for agent-chat (range 0 2)
      (when (= agent-chat 1) (set! (.view d) (ViewChat)))
      (app-snapshot d 140 30 0 a)
      (set! (.sidebar-focus w) true)
      (set! (.history-focus w) true)
      (dashboard-key! d (Click 60 15))
      (assert (not (.sidebar-focus w)))
      (assert (not (.history-focus w))))))

(deftest fast-model-picker-preserves-model-id-and-persists-speed-on-existing-conversation
  (let [a (malloc-allocator)
        d (standalone a "fast-picker")
        w (field d workbench)
        pa (snap-spare (field w model-options))
        options (jv-array pa)]
    (catalog/add! pa options "codex" "gpt-6-sol" "Sol")
    (catalog/add-tier! pa options "codex" "gpt-6-sol" "Sol (Fast)" "priority")
    (snap-commit! (field w model-options) options 0)
    (set! (.models-open w) true)
    (dashboard-key! d (Paste "Fast"))
    (assert (str-contains? (app-snapshot d 110 32 0 a) "Sol (Fast)"))
    (dashboard-key! d (Enter))
    (assert (= (workbench/value w 2) "gpt-6-sol"))
    (assert (= (.service-tier w) "priority"))
    (let [id
            (match (session/create-tier! a
                                         (.home w)
                                         "codex"
                                         "gpt-6-sol"
                                         (.home w)
                                         "Fast picker"
                                         (.service-tier w))
              (Ok [id] id)
              (_ (do (assert false) "")))]
      (set! (.session-id w) id)
      (set! (.models-open w) true)
      (palette-reset! (field w models))
      (dashboard-key! d (Enter))
      (assert (= (session/str (session/info a (.home w) id) "service_tier") ""))
      (assert (= (.service-tier w) ""))
      (set! (.models-open w) true)
      (dashboard-key! d (Paste "Fast"))
      (dashboard-key! d (Enter))
      (assert (= (session/str (session/info a (.home w) id) "service_tier")
                 "priority")))))
