(defn dash-for-test [(a (dyn Allocator))] (-> (ptr Dash))
  (let [d (box! a Dash (zeroed Dash))]
    (setenv c"TZ" c"UTC" 1)
    (tzset)
    (dash-init! d a (Hub :base-url "http://127.0.0.1:1" :token ""))
    (set! (.now d) NOW)
    d))

