(deftest keys-drive-selection-overlays-and-actions-without-a-hub
         (let [a (malloc-allocator)
               d (dash-for-test a)]
           (assert (snap-load-text! (field d overview) (q a OVERVIEW) NOW))
           (sync-selection! d)
           (dashboard-key! d (Char #\?))
           (assert (.help d))
           (assert (str-contains? (app-snapshot d 100 24 0 a)
                                  "show tool output and full reasoning"))
           (dashboard-key! d (Escape))
           (assert (not (.help d)))
           (dashboard-key! d (Char #\x))
           (assert (.confirm-stop d))
           (assert (str-contains? (app-snapshot d 100 24 0 a)
                                  "Stop haiku-4695? Its agents are cancelled."))
           (dashboard-key! d (Char #\n))
           (assert (not (.confirm-stop d)))
           (dashboard-key! d (Down))
           (assert (= (.selected-id d) "blocker-73c0"))
           (dashboard-key! d (Char #\p))
           (assert (str-contains? (.toast d) "is blocked"))
           ;; Nothing listens on port 1: opening the run reports the hub as down.
           (dashboard-key! d (Enter))
           (assert (match (.view d) (ViewRun [] true) (_ false)))
           (assert (hub-down? d))
           (assert (str-contains? (app-snapshot d 100 24 0 a) "HUB DOWN"))
           (dashboard-key! d (Escape))
           (assert (match (.view d) (ViewOverview [] true) (_ false)))
           (assert (match (dashboard-key! d (Char #\q))
                     (Quit [] true)
                     (_ false))))
         0)

(deftest chat-refetches-at-checkpoints
         (let [a (malloc-allocator)
               d (dash-for-test a)
               chat (field d chat)]
           (chat-open! chat "haiku-4695" "critique")
           (chat-start-from-tail! chat (doc a CHAT-TAIL))
           (assert-eq (len (.overlay chat)) 2)
           (assert-eq (.cursor chat) 9500)
           (set! (.needs-transcript chat) false)
           (chat-ingest-page! chat
                              (doc a
                                   "{'cursor': 9900, 'records': [
      {'t': 1, 'kind': 'agent.text', 'agent': 'critique', 'text': 'done counting'},
      {'t': 2, 'kind': 'agent.turn', 'agent': 'critique', 'turn': 7},
      {'t': 3, 'kind': 'agent.thought', 'agent': 'critique', 'text': 'next'}]}"))
           (assert-eq (len (.overlay chat)) 1)
           (assert (.needs-transcript chat))
           (assert-eq (.cursor chat) 9900))
         0)

(defn str-contains? [(hay (slice u8)) (needle (slice u8))] (-> bool)
  (match (str-find hay needle) (Some [i] true) (None [] false)))

(defn agent-doc-at [(a (dyn Allocator)) (cursor i64)] (-> JVal)
  (let [v (doc a AGENT)]
    (jv-put! v "transcript_cursor" (JInt cursor))
    v))

(deftest chat-merges-exactly-at-the-transcript-cursor
         (let [a (malloc-allocator)
               d (dash-for-test a)
               chat (field d chat)]
           (chat-open! chat "haiku-4695" "critique")
           ;; A transcript with its cursor: the overlay is read from exactly there.
           (assert (chat-adopt-transcript! chat (agent-doc-at a 9000) NOW))
           (assert (.exact chat))
           (assert (.loaded chat))
           (assert-eq (.cursor chat) 9000)
           (chat-ingest-page! chat
                              (doc a
                                   "{'cursor': 9900, 'records': [
      {'t': 1, 'kind': 'agent.text', 'agent': 'critique', 'text': 'done counting'},
      {'t': 2, 'kind': 'agent.turn', 'agent': 'critique', 'turn': 7},
      {'t': 3, 'kind': 'agent.thought', 'agent': 'critique', 'text': 'next'}]}"))
           ;; A checkpoint record keeps the overlay and asks for a newer transcript.
           (assert-eq (len (.overlay chat)) 2)
           (assert (.needs-transcript chat))
           (assert-eq (.cursor chat) 9900)
           ;; No newer checkpoint yet: nothing changes.
           (assert (not (chat-adopt-transcript! chat (agent-doc-at a 9000) NOW)))
           (assert (not (.needs-transcript chat)))
           (assert-eq (len (.overlay chat)) 2)
           ;; A newer one replaces the overlay; events are reread from its cursor.
           (assert (chat-adopt-transcript! chat (agent-doc-at a 9800) NOW))
           (assert-eq (len (.overlay chat)) 0)
           (assert-eq (.cursor chat) 9800)
           (assert-eq (.transcript-cursor chat) 9800))
         0)

(deftest chat-falls-back-to-checkpoint-records-without-a-cursor
         (let [a (malloc-allocator)
               d (dash-for-test a)
               chat (field d chat)]
           (chat-open! chat "haiku-4695" "critique")
           (assert (not (chat-adopt-transcript! chat (doc a AGENT) NOW)))
           (assert (not (.exact chat)))
           (assert (not (.loaded chat)))
           (assert (.has (field chat transcript))))
         0)
