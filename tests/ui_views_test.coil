(extern tzset :cc c [] (-> void))

;; Fixtures are written with ' for " to stay readable.
(defn q [(a (dyn Allocator)) (text (slice u8))] (-> (slice u8))
  (let [(mut out) (sb-new a)
        (mut i) 0]
    (loop (if (>= (load i) (len text))
              (break)
              (let [b (get text (load i))]
                (sb-push-byte! (mut out)
                               (if (= (cast i64 b) #\') (cast u8 #\") b))
                (set! i (+ (load i) 1)))))
    (sb-finish! (mut out))))

(defn doc [(a (dyn Allocator)) (text (slice u8))] (-> JVal)
  (match (jv-parse a (q a text))
    (Some [v] v)
    (None [] (do (assert false) (JNull)))))

