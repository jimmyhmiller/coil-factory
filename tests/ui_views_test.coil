(defn load-run! [(d (ptr Dash)) (a (dyn Allocator))] (-> i64)
  (let [ov (doc a OVERVIEW)
        run (jv-nth (jv-get ov "runs") 0)]
    (own! d (field d run-id) "haiku-4695")
    (assert (snap-load-text! (field d run) (jv-encode a run) NOW))
    (run-loaded! d true)
    (feed-ingest-page! (field d feed) (doc a EVENTS))
    0))

