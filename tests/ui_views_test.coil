(deftest chat-view-merges-transcript-journal-and-pending
         (let [a (malloc-allocator)
               d (dash-for-test a)
               chat (field d chat)]
           (own! d (field d run-id) "haiku-4695")
           (assert (snap-load-text! (field d run) (q a PENDING-RUN) NOW))
           (chat-open! chat "haiku-4695" "critique")
           (chat-start-from-tail! chat (doc a CHAT-TAIL))
           (assert (snap-load-text! (field chat transcript) (q a AGENT) NOW))
           (set! (.needs-transcript chat) false)
           (chat-bump! chat)
           (chat-sync-pending! chat (.value (field d run)))
           (chat-add-local! chat 9700 "and the rhythm" NOW)
           (set! (.view d) (ViewChat))
           (let [screen (app-snapshot d 90 34 0 a)]
